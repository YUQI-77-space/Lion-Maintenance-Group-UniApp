<view class="tabbar-wrapper mg-theme" style="padding-bottom: {{safeBottom}}px;">
  <view class="tabs-container">
    <button class="tab-item {{selected === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="pagePath" data-index="{{index}}" data-url="/{{item.pagePath}}" bindtap="onTap" disabled="{{interactionLocked}}" hover-class="tab-pressed" aria-label="{{item.text}}{{selected === index ? '，当前页面' : ''}}">
      <image class="tab-icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" mode="aspectFit" />
      <text class="tab-text">{{item.text}}</text>
    </button>
  </view>
  <view wx:if="{{interactionLocked}}" class="tabbar-mask" catchtap="noop" catchtouchmove="noop" />
</view>
