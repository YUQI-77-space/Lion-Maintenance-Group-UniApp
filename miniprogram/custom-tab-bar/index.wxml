<view class="tabbar-wrapper mg-theme" style="bottom: {{safeBottom + 16}}px;">
  <view class="tabs-container">
    <button class="tab-item {{selected === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="pagePath" data-url="/{{item.pagePath}}" bindtap="onTap" disabled="{{interactionLocked}}" hover-class="none" aria-label="{{item.text}}{{selected === index ? '，当前页面' : ''}}">
      <view class="tab-icon">
        <image class="tab-icon-image tab-icon-default" src="{{item.iconPath}}" mode="aspectFit" />
        <image class="tab-icon-image tab-icon-selected" src="{{item.selectedIconPath}}" mode="aspectFit" />
      </view>
      <text class="tab-text">{{item.text}}</text>
    </button>
  </view>
  <view wx:if="{{interactionLocked}}" class="tabbar-mask" catchtap="noop" catchtouchmove="noop" />
</view>
