@import "../styles/design-tokens.wxss";
.tabbar-wrapper { position: fixed; bottom: 0; left: 0; right: 0; z-index: 300; background: var(--mg-color-bg-surface); border-top: 1px solid var(--mg-color-border); }
.tabs-container { display: flex; min-height: 56px; align-items: stretch; }
.tab-item { flex: 1; min-width: 48px; min-height: 56px; margin: 0; padding: 4px; display: flex; flex-direction: column; justify-content: center; align-items: center; background: transparent; border: 0; border-radius: 0; color: var(--mg-color-text-muted); line-height: 1.4; }
.tab-item::after { border: 0; }
.tab-icon { width: 24px; height: 24px; }
.tab-text { margin-top: 2px; font-size: 12px; }
.active { color: var(--mg-color-brand); font-weight: 600; }
.tab-pressed { background: var(--mg-color-brand-soft); }
.tabbar-mask { position: absolute; inset: 0; }
