<!--pages/startup/index.wxml-->
<view class="startup-container {{fadeOut ? 'fade-out' : ''}}">
  <image 
    class="startup-background" 
    src="{{backgroundImage}}" 
    mode="aspectFill"
    lazy-load="{{false}}"
    show-menu-by-longpress="{{false}}"
    binderror="onImageError"
    bindload="onImageLoad">
  </image>
<view class="startup-status">正在恢复身份…</view><button wx:if="{{startupError}}" class="startup-retry" bindtap="retryStartup">{{startupError}}</button></view>

