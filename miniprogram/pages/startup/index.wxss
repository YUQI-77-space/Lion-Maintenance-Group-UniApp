/* pages/startup/index.wxss */
page {
  width: 100%;
  height: 100%;
  background-color: var(--mg-color-bg-page) !important;
}

.startup-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: var(--mg-color-bg-page);
  opacity: 1;
  transition: opacity 0.5s ease-out;
}

.startup-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  background-color: var(--mg-color-bg-page);
  will-change: auto;
}

/* 旧的logo与标题元素已移除，减少绘制与布局 */

/* 淡出动画 */
.startup-container.fade-out {
  opacity: 0;
}


.startup-retry { position: absolute; left: 32rpx; right: 32rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); padding: 24rpx; color: var(--mg-color-text-primary); background: var(--mg-color-bg-surface); text-align: center; }
.startup-retry { min-height: 48px; }
