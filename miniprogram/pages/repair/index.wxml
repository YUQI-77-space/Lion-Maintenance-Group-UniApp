<!-- miniprogram/pages/repair/index.wxml -->
<!-- 自定义导航栏 -->
<view class="custom-navbar" style="padding-top: {{statusBarHeight}}px;">
  <view class="navbar-content">
    <image class="navbar-logo" src="{{iconLogo}}" mode="aspectFit"></image>
    <text class="navbar-title">物科院维修组</text>
  </view>
</view>

<!-- 步骤条：固定在导航栏下方，始终可见 -->
<view class="step-bar" wx:if="{{currentStep < 5}}" style="top: {{navBarHeight}}px; height: {{stepBarHeight}}px;">
  <view class="step-track">
    <view class="step-track-line"></view>
    <view class="step-track-fill" style="width: {{progressStage * 33.33}}%;"></view>
    <view
      class="step-node {{progressStage > index ? 'done' : ''}} {{progressStage === index ? 'current' : ''}}"
      wx:for="{{progressLabels}}"
      wx:key="*this"
    >
      <view class="node-dot">{{index + 1}}</view>
      <text class="node-text">{{item}}</text>
    </view>
  </view>
</view>

<view
  class="repair-container"
  bindtouchstart="onTouchStart"
  bindtouchend="onTouchEnd"
  style="padding-top: {{currentStep < 5 ? contentTop : contentTopNoBar}}px;"
>
  <!-- ==================== 步骤 0：选择大类 ==================== -->
  <view wx:if="{{currentStep === 0}}">
    <!-- 搜索栏 -->
    <view class="search-wrapper">
      <view class="search-bar">
        <image class="search-icon" src="{{iconSearch}}" mode="aspectFit"></image>
        <input
          class="search-input"
          placeholder="搜索问题，如：清灰、电风扇、手机屏幕"
          confirm-type="search"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          bindfocus="onSearchFocus"
          bindblur="onSearchBlur"
        />
        <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="onSearchClear">清空</view>
      </view>

      <!-- 快捷关键词 -->
      <view wx:if="{{showQuickKeywords && !searchKeyword}}" class="search-panel">
        <view class="panel-title">常用问题</view>
        <view class="chip-row">
          <view
            class="chip"
            wx:for="{{quickKeywords}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="onQuickKeywordTap"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 搜索结果 -->
      <view wx:if="{{showSearchResult && searchResults.length}}" class="search-panel">
        <scroll-view scroll-y="true" class="result-scroll">
          <view
            wx:for="{{searchResults}}"
            wx:key="id"
            class="result-item"
            data-cat-id="{{item.categoryId}}"
            data-sub-id="{{item.subcategoryId}}"
            data-type-id="{{item.typeId}}"
            bindtap="onSearchResultTap"
          >
            <view class="result-main">{{item.fullPath}}</view>
            <view class="result-sub">{{item.hint}}</view>
          </view>
        </scroll-view>
      </view>

      <!-- 无搜索结果 -->
      <view wx:if="{{searchEmpty}}" class="search-panel">
        <view class="panel-empty">没有找到相关问题，换个说法试试，或直接从下方选择大类</view>
      </view>
    </view>

    <view class="step-card">
      <view class="step-title">选择问题大类</view>
      <view class="step-subtitle">请选择您遇到的问题属于哪个范畴</view>

      <view class="category-list">
        <view
          class="category-row"
          wx:for="{{categories}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onCategorySelect"
        >
          <text class="category-name">{{item.name}}</text>
          <view class="row-arrow"></view>
        </view>
      </view>

      <view class="map-entry" bindtap="goToCategoryMap">
        <text>不确定属于哪一类？查看分类地图</text>
        <image class="map-entry-icon" src="{{iconArrowRight}}" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <!-- ==================== 步骤 1：选择子分类 ==================== -->
  <view wx:if="{{currentStep === 1}}">
    <view class="step-card">
      <view class="step-title">{{selectedCategory.name}}</view>
      <view class="step-subtitle">请选择具体的子分类</view>
      <view class="selection-grid">
        <view
          wx:for="{{subcategories}}"
          wx:key="id"
          class="selection-item"
          data-id="{{item.id}}"
          bindtap="onSubcategorySelect"
        >{{item.name}}</view>
      </view>
      <view class="button-group single-button">
        <button class="btn btn-outline" bindtap="prevStep">返回上一步</button>
      </view>
    </view>
  </view>

  <!-- ==================== 步骤 2：选择问题类型 ==================== -->
  <view wx:if="{{currentStep === 2}}">
    <view class="step-card">
      <view class="step-title">{{selectedSubcategory.name}}</view>
      <view class="step-subtitle">请选择具体的问题类型</view>
      <view class="selection-grid">
        <view
          wx:for="{{types}}"
          wx:key="id"
          class="selection-item {{item.id === selectedTypeId ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTypeSelect"
        >{{item.name}}</view>
      </view>
      <view class="button-group">
        <button class="btn btn-outline" bindtap="prevStep">返回</button>
        <button
          class="btn btn-primary {{selectedType ? '' : 'btn-disabled'}}"
          bindtap="nextStep"
          disabled="{{!selectedType}}"
        >下一步</button>
      </view>
    </view>
  </view>

  <!-- ==================== 步骤 3：填写报修详情 ==================== -->
  <view wx:if="{{currentStep === 3}}">
    <view class="step-card">
      <view class="step-title">填写报修详情</view>
      <view class="step-subtitle">补充信息能帮维修同学更快定位问题</view>

      <!-- 特殊输入字段 -->
      <view
        wx:for="{{requiredFields}}"
        wx:key="key"
        wx:for-item="field"
        class="special-field {{errorField === field.key ? 'has-error' : ''}}"
      >
        <view class="field-label">
          {{field.label}}
          <text wx:if="{{field.required}}" class="required">*</text>
          <text wx:else class="optional">选填</text>
        </view>
        <!-- 文本输入框 -->
        <input
          wx:if="{{!field.type || field.type === 'text'}}"
          class="field-input"
          placeholder="{{field.placeholder}}"
          value="{{field.value}}"
          data-field="{{field.key}}"
          bindinput="onFieldInput"
        />
        <!-- 下拉选择框 -->
        <picker
          wx:if="{{field.type === 'select'}}"
          mode="selector"
          range="{{field.options}}"
          value="{{field.options.indexOf(systemVersion)}}"
          bindchange="onSystemVersionChange"
        >
          <view class="picker-item">
            <view class="picker-value {{systemVersion ? '' : 'placeholder'}}">{{systemVersion || '请选择'}}</view>
            <view class="row-arrow"></view>
          </view>
        </picker>
        <view class="field-error" wx:if="{{errorField === field.key}}">请填写{{field.label}}</view>
      </view>

      <view class="form-divider" wx:if="{{requiredFields.length}}"></view>

      <!-- 预约时间 -->
      <view class="appointment-container">
        <picker mode="date" value="{{appointmentDate}}" start="{{startDate}}" end="{{endDate}}" bindchange="onDateChange">
          <view class="picker-item">
            <view class="picker-label">预约日期</view>
            <view class="picker-right">
              <view class="picker-value">{{appointmentDate}}</view>
              <view class="row-arrow"></view>
            </view>
          </view>
        </picker>
        <picker mode="time" value="{{appointmentTime}}" start="08:00" end="22:00" bindchange="onTimeChange">
          <view class="picker-item">
            <view class="picker-label">预约时间</view>
            <view class="picker-right">
              <view class="picker-value">{{appointmentTime}}</view>
              <view class="row-arrow"></view>
            </view>
          </view>
        </picker>
      </view>
      <view class="field-hint">可预约时段为 08:00–22:00，请至少提前 1 小时</view>

      <!-- 问题描述 -->
      <view class="field-label description-label">
        问题详细描述
        <text class="optional">选填</text>
      </view>
      <textarea
        class="description-textarea"
        placeholder="可以补充故障现象、出现时间等（选填）"
        maxlength="200"
        bindinput="onDescriptionInput"
        value="{{otherDescription}}"
      ></textarea>
      <view class="field-hint field-hint-right">{{otherDescription.length}}/200</view>

      <view class="button-group">
        <button class="btn btn-outline" bindtap="prevStep">返回</button>
        <button class="btn btn-primary" bindtap="nextStep">下一步</button>
      </view>
    </view>
  </view>

  <!-- ==================== 步骤 4：确认报修信息 ==================== -->
  <view wx:if="{{currentStep === 4}}">
    <view class="step-card">
      <view class="step-title">确认报修信息</view>
      <view class="step-subtitle">提交后维修同学会尽快与您联系</view>

      <view class="confirm-list">
        <view class="confirm-item">
          <view class="confirm-main">
            <text class="confirm-label">问题类别</text>
            <text class="confirm-value">{{selectedCategory.name}} › {{selectedSubcategory.name}} › {{selectedType.name}}</text>
          </view>
          <view class="confirm-edit" bindtap="onEditStep" data-step="0">修改</view>
        </view>

        <view class="confirm-item">
          <view class="confirm-main">
            <text class="confirm-label">预约时间</text>
            <text class="confirm-value">{{appointmentDate}} {{appointmentTime}}</text>
          </view>
          <view class="confirm-edit" bindtap="onEditStep" data-step="3">修改</view>
        </view>

        <view class="confirm-item" wx:if="{{detailLines.length}}">
          <view class="confirm-main">
            <text class="confirm-label">设备信息</text>
            <view class="confirm-lines">
              <text class="confirm-line" wx:for="{{detailLines}}" wx:key="label">{{item.label}}：{{item.value}}</text>
            </view>
          </view>
          <view class="confirm-edit" bindtap="onEditStep" data-step="3">修改</view>
        </view>

        <view class="confirm-item">
          <view class="confirm-main">
            <text class="confirm-label">问题描述</text>
            <text class="confirm-value">{{otherDescription || '无'}}</text>
          </view>
          <view class="confirm-edit" bindtap="onEditStep" data-step="3">修改</view>
        </view>
      </view>

      <view class="button-group">
        <button class="btn btn-outline" bindtap="prevStep">返回修改</button>
        <button class="btn btn-primary" bindtap="submitRepair">确认提交</button>
      </view>
    </view>
  </view>

  <!-- ==================== 步骤 5：提交成功 ==================== -->
  <view wx:if="{{currentStep === 5}}">
    <view class="step-card success-card">
      <view class="success-badge">
        <image class="success-icon" src="{{iconCheck}}" mode="aspectFit"></image>
      </view>
      <view class="step-title success-title">提交成功</view>
      <view class="step-subtitle">您的报修已提交，请耐心等待维修人员联系</view>

      <!-- 紧急联系人：有紧急需求可直接复制 QQ 联系 -->
      <view class="emergency-section" wx:if="{{emergencyContacts.length}}">
        <view class="emergency-section-title">紧急联系人</view>
        <view class="emergency-section-subtitle">如维修需求较为紧急，可点击下方 QQ 号复制，前往 QQ 搜索并联系对应维修人员</view>
        <view class="emergency-contact-item" wx:for="{{emergencyContacts}}" wx:key="openid">
          <view class="emergency-contact-name-col">
            <view class="emergency-contact-label">昵称</view>
            <view class="emergency-contact-name">{{item.nickName}}</view>
          </view>
          <view
            class="emergency-contact-qq-col"
            hover-class="emergency-contact-qq-col--hover"
            bindtap="onCopyEmergencyQQ"
            data-qq="{{item.qqId}}"
            data-name="{{item.nickName}}"
          >
            <view class="emergency-contact-label">QQ号</view>
            <view class="emergency-contact-qq-row">
              <text class="emergency-contact-qq">{{item.qqId}}</text>
              <text class="emergency-contact-copy">点击复制</text>
            </view>
          </view>
        </view>
      </view>

      <view class="button-group">
        <button class="btn btn-outline" bindtap="goToTodo">查看进度</button>
        <button class="btn btn-primary" bindtap="goToRepair">再次报修</button>
      </view>
    </view>
  </view>
</view>
