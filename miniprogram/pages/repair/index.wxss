@import "/styles/data-pages.wxss";
/* miniprogram/pages/repair/index.wxss
   报修向导 - 顶部步骤条 + 白卡表单
   风格与「我的消息」「待办详情」「关于我们」保持一致 */
@import "/styles/variables.wxss";
@import "/styles/custom-navbar.wxss";

page {
  background-color: var(--bg-page);
  color: var(--text-primary);
}

.repair-container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 220rpx; /* 为悬浮 tabBar 预留空间 */
  background-color: var(--bg-page);
  box-sizing: border-box;
}

/* ==================== 顶部步骤条 ==================== */
.step-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 900;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}

.step-track {
  position: relative;
  display: flex;
  height: 100%;
  margin: 0 48rpx;
}

.step-track-line,
.step-track-fill {
  position: absolute;
  top: 38rpx;
  height: 2rpx;
}

.step-track-line {
  left: 16.67%;
  right: 16.67%;
  background: #e8eaee;
}

.step-track-fill {
  left: 16.67%;
  background: var(--primary);
  transition: width 0.35s ease;
}

.step-node {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.node-dot {
  width: 34rpx;
  height: 34rpx;
  margin-top: 22rpx;
  border: 2rpx solid var(--border);
  border-radius: 50%;
  background: var(--bg-card);
  color: var(--text-muted);
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
  transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
}

.step-node.done .node-dot {
  border-color: var(--primary);
  background: var(--primary);
  color: #ffffff;
}

.step-node.current .node-dot {
  border-color: var(--primary);
  background: var(--primary);
  color: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(0, 0, 205, 0.08);
}

.node-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.3;
  color: var(--text-muted);
  transition: color 0.25s ease;
}

.step-node.done .node-text,
.step-node.current .node-text {
  color: var(--primary);
  font-weight: 600;
}

/* ==================== 卡片 ==================== */
.step-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border: 1rpx solid #f0f1f5;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.step-title {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
}

.step-title.success-title {
  color: var(--success);
}

.step-subtitle {
  margin-top: 10rpx;
  margin-bottom: 30rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

/* ==================== 按钮 ==================== */
.btn {
  display: inline-block;
  padding: 0 36rpx;
  height: 84rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border-radius: 999rpx;
  box-sizing: border-box;
  transition: opacity 0.15s ease, background-color 0.15s ease;
}

.btn::after {
  border: none;
}

.btn-primary {
  color: #ffffff;
  background: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-primary:active {
  opacity: 0.88;
}

.btn-outline {
  color: var(--text-secondary);
  background: transparent;
  border: 2rpx solid var(--border);
}

.btn-outline:active {
  background: rgba(0, 0, 0, 0.03);
}

/* 用双类选择器提高优先级，覆盖小程序 button[disabled] 的默认样式 */
.btn.btn-disabled {
  color: #ffffff;
  background: #c9cdd6;
  border-color: #c9cdd6;
  opacity: 1;
}

.button-group {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.button-group .btn {
  flex: 1;
}

.button-group.single-button .btn {
  flex: 1;
}

/* ==================== 分类入口列表 ==================== */
.category-list {
  border-top: 1rpx solid #f0f1f5;
}

.category-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 4rpx;
}

.category-row + .category-row {
  border-top: 1rpx solid #f0f1f5;
}

.category-row:active {
  opacity: 0.6;
}

.category-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

/* 通用右向箭头 */
.row-arrow {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  margin-left: 16rpx;
  border-right: 3rpx solid #c9ced6;
  border-bottom: 3rpx solid #c9ced6;
  transform: rotate(-45deg);
}

/* ==================== 选择网格 ==================== */
.selection-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.selection-item {
  padding: 28rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  background: #f7f8fa;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.4;
  text-align: center;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.selection-item:active {
  opacity: 0.75;
}

.selection-item.selected {
  border-color: var(--primary);
  background: rgba(0, 0, 205, 0.06);
  color: var(--primary);
  font-weight: 600;
}

/* ==================== 表单字段 ==================== */
.special-field {
  margin-bottom: 26rpx;
}

.field-label {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.field-label .required {
  margin-left: 6rpx;
  color: var(--danger);
}

.field-label .optional {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--text-muted);
  background: #f2f3f6;
}

.field-input {
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  background: var(--bg-card);
  box-sizing: border-box;
  transition: border-color 0.15s ease;
}

.field-input:focus {
  border-color: var(--primary);
}

.special-field.has-error .field-input,
.special-field.has-error .picker-item {
  border-color: var(--danger);
  background: rgba(255, 77, 79, 0.04);
}

.field-error {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--danger);
}

.field-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-muted);
}

.field-hint-right {
  text-align: right;
}

.form-divider {
  height: 1rpx;
  margin: 30rpx 0;
  background: #f0f1f5;
}

/* ==================== 选择器行 ==================== */
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 22rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.appointment-container .picker-item {
  margin-bottom: 0;
  border: none;
  border-bottom: 1rpx solid #f0f1f5;
  border-radius: 0;
  padding: 26rpx 4rpx;
}

.appointment-container .picker-item:last-child {
  border-bottom: none;
}

.picker-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-right {
  display: flex;
  align-items: center;
}

.picker-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker-value.placeholder {
  color: var(--text-muted);
}

.description-label {
  margin-top: 30rpx;
}

.description-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--bg-card);
  box-sizing: border-box;
}

.description-textarea:focus {
  border-color: var(--primary);
}

/* ==================== 分类地图入口 ==================== */
.map-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 205, 0.05);
  font-size: 26rpx;
  color: var(--primary);
}

.map-entry:active {
  opacity: 0.8;
}

.map-entry-icon {
  width: 26rpx;
  height: 26rpx;
}

/* ==================== 确认页 ==================== */
.confirm-list {
  border-top: 1rpx solid #f0f1f5;
}

.confirm-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
}

.confirm-item + .confirm-item {
  border-top: 1rpx solid #f0f1f5;
}

.confirm-main {
  flex: 1;
  min-width: 0;
}

.confirm-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.confirm-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
  word-break: break-all;
}

.confirm-lines {
  margin-top: 8rpx;
}

.confirm-line {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

/* ==================== 提交成功页 ==================== */
.success-card {
  padding: 48rpx 28rpx 36rpx;
  text-align: center;
}

.success-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 26rpx;
  border-radius: 50%;
  background: rgba(82, 196, 26, 0.1);
}

.success-icon {
  width: 76rpx;
  height: 76rpx;
}

.success-card .step-subtitle {
  margin-bottom: 0;
}

/* ==================== 紧急联系人 ==================== */
.emergency-section {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f1f5;
  text-align: left;
}

.emergency-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.emergency-section-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.emergency-contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #f0f1f5;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.emergency-contact-name-col {
  flex: 1;
  min-width: 0;
  padding-right: 24rpx;
}

.emergency-contact-label {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-muted);
  margin-bottom: 6rpx;
}

.emergency-contact-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.emergency-contact-qq-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  max-width: 62%;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 205, 0.05);
}

.emergency-contact-qq-col--hover {
  opacity: 0.7;
}

.emergency-contact-qq-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.emergency-contact-qq {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  word-break: break-all;
}

.emergency-contact-copy {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--text-muted);
}

/* ==================== 搜索 ==================== */
.search-wrapper {
  position: relative;
  margin-bottom: 24rpx;
  z-index: 120;
}

.search-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 84rpx;
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  background: var(--bg-card);
  box-sizing: border-box;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  opacity: 0.55;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-primary);
}

.search-input::placeholder {
  color: var(--text-muted);
}

.search-clear {
  flex-shrink: 0;
  padding-left: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.search-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 96rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid #f0f1f5;
  border-radius: 20rpx;
  background: var(--bg-card);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.1);
  z-index: 130;
}

.panel-title {
  padding: 0 8rpx 14rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.panel-empty {
  padding: 12rpx 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2f3f6;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.chip:active {
  background: rgba(0, 0, 205, 0.08);
  color: var(--primary);
}

.result-scroll {
  max-height: 480rpx;
}

.result-item {
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
}

.result-item + .result-item {
  border-top: 1rpx solid #f0f1f5;
}

.result-item:active {
  background: rgba(0, 0, 205, 0.05);
}

.result-main {
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text-primary);
}

.result-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.primary-btn, .btn-primary, .submit-btn { min-height: 48px; background: var(--mg-color-brand); color: var(--mg-color-on-brand); border-color: var(--mg-color-brand); border-radius: 16rpx; }
.field-input, .description-textarea { min-height: 48px; border: 1px solid var(--mg-color-control-border); color: var(--mg-color-text-primary); font-size: 15px; }
.step-bar { z-index: 100; }
.step-card { border: 0; border-radius: 24rpx; padding: 32rpx; }
.button-group { gap: 8px; }
.button-group .btn { min-height: 48px; height: auto; line-height: 1.5; padding: 24rpx; }
.logo-pulse, .input-decoration { display: none; }
.form-label { height: auto; flex-wrap: wrap; }
.privacy-agreement, .privacy-link { min-height: 48px; }
@media (prefers-reduced-motion: reduce) { .logo-wrapper, .auth-container, .step-node { animation: none; transition: none; } }
