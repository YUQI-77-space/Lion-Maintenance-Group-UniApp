@import "/styles/data-pages.wxss";
/* pages/repair/map/index.wxss
   维修分类地图 - 白卡折叠列表 */
@import "/styles/variables.wxss";

page {
  background-color: var(--bg-page);
  color: var(--text-primary);
}

.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* ==================== 顶部提示 ==================== */
.map-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #f0f1f5;
  border-radius: 16rpx;
  background: var(--bg-card);
}

.tip-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-secondary);
}

.tip-action {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: var(--primary);
}

.tip-action:active {
  opacity: 0.6;
}

/* ==================== 分类卡片 ==================== */
.map-card {
  margin-bottom: 20rpx;
  border: 1rpx solid #f0f1f5;
  border-radius: 20rpx;
  background: var(--bg-card);
  overflow: hidden;
}

.cat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.cat-header:active {
  background: #f7f8fa;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.cat-body {
  padding: 0 28rpx 8rpx;
}

/* ==================== 子分类 ==================== */
.sub-card {
  border-top: 1rpx solid #f0f1f5;
}

.sub-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
}

.sub-header:active {
  opacity: 0.6;
}

.sub-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.types {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding-bottom: 22rpx;
}

.type-chip {
  padding: 12rpx 22rpx;
  border: 1rpx solid rgba(0, 0, 205, 0.25);
  border-radius: 999rpx;
  background: rgba(0, 0, 205, 0.05);
  color: var(--primary);
  font-size: 24rpx;
  line-height: 1.3;
}

.type-chip:active {
  background: rgba(0, 0, 205, 0.14);
}

/* ==================== 折叠箭头 ==================== */
.arrow {
  flex-shrink: 0;
  width: 18rpx;
  height: 18rpx;
  margin-left: 16rpx;
  border-right: 3rpx solid #c9ced6;
  border-bottom: 3rpx solid #c9ced6;
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.arrow.small {
  width: 14rpx;
  height: 14rpx;
  border-width: 2rpx;
}

.arrow.expanded {
  transform: rotate(-135deg);
}

.primary-btn, .btn-primary, .submit-btn { min-height: 48px; background: var(--mg-color-brand); color: var(--mg-color-on-brand); border-color: var(--mg-color-brand); border-radius: 16rpx; }
.field-input, .description-textarea { min-height: 48px; border: 1px solid var(--mg-color-control-border); color: var(--mg-color-text-primary); font-size: 15px; }
.step-bar { z-index: 100; }
.step-card { border: 0; border-radius: 24rpx; padding: 32rpx; }
.button-group { gap: 8px; }
.button-group .btn { min-height: 48px; height: auto; line-height: 1.5; padding: 24rpx; }
.logo-pulse, .input-decoration { display: none; }
.form-label { height: auto; flex-wrap: wrap; }
.privacy-agreement, .privacy-link { min-height: 48px; }
@media (prefers-reduced-motion: reduce) { .logo-wrapper, .auth-container, .step-node { animation: none; transition: none; } }
