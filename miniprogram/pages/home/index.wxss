/* pages/home/index.wxss - 极简线框风格 */
/* 引入公共样式 */
@import "/styles/common.wxss";
@import "/styles/custom-navbar.wxss";

/* ============================================
   顶部导航栏：乳白毛玻璃，只虚化背景，保留标志与文字清晰
   ============================================ */
/* 首屏保留轮播完整占位；滚动内容经过栏后时仅透出柔和底色。
   高不透明度保证不支持背景模糊时仍可阅读，滚动前后保持相同材质。 */
.custom-navbar,
.custom-navbar.is-scrolled {
  background: rgba(255, 255, 255, 0.84);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
}

/* ============================================
   页面容器
   ============================================ */
.home-container {
  display: flex;
  flex-direction: column;
  gap: var(--mg-space-4);
  position: relative;
  min-height: 100vh;
  background-color: var(--bg-page);
  -webkit-overflow-scrolling: touch;
  /* 为悬浮 tabBar 预留空间，否则滑到底时团队荣誉会被导航栏盖住 */
  padding-bottom: 220rpx;
}

/* 入场动效：只做位移与透明度，避免低端机合成层压力 */
@keyframes home-fade-up {
  from { opacity: 0; transform: translate3d(0, 16rpx, 0); }
  to { opacity: 1; transform: translate3d(0, 0, 0); }
}

.entrance {
  /* backwards：动画结束即回到元素自身样式，避免动画未执行时内容停留在 opacity:0 */
  animation: home-fade-up 0.32s ease backwards;
}

/* ============================================
   今日状态卡
   ============================================ */
.today-card {
  position: relative;
  z-index: 2;
  background-color: var(--card-background);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-card);
  padding: 24rpx 0;
}

.today-block {
  padding: 0 var(--space-md);
}


.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

/* 卡片标题共用一套字型：值班 / 我的待办 处于同一层级，字号字重必须一致 */
.block-title,
.todo-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: 600;
  color: var(--text-main);
}

.block-more {
  font-size: var(--mg-font-label);
  color: var(--primary-color);
}

.block-more.muted {
  color: var(--text-placeholder);
}

/* 有人值班 */
.duty-live-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.duty-name {
  font-size: var(--mg-font-title); line-height: var(--mg-line-title);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
  margin-right: 12rpx;
}

.duty-flag {
  font-size: var(--mg-font-caption);
  color: var(--success-color);
  border: 1rpx solid var(--success-color);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}

.duty-remain {
  font-size: var(--mg-font-caption);
  color: var(--text-secondary);
}

.duty-time {
  margin-top: 8rpx;
  font-size: var(--mg-font-label);
  color: var(--text-regular);
}

.duty-progress {
  margin-top: 14rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: var(--border-light);
  overflow: hidden;
}

.duty-progress-inner {
  height: 100%;
  border-radius: 3rpx;
  background-color: var(--primary-color);
  transition: width 0.4s ease;
}

/* 无人值班 / 非值班时段 / 数据不可用 */
.duty-empty-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: 600;
  color: var(--text-main);
}

.duty-empty-sub {
  margin-top: 8rpx;
  font-size: var(--mg-font-caption);
  line-height: 1.5;
  color: var(--text-secondary);
}

/* 一周值班条 */
.week-strip {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border-light);
}

.week-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.week-name {
  font-size: var(--mg-font-caption);
  color: var(--text-secondary);
}

.week-bar {
  width: 8rpx;
  height: 36rpx;
  margin: 8rpx 0;
  border-radius: 4rpx;
  background-color: var(--border-light);
}

.week-bar.on {
  background-color: var(--primary-color);
}

.week-date {
  font-size: var(--mg-font-caption);
  color: var(--text-placeholder);
}

.week-cell.is-today .week-name {
  color: var(--primary-color);
  font-weight: 600;
}

.week-cell.is-today .week-date {
  color: var(--primary-color);
}

/* ============================================
   我的待办：我提交的报修进度
   ============================================ */
.todo-card {
  padding: 24rpx var(--space-md);
  background-color: var(--card-background);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-card);
}

/* 字型与值班标题共用上面的 .block-title，这里只补数量胶囊所需的横排 */
.todo-title {
  display: flex;
  align-items: center;
}

/* 待办数量小胶囊 */
.todo-count {
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 10rpx;
  margin-left: 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background-color: rgba(0, 0, 205, 0.08);
  color: var(--primary-color);
  font-size: var(--mg-font-caption);
  text-align: center;
}

.todo-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}

/* 最后一条不再画线，与卡片底部留白衔接 */
.todo-item:last-of-type {
  border-bottom: none;
  padding-bottom: 4rpx;
}

/* 标题与状态药丸同排 */
.todo-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.todo-item-title {
  flex: 1;
  min-width: 0;
  font-size: var(--mg-font-body);
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 字段两栏网格：把信息横向铺开，而不是竖向堆成一列 */
.todo-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 24rpx;
  margin-top: 18rpx;
}

.todo-field {
  min-width: 0;
}

.todo-field-label {
  display: block;
  font-size: var(--mg-font-caption);
  line-height: 1.4;
  color: var(--text-placeholder);
}

.todo-field-value {
  display: block;
  margin-top: 6rpx;
  font-size: var(--mg-font-label);
  line-height: 1.4;
  color: var(--text-main);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 预约时间是本卡片最该被先看到的字段，单独上主色加重 */
.todo-field-value.strong {
  font-weight: 600;
  color: var(--primary-color);
}

/* 动作行：右对齐，让进度轨保持收尾位置 */
.todo-item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

/* 状态药丸：沿用维修任务的状态色 */
.todo-status {
  flex-shrink: 0;
  font-size: var(--mg-font-caption);
  font-weight: 500;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
  background-color: transparent;
}

.todo-status.status-pending {
  color: var(--maintenance-pending-color);
  border-color: var(--maintenance-pending-color);
}

.todo-status.status-inProgress {
  color: var(--maintenance-inProgress-color);
  border-color: var(--maintenance-inProgress-color);
}

/* 三段式进度条：走过的阶段填色，当前阶段在下面对应高亮 */
.todo-progress {
  display: flex;
  gap: 6rpx;
  margin-top: 20rpx;
}

.todo-progress-seg {
  flex: 1;
  height: 10rpx;
  border-radius: 6rpx;
  background-color: var(--border-light);
  transition: background-color 0.3s ease;
}

.todo-progress-seg.on {
  background-color: var(--primary-color);
}

.todo-stages {
  display: flex;
  gap: 6rpx;
  margin-top: 10rpx;
}

.todo-stage {
  flex: 1;
  text-align: center;
  font-size: var(--mg-font-caption);
  color: var(--text-placeholder);
}

.todo-stage.cur {
  color: var(--primary-color);
  font-weight: 600;
}

.todo-item-btn {
  flex-shrink: 0;
  padding: 12rpx 30rpx;
  font-size: var(--mg-font-caption);
  font-weight: 600;
  color: #FFFFFF;
  background-color: var(--primary-color);
  border-radius: 999rpx;
}

.todo-item-btn:active {
  opacity: 0.85;
}

.todo-item-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 空态：没有任何进行中的报修 */
.todo-empty {
  padding: 16rpx 0 4rpx;
}

.todo-empty-text {
  font-size: var(--mg-font-label);
  line-height: var(--mg-line-label);
  color: var(--text-secondary);
}

/* ============================================
   快捷入口：紧凑、独立的圆角区域
   ============================================ */
.quick-actions {
  display: flex;
  align-items: stretch;
  gap: 8px;
  padding: 0;
  background: transparent;
  border: 0;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 48px;
  min-height: 72px;
  padding: 12rpx 0;
  border-radius: 32rpx;
  background: var(--mg-color-bg-surface);
}

.quick-icon {
  width: 24px;
  height: 24px;
}

.quick-title {
  margin-top: 8rpx;
  font-size: var(--mg-font-label);
  line-height: var(--mg-line-label);
  text-align: center;
  white-space: normal;
  color: var(--mg-color-text-primary);
}

.quick-item.primary .quick-title {
  color: var(--mg-color-brand);
  font-weight: 500;
}

.quick-item-pressed {
  background: var(--mg-color-bg-subtle);
}


/* ============================================
   板块通用样式
   ============================================ */
.section {
  min-width: 0;
}

/* ============================================
   特色活动：1 大 + 2 小
   ============================================ */
.feature-hero {
  height: 320rpx;
  border-radius: var(--radius-image);
  overflow: hidden;
  background-color: var(--mg-color-bg-subtle);
}

.feature-hero:active {
  opacity: 0.9;
}

.feature-hero-img {
  display: block;
  width: 100%;
  height: 100%;
}

.feature-pair {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.feature-small {
  flex: 1;
  height: 200rpx;
  border-radius: var(--radius-image);
  overflow: hidden;
  background-color: var(--mg-color-bg-subtle);
}

.feature-small:active {
  opacity: 0.9;
}

.feature-small-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* ============================================
   团队风采：横向滑动流
   ============================================ */
.feature-strip {
  width: 100%;
  white-space: nowrap;
}

.strip-track {
  display: flex;
  gap: 16rpx;
}

.strip-card-item {
  width: 470rpx;
  height: 260rpx;
  flex-shrink: 0;
  border-radius: var(--radius-image);
  overflow: hidden;
  background-color: var(--mg-color-bg-subtle);
}

.strip-card-img {
  display: block;
  width: 100%;
  height: 100%;
}

/* ============================================
   荣誉履带区域
   ============================================ */
.honors-conveyor {
  overflow: hidden;
  position: relative;
}

.conveyor-track {
  display: flex;
  height: 240rpx;
  animation: conveyor-move 12000ms linear infinite;
}

.conveyor-content {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 16rpx;
  padding-right: 16rpx;
  height: 100%;
}

/* 离开首页时暂停 */
.conveyor-track.paused {
  animation-play-state: paused;
}

.honor-card {
  position: relative;
  height: 240rpx;
  border-radius: var(--radius-image);
  overflow: hidden;
  background-color: var(--bg-card);
  flex-shrink: 0;
}

.honor-card:active {
  opacity: 0.8;
}

.honor-card-image {
  display: block;
  width: 100%;
  height: 100%;
  background-color: var(--bg-page);
}

.honor-card-skeleton {
  width: 100%;
  height: 240rpx;
  border-radius: var(--radius-image);
  background: var(--mg-color-bg-subtle);
}

.honors-hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: var(--mg-font-caption);
  color: var(--text-placeholder);
}

@keyframes conveyor-move {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(-50%, 0, 0); }
}


.media-empty { padding: var(--mg-space-6) var(--mg-space-4); text-align: center; color: var(--mg-color-text-muted); font-size: var(--mg-font-label); line-height: var(--mg-line-label); }
.feature-strip.strip-track { overflow: hidden; }

/* 首页布局：顶部照片、服务入口、当前事项、团队内容。 */
.home-container { padding-left: 32rpx; padding-right: 32rpx; }
/* 板块间距仅由父容器 gap 管理，避免各自 margin 叠加或折叠。 */
.team-photo-section, .quick-actions, .today-card, .todo-card, .section { flex-shrink: 0; margin: 0; }
.today-card, .todo-card, .section { border: 0; box-shadow: none; }
.today-card, .todo-card { padding: 24rpx 32rpx; border-radius: 24rpx; }
.today-block { padding: 0; }
.todo-title { flex-wrap: wrap; gap: 8px; }
.todo-title .progress-link { display: flex; align-items: center; justify-content: flex-end; font-weight: 400; width: 4.5em; flex-shrink: 0; min-height: 48px; min-width: 48px; background: transparent; color: var(--mg-color-brand); font-size: var(--mg-font-label); line-height: 48px; margin: 0 0 0 auto; padding: 0; border: 0; }
.progress-link::after { border: 0; }
.todo-item-title { font-size: var(--mg-font-body); white-space: normal; overflow-wrap: break-word; }
.todo-field-value { white-space: normal; overflow-wrap: break-word; }
.todo-fields { grid-template-columns: 1fr; }
.entrance { animation: none; }

.team-photo-section { position: relative; margin-top: var(--mg-space-3); border-radius: 24rpx; overflow: hidden; background: var(--mg-color-bg-subtle); }
.team-photo-swiper { width: 100%; height: 340rpx; }
.team-photo { width: 100%; height: 100%; }
.photo-unavailable { height: 100%; display: flex; align-items: center; justify-content: center; color: var(--mg-color-text-muted); background: var(--mg-color-bg-subtle); }
@media (prefers-reduced-motion: reduce) {
  .conveyor-track { animation: none; }
  .honors-conveyor { overflow-x: auto; }
}

.unified-media-wait { display: flex; align-items: center; justify-content: center; background: var(--mg-color-bg-subtle); }
