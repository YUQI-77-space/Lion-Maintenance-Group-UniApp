/* 阶段 2：显式复用视觉基础；页面业务样式仍在本文件。 */
@import "/styles/design-primitives.wxss";
.gallery-page .gallery-header { padding: 16rpx 0 32rpx; }
.gallery-page .eyebrow { font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); color: var(--mg-color-brand-strong); margin-bottom: 16rpx; }
.gallery-page .page-title { font-size: var(--mg-font-title); line-height: var(--mg-line-title); font-weight: 600; }
.gallery-page .page-description { color: var(--mg-color-text-secondary); margin-top: 16rpx; }
.gallery-page .gallery-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24rpx; }
.gallery-page .photo-card { min-width: 0; overflow: hidden;  }
.gallery-page .photo-frame { position: relative; height: 0; padding-top: 75%; background: var(--mg-color-bg-subtle); }
.gallery-page .skeleton-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.gallery-page .photo-caption { display: flex; align-items: flex-start; justify-content: space-between; gap: 8rpx; padding: 16rpx; color: var(--mg-color-text-secondary); font-size: var(--mg-font-label); line-height: var(--mg-line-label); }
.gallery-page .photo-number { flex-shrink: 0; color: var(--mg-color-text-muted); }
.gallery-page .skeleton-line { display: block; width: 64%; height: 24rpx; margin: 8rpx 0; border-radius: 8rpx; background: var(--mg-color-bg-subtle); }
.gallery-page .gallery-status { margin-top: 32rpx; text-align: center; color: var(--mg-color-text-secondary); font-size: var(--mg-font-label); line-height: var(--mg-line-label); }
.gallery-page .gallery-help { margin-top: 16rpx; text-align: center; color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); }
.gallery-page .empty-state { padding: 64rpx 32rpx; text-align: center;  }
.gallery-page .empty-mark { width: 48rpx; height: 4rpx; background: var(--mg-color-brand); margin: 0 auto 24rpx; }
.gallery-page .empty-title { font-size: var(--mg-font-section); line-height: var(--mg-line-section); font-weight: 600; }
.gallery-page .empty-description { margin-top: 16rpx; color: var(--mg-color-text-secondary); }

.gallery-page .photo-error { padding: 0 16rpx 16rpx; font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); color: var(--mg-color-text-secondary); }
