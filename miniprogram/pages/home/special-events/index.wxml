<view class="gallery-page">
  <view class="gallery-header">
    <view class="eyebrow">物科院维修组 · 活动相册</view>
    <view class="page-title">在实践中，把热爱传递出去</view>
    <view class="page-description">在校园与社区，留下维修服务的足迹。</view>
  </view>
  <view class="gallery-grid">
    <view class="photo-card" wx:for="{{specialEvents}}" wx:key="id">
      <view class="photo-frame">
        <skeleton-image id="photo-{{index}}" data-index="{{index}}" class="skeleton-image" src="{{item.url}}" mode="aspectFill" lazy-load="{{false}}" placeholder-color="#EEF1F5" bindimageloadcomplete="onImageLoadComplete" />
      </view>
      <view class="photo-caption"><text>特色活动</text><text class="photo-number">{{index + 1}}</text></view>
      <view class="photo-error" wx:if="{{imageErrors[index]}}">图片暂不可用，请下拉重试</view>
    </view>
    <block wx:if="{{loading && specialEvents.length === 0}}">
      <view class="photo-card" wx:for="{{skeletonCount}}" wx:key="*this">
        <view class="photo-frame skeleton-frame"></view>
        <view class="photo-caption"><text class="skeleton-line"></text></view>
      </view>
    </block>
  </view>
  <view class="gallery-status" wx:if="{{loading}}">正在加载活动照片…</view>
  <view class="gallery-status" wx:if="{{!hasMore && specialEvents.length > 0}}">已展示全部照片</view>
  <view class="empty-state" wx:if="{{!loading && specialEvents.length === 0 && isInitialized}}">
    <view class="empty-mark"></view>
    <view class="empty-title">暂无特色活动照片</view>
    <view class="empty-description">照片更新后将在这里展示，可下拉刷新查看。</view>
  </view>
  <view class="gallery-help" wx:if="{{specialEvents.length > 0}}">图片未能显示？可下拉刷新后重试。</view>
</view>
