<scroll-view class="unified-page-scroll" scroll-y enhanced enable-back-to-top scroll-top="{{unifiedScrollTop}}" scroll-with-animation refresher-enabled refresher-default-style="none" refresher-triggered="{{unifiedRefreshing}}" bindrefresherrefresh="onUnifiedRefresh" bindscroll="onUnifiedScroll" bindscrolltolower="onUnifiedBottom" lower-threshold="50">
<view slot="refresher" class="unified-refresher"><loading-animation wx:if="{{unifiedRefreshing}}" size="small" /></view>
<view class="gallery-page mg-theme mg-page">
  <view class="gallery-header">
    <view class="eyebrow">物科院维修组 · 活动相册</view>
    <view class="page-title">在实践中，把热爱传递出去</view>
    <view class="page-description">在校园与社区，留下维修服务的足迹。</view>
  </view>
  <view class="gallery-grid">
    <block wx:if="{{loading && !specialEvents.length && !unifiedRefreshing}}">
      <view class="photo-card mg-surface mg-surface--flush" wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" aria-hidden="true"><view class="photo-frame"></view></view>
    </block>
    <view class="photo-card mg-surface mg-surface--flush" wx:for="{{specialEvents}}" wx:key="id">
      <view class="photo-frame">
        <skeleton-image id="photo-{{index}}" data-index="{{index}}" class="skeleton-image" src="{{item.url}}" mode="aspectFill" lazy-load="{{false}}" placeholder-color="#EEF1F5" bindimageloadcomplete="onImageLoadComplete" />
      </view>
      <view class="photo-caption"><text>特色活动</text><text class="photo-number">{{index + 1}}</text></view>
      <view class="photo-error" wx:if="{{imageErrors[index]}}">可下拉刷新重试</view>
    </view>
  </view>
  <view class="gallery-status" wx:if="{{loading && specialEvents.length > 0 && !unifiedRefreshing}}"><loading-animation size="default" /></view>
  <view class="gallery-status" wx:if="{{!hasMore && specialEvents.length > 0}}">已展示全部照片</view>
  <view class="empty-state mg-surface" wx:if="{{!loading && specialEvents.length === 0 && isInitialized}}">
    <view class="empty-mark"></view>
    <view class="empty-title">暂无特色活动照片</view>
    <view class="empty-description">照片更新后将在这里展示，可下拉刷新查看。</view>
  </view>
  <view class="gallery-help" wx:if="{{specialEvents.length > 0}}">图片未能显示？可下拉刷新后重试。</view>
</view>
</scroll-view>
<loading-overlay id="global-loading" />
