@import "/styles/data-pages.wxss";
/* pages/user/todo/maintenance-detail/index.wxss
   维修任务详情 - 白卡 + 细边框 + 状态色点缀
   风格与「我的消息」列表保持一致：克制的色彩、清晰的信息层级 */
@import "/styles/variables.wxss";

.page {
  min-height: 100vh;
  padding: 24rpx;
  background: var(--bg-page);
  box-sizing: border-box;
}

/* 底部有操作栏时留出空间 */
.page.has-action-bar {
  padding-bottom: 180rpx;
}

/* ==================== 加载状态 ==================== */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

/* ==================== 卡片 ==================== */
.card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--mg-color-border);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.card:last-child {
  margin-bottom: 0;
}

/* 卡片标题：左侧品牌色竖条 */
.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

/* ==================== 概览头部 ==================== */
.hero {
  display: flex;
  align-items: flex-start;
}

.hero-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: rgba(145, 158, 171, 0.14);
}

/* 图标底色跟随任务状态，作为最轻量的状态提示 */
.status-pending .hero-tile { background: rgba(250, 140, 22, 0.12); }
.status-inProgress .hero-tile { background: rgba(24, 144, 255, 0.12); }
.status-completed .hero-tile { background: rgba(82, 196, 26, 0.12); }
.status-cancelled .hero-tile { background: rgba(145, 158, 171, 0.14); }

.hero-icon {
  width: 44rpx;
  height: 44rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
  word-break: break-word;
}

.hero-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.hero-sub-text {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.tag-soft {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--text-secondary);
  background: rgba(145, 158, 171, 0.16);
}

/* 状态徽标 */
.status-pill {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-secondary);
  background: rgba(145, 158, 171, 0.16);
}

.status-pill.pending {
  color: var(--maintenance-pending-color);
  background: rgba(250, 140, 22, 0.12);
}

.status-pill.inProgress {
  color: var(--maintenance-inProgress-color);
  background: rgba(24, 144, 255, 0.12);
}

.status-pill.completed {
  color: var(--maintenance-completed-color);
  background: rgba(82, 196, 26, 0.12);
}

.status-pill.cancelled {
  color: var(--text-secondary);
  background: rgba(145, 158, 171, 0.16);
}

/* ==================== 字段网格 ==================== */
.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 26rpx 20rpx;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--mg-color-border);
}

/* 设备信息卡内不需要再画一条顶部分割线 */
.meta-grid.no-top-line {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.meta-item {
  min-width: 0;
}

.meta-item.full {
  grid-column: 1 / -1;
}

.meta-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.meta-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-primary);
  word-break: break-all;
}

.meta-value.strong {
  font-weight: 600;
  color: var(--primary);
}

.meta-value.link {
  color: var(--primary);
}

.copy-hint {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ==================== 文本块 ==================== */
.note {
  padding: 22rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-secondary);
  background: var(--mg-color-bg-page);
  white-space: pre-wrap;
  word-break: break-word;
}

.note-danger {
  color: var(--danger);
  background: rgba(255, 77, 79, 0.06);
}

/* ==================== 人员 ==================== */
.person {
  display: flex;
  align-items: center;
}

.avatar-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary);
  background: rgba(0, 0, 205, 0.06);
}

.avatar-badge.muted {
  color: var(--text-secondary);
  background: rgba(145, 158, 171, 0.14);
}

.person-main {
  flex: 1;
  min-width: 0;
}

.person-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
}

.person-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-secondary);
  word-break: break-all;
}

.role-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(0, 0, 205, 0.06);
}

.sub-divider {
  height: 1rpx;
  margin: 28rpx 0 24rpx;
  background: var(--mg-color-border);
}

.sub-title {
  margin-bottom: 22rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.person.sub-person + .person.sub-person {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx dashed #eef0f4;
}

/* ==================== 底部操作栏 ==================== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--mg-color-border);
}

.action-btn {
  flex: 1;
  height: 84rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.action-btn.primary {
  color: #ffffff;
  background: var(--primary);
}

.action-btn.primary:active {
  opacity: 0.88;
}

.action-btn.ghost {
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
}

.action-btn.ghost:active {
  background: rgba(0, 0, 0, 0.03);
}

.action-btn.ghost-danger {
  color: var(--danger);
  border: 2rpx solid rgba(255, 77, 79, 0.45);
}

.action-btn.ghost-danger:active {
  background: rgba(255, 77, 79, 0.06);
}

.action-btn.danger {
  color: #ffffff;
  background: var(--danger);
}

.action-btn.danger:active {
  opacity: 0.88;
}

/* ==================== 撤销弹窗 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  box-sizing: border-box;
  background: rgba(15, 18, 24, 0.55);
}

.modal-card {
  width: 100%;
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--mg-color-border);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 34rpx;
  line-height: 1;
  color: var(--text-muted);
  background: #f2f3f6;
}

.modal-body {
  padding: 28rpx 32rpx 8rpx;
}

.modal-label {
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.modal-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--mg-color-bg-page);
  box-sizing: border-box;
}

.modal-count {
  margin-top: 10rpx;
  font-size: 22rpx;
  text-align: right;
  color: var(--text-muted);
}

.modal-foot {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 30rpx;
}

.action-bar { z-index: 200; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: var(--mg-color-bg-surface); }
