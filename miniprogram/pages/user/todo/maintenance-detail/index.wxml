<!--pages/user/todo/maintenance-detail/index.wxml-->
<view class="mg-theme mg-data-page page {{showActionBar ? 'has-action-bar' : ''}}" style="padding-bottom: {{showActionBar ? bottomActionInset : 16}}px;">
  <view class="mg-page-notice mg-page-notice--error" wx:if="{{detailError}}">{{detailError}}<button class="mg-button mg-button--secondary" bindtap="loadTaskDetail">重新加载</button><button class="mg-button mg-button--text" bindtap="returnToList">返回列表</button></view>
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <loading-animation size="large"></loading-animation>
  </view>

  <block wx:if="{{!loading && taskDetail}}">
    <!-- 概览 -->
    <view class="card status-{{taskDetail.taskStatus}}">
      <view class="hero">
        <view class="hero-tile">
          <image class="hero-icon" src="{{iconRepair}}"></image>
        </view>
        <view class="hero-main">
          <text class="hero-title">{{taskDetail.level3}}</text>
          <view class="hero-sub">
            <text class="hero-sub-text">{{taskDetail.level1}} · {{taskDetail.level2}}</text>
            <text class="tag-soft" wx:if="{{taskDetail.isManagementCreated}}">组长创建</text>
          </view>
        </view>
        <view class="status-pill {{taskDetail.taskStatus}}">{{statusText}}</view>
      </view>

      <view class="meta-grid">
        <view class="meta-item full">
          <text class="meta-label">预约时间</text>
          <text class="meta-value">{{taskDetail.appointmentTime || '未预约'}}</text>
        </view>
        <view class="meta-item full" wx:if="{{taskDetail.completeTime}}">
          <text class="meta-label">完成时间</text>
          <text class="meta-value">{{taskDetail.completeTime}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">申请人</text>
          <text class="meta-value">{{taskDetail.applicantName || '未填'}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">受理人</text>
          <text class="meta-value">{{taskDetail.assigneeName || '待受理'}}</text>
        </view>
        <view class="meta-item" wx:if="{{taskDetail.cost}}">
          <text class="meta-label">所需费用</text>
          <text class="meta-value strong">¥{{taskDetail.cost}}</text>
        </view>
        <view class="meta-item {{taskDetail.cost ? '' : 'full'}}">
          <text class="meta-label">任务编号</text>
          <text class="meta-value">{{taskDetail.taskId}}</text>
        </view>
      </view>
    </view>

    <!-- 设备信息 -->
    <view class="card" wx:if="{{deviceFields.length > 0}}">
      <view class="card-title">设备信息</view>
      <view class="meta-grid no-top-line">
        <view class="meta-item" wx:for="{{deviceFields}}" wx:key="label">
          <text class="meta-label">{{item.label}}</text>
          <text class="meta-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <!-- 问题描述 -->
    <view class="card">
      <view class="card-title">问题描述</view>
      <view class="note">{{taskDetail.otherDescription || '暂无描述'}}</view>
    </view>

    <!-- 备注信息 -->
    <view class="card" wx:if="{{taskDetail.comments}}">
      <view class="card-title">备注信息</view>
      <view class="note">{{taskDetail.comments}}</view>
    </view>

    <!-- 撤销原因 -->
    <view class="card" wx:if="{{taskDetail.taskStatus === 'cancelled' && taskDetail.cancelReason}}">
      <view class="card-title">撤销原因</view>
      <view class="note note-danger">{{taskDetail.cancelReason}}</view>
    </view>

    <!-- 申请人信息 -->
    <view class="card">
      <view class="card-title">申请人信息</view>
      <view class="person">
        <view class="avatar-badge">{{applicantInitial}}</view>
        <view class="person-main">
          <text class="person-name">{{taskDetail.applicantName || '未填'}}</text>
          <text class="person-meta">学号 {{taskDetail.applicantStudentId || '未填'}}</text>
        </view>
      </view>
      <view class="meta-grid">
        <view class="meta-item" wx:if="{{taskDetail.applicantQqId}}">
          <text class="meta-label">QQ号</text>
          <text class="meta-value link" bindlongpress="copyQQ" data-qq="{{taskDetail.applicantQqId}}" data-type="申请人">{{taskDetail.applicantQqId}}<text class="copy-hint">长按复制</text></text>
        </view>
        <view class="meta-item">
          <text class="meta-label">申请时间</text>
          <text class="meta-value">{{taskDetail.applicantTime || '未填'}}</text>
        </view>
      </view>
    </view>

    <!-- 受理人信息 -->
    <view class="card" wx:if="{{taskDetail.assigneeName}}">
      <view class="card-title">受理人信息</view>
      <view class="person">
        <view class="avatar-badge">{{assigneeInitial}}</view>
        <view class="person-main">
          <text class="person-name">{{taskDetail.assigneeName}}</text>
          <text class="person-meta">学号 {{taskDetail.assigneeStudentId || '未填'}}</text>
        </view>
        <text class="role-tag">主受理</text>
      </view>
      <view class="meta-grid">
        <view class="meta-item" wx:if="{{taskDetail.assigneeQqId}}">
          <text class="meta-label">QQ号</text>
          <text class="meta-value link" bindlongpress="copyQQ" data-qq="{{taskDetail.assigneeQqId}}" data-type="主受理人">{{taskDetail.assigneeQqId}}<text class="copy-hint">长按复制</text></text>
        </view>
        <view class="meta-item">
          <text class="meta-label">受理时间</text>
          <text class="meta-value">{{taskDetail.assigneeTime || '未填'}}</text>
        </view>
      </view>

      <!-- 协助受理人 -->
      <block wx:if="{{taskDetail.additionalAssignees.length > 0}}">
        <view class="sub-divider"></view>
        <view class="sub-title">协助受理人</view>
        <view class="person sub-person" wx:for="{{taskDetail.additionalAssignees}}" wx:key="assigneeId">
          <view class="avatar-badge muted">{{item.initial}}</view>
          <view class="person-main">
            <text class="person-name">{{item.assigneeName || '未填'}}</text>
            <text class="person-meta">学号 {{item.assigneeStudentId || '未填'}} · 受理 {{item.assigneeTime || '未填'}}</text>
          </view>
          <text class="role-tag" wx:if="{{item.assigneeQqId}}" bindlongpress="copyQQ" data-qq="{{item.assigneeQqId}}" data-type="协助受理人">QQ {{item.assigneeQqId}}</text>
        </view>
      </block>
    </view>
  </block>

  <!-- 底部操作栏 -->
  <view class="action-bar" wx:if="{{showActionBar}}">
    <view class="action-btn ghost-danger" bindtap="openCancelModal">撤销任务</view>
    <view class="action-btn primary" wx:if="{{canComplete}}" bindtap="confirmCompleteTask">确认完成</view>
  </view>

  <!-- 撤销任务弹窗 -->
  <view class="modal-mask" wx:if="{{showCancelModal}}" catchtouchmove="noop">
    <view class="modal-card" catchtap="noop">
      <view class="modal-head">
        <text class="modal-title">撤销任务</text>
        <view class="modal-close" bindtap="closeCancelModal">×</view>
      </view>
      <view class="modal-body">
        <view class="modal-label">请说明撤销原因</view>
        <textarea
          class="modal-textarea"
          placeholder="请输入撤销原因..."
          value="{{cancelReason}}"
          bindinput="onCancelReasonInput"
          maxlength="200"
          auto-height
        ></textarea>
        <view class="modal-count">{{cancelReason ? cancelReason.length : 0}}/200</view>
      </view>
      <view class="modal-foot">
        <view class="action-btn ghost" bindtap="closeCancelModal">取消</view>
        <view class="action-btn danger" bindtap="confirmCancelTask">确认撤销</view>
      </view>
    </view>
  </view>
</view>
