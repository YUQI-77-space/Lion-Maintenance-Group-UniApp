<!--pages/user/todo/volunteer-detail/index.wxml-->
<view class="mg-theme mg-data-page page">
  <view class="mg-page-notice mg-page-notice--error" wx:if="{{detailError}}">{{detailError}}<button class="mg-button mg-button--secondary" bindtap="loadTaskDetail">重新加载</button><button class="mg-button mg-button--text" bindtap="returnToList">返回列表</button></view>
  <scroll-view
    scroll-y="{{true}}"
    class="scroll-view"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <view class="mg-page-notice">活动状态描述整体安排；个人参与、反馈及结算以待办记录为准。</view>
  <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{loading}}">
      <loading-animation size="large"></loading-animation>
    </view>

    <block wx:if="{{!loading && taskDetail}}">
      <!-- 概览 -->
      <view class="card status-{{taskDetail.activityStatus}}">
        <view class="hero">
          <view class="hero-tile">
            <image class="hero-icon" src="{{iconVolunteer}}"></image>
          </view>
          <view class="hero-main">
            <text class="hero-title">{{taskDetail.title}}</text>
            <view class="hero-sub">
              <text class="hero-sub-text">志愿活动</text>
            </view>
          </view>
          <view class="status-pill {{taskDetail.activityStatus}}">{{taskDetail.activityStatusText}}</view>
        </view>

        <view class="meta-grid">
          <view class="meta-item full">
            <text class="meta-label">活动时间</text>
            <text class="meta-value">{{formattedStartTime}} 至 {{formattedEndTime}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-label">活动地点</text>
            <text class="meta-value">{{taskDetail.location || '未定'}}</text>
          </view>
          <view class="meta-item">
            <text class="meta-label">志愿时长</text>
            <text class="meta-value strong">{{taskDetail.volunteerHours || 0}} 小时</text>
          </view>
          <view class="meta-item full">
            <text class="meta-label">活动编号</text>
            <text class="meta-value">{{taskDetail.taskId || taskDetail.activityId}}</text>
          </view>
        </view>
      </view>

      <!-- 活动描述 -->
      <view class="card">
        <view class="card-title">活动描述</view>
        <view class="note">{{taskDetail.description || '暂无描述'}}</view>
      </view>

      <!-- 我的分工 -->
      <view class="card">
        <view class="card-title">我的分工</view>
        <view class="note" wx:if="{{myFeedback}}">{{myFeedback}}</view>
        <view class="note-empty" wx:else>还没有填写分工信息，点击下方按钮补充</view>
      </view>

      <!-- 底部操作栏占位 -->
      <view class="bottom-space" style="height: {{bottomActionInset}}px;" wx:if="{{showActionBar}}"></view>
    </block>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="action-dock" wx:if="{{showActionBar}}">
    <view class="dock-hint" wx:if="{{!canCancel && cancelReasonText}}">{{cancelReasonText}}</view>
    <view class="action-bar">
      <view class="action-btn ghost-danger {{!canCancel ? 'disabled' : ''}}" bindtap="cancelRegistration">取消报名</view>
      <view class="action-btn primary" bindtap="showFeedbackModal">{{myFeedback ? '修改分工' : '填写分工'}}</view>
    </view>
  </view>

  <!-- 分工信息弹窗 -->
  <view class="modal-mask" wx:if="{{showFeedbackModal}}" catchtouchmove="noop">
    <view class="modal-backdrop" bindtap="closeFeedbackModal"></view>
    <view class="modal-card" catchtap="noop">
      <view class="modal-head">
        <text class="modal-title">分工信息</text>
        <view class="modal-close" bindtap="closeFeedbackModal">×</view>
      </view>
      <view class="modal-body">
        <view class="modal-label">请填写您在本次活动中的具体工作内容</view>
        <textarea
          class="modal-textarea"
          placeholder="例如：负责签到与物资发放..."
          value="{{feedbackContent}}"
          bindinput="onFeedbackInput"
          maxlength="500"
          auto-height
        ></textarea>
        <view class="modal-count">{{feedbackContent ? feedbackContent.length : 0}}/500</view>
      </view>
      <view class="modal-foot">
        <view class="action-btn ghost" bindtap="closeFeedbackModal">取消</view>
        <view class="action-btn primary" bindtap="submitFeedback">提交</view>
      </view>
    </view>
  </view>
</view>
