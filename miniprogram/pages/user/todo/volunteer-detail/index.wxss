@import "/styles/data-pages.wxss";
/* pages/user/todo/volunteer-detail/index.wxss
   志愿活动详情 - 与维修任务详情共用同一套版式语言 */
@import "/styles/variables.wxss";

.page {
  height: 100vh;
  background: var(--bg-page);
}

.scroll-view {
  height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 底部操作栏占位，避免最后一张卡片被遮挡 */
.bottom-space {
  height: 160rpx;
}

/* ==================== 加载状态 ==================== */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

/* ==================== 卡片 ==================== */
.card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--mg-color-border);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.card:last-child {
  margin-bottom: 0;
}

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: 600;
  color: var(--text-primary);
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

/* ==================== 概览头部 ==================== */
.hero {
  display: flex;
  align-items: flex-start;
}

.hero-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: rgba(145, 158, 171, 0.14);
}

.status-inPreparation .hero-tile { background: rgba(250, 140, 22, 0.12); }
.status-inProgress .hero-tile { background: rgba(24, 144, 255, 0.12); }
.status-ended .hero-tile { background: rgba(82, 196, 26, 0.12); }

.hero-icon {
  width: 44rpx;
  height: 44rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  display: block;
  font-size: var(--mg-font-body);
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
  word-break: break-word;
}

.hero-sub {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.hero-sub-text {
  font-size: var(--mg-font-caption);
  line-height: 1.4;
  color: var(--text-secondary);
}

/* 状态徽标 */
.status-pill {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: var(--mg-font-caption);
  font-weight: 600;
  line-height: 1.3;
  color: var(--text-secondary);
  background: rgba(145, 158, 171, 0.16);
}

.status-pill.inPreparation {
  color: var(--warning);
  background: rgba(250, 140, 22, 0.12);
}

.status-pill.inProgress {
  color: var(--info);
  background: rgba(24, 144, 255, 0.12);
}

.status-pill.ended {
  color: var(--success);
  background: rgba(82, 196, 26, 0.12);
}

/* ==================== 字段网格 ==================== */
.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 26rpx 20rpx;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--mg-color-border);
}

.meta-item {
  min-width: 0;
}

.meta-item.full {
  grid-column: 1 / -1;
}

.meta-label {
  display: block;
  font-size: var(--mg-font-label);
  line-height: 1.4;
  color: var(--text-muted);
}

.meta-value {
  display: block;
  margin-top: 8rpx;
  font-size: var(--mg-font-body);
  line-height: 1.5;
  color: var(--text-primary);
  word-break: break-all;
}

.meta-value.strong {
  font-weight: 600;
  color: var(--primary);
}

/* ==================== 文本块 ==================== */
.note {
  padding: 22rpx;
  border-radius: 12rpx;
  font-size: var(--mg-font-body);
  line-height: 1.7;
  color: var(--text-secondary);
  background: var(--mg-color-bg-page);
  white-space: pre-wrap;
  word-break: break-word;
}

.note-empty {
  padding: 22rpx;
  border-radius: 12rpx;
  font-size: var(--mg-font-label);
  line-height: 1.6;
  text-align: center;
  color: var(--text-muted);
  background: var(--mg-color-bg-page);
}

/* ==================== 底部操作区 ==================== */
.action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--mg-color-border);
}

.dock-hint {
  padding: 16rpx 32rpx 0;
  font-size: var(--mg-font-caption);
  line-height: 1.5;
  text-align: center;
  color: var(--warning);
}

.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx 24rpx;
}

.action-btn {
  flex: 1;
  height: 84rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: var(--mg-font-body);
  font-weight: 600;
  box-sizing: border-box;
}

.action-btn.primary {
  color: #ffffff;
  background: var(--primary);
}

.action-btn.primary:active {
  opacity: 0.88;
}

.action-btn.ghost {
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
}

.action-btn.ghost:active {
  background: rgba(0, 0, 0, 0.03);
}

.action-btn.ghost-danger {
  color: var(--danger);
  border: 2rpx solid rgba(255, 77, 79, 0.45);
}

.action-btn.ghost-danger:active {
  background: rgba(255, 77, 79, 0.06);
}

.action-btn.disabled {
  color: var(--text-muted);
  border-color: var(--border);
  opacity: 0.6;
}

/* ==================== 分工弹窗 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  box-sizing: border-box;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 18, 24, 0.55);
}

.modal-card {
  position: relative;
  width: 100%;
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--mg-color-border);
}

.modal-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  font-size: 34rpx;
  line-height: 1;
  color: var(--text-muted);
  background: #f2f3f6;
}

.modal-body {
  padding: 28rpx 32rpx 8rpx;
}

.modal-label {
  margin-bottom: 16rpx;
  font-size: var(--mg-font-label);
  color: var(--text-secondary);
}

.modal-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  font-size: var(--mg-font-body);
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--mg-color-bg-page);
  box-sizing: border-box;
}

.modal-count {
  margin-top: 10rpx;
  font-size: var(--mg-font-caption);
  text-align: right;
  color: var(--text-muted);
}

.modal-foot {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 30rpx;
}

.action-dock { z-index: 200; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: var(--mg-color-bg-surface); }
