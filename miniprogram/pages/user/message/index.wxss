@import "/styles/data-pages.wxss";
/* 消息页使用连续白底列表；不复用卡片类，避免公共卡片规则覆盖密度。 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 0;
  background: var(--mg-color-bg-surface);
  overflow: hidden;
}

.msg-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  column-gap: 8px;
  min-height: 56px;
  padding: 0 32rpx;
  border-bottom: 1px solid var(--mg-color-border);
}
.toolbar-info, .toolbar-actions {
  display: flex;
  align-items: center;
  height: 48px;
}
.toolbar-info {
  min-width: 0;
  flex-shrink: 0;
  white-space: nowrap;
  column-gap: 16rpx;
  font-size: var(--mg-font-caption);
  line-height: var(--mg-line-caption);
  color: var(--mg-color-text-muted);
}
.info-unread { color: var(--mg-color-text-secondary); }
.toolbar-actions { flex-shrink: 0; gap: 8px; margin-left: auto; }
/* 覆盖微信 button[size=mini] 的内置 display、行高和内边距。 */
.msg-toolbar .msg-action[size="mini"] {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto;
  min-width: 48px;
  min-height: 48px;
  height: 48px;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--mg-color-text-secondary);
  font-size: var(--mg-font-label);
  line-height: var(--mg-line-label);
  white-space: nowrap;
}
.msg-action::after, .detail-close::after { border: 0; }
.msg-trash-icon { width: 20px; height: 20px; display: block; }
.mg-data-page .msg-action[disabled] {
  background: transparent;
  color: var(--mg-color-text-muted);
  opacity: 0.55;
}
.msg-action--press, .msg-row--press, .detail-close.detail-close--press {
  background: var(--mg-color-bg-subtle);
}
.scroll-content { flex: 1; min-height: 0; height: 0; }
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 48rpx 64rpx;
  text-align: center;
}
.empty-title {
  color: var(--mg-color-text-primary);
  font-size: var(--mg-font-section);
  line-height: var(--mg-line-section);
  font-weight: 600;
}
.empty-desc {
  margin-top: 16rpx;
  color: var(--mg-color-text-muted);
  font-size: var(--mg-font-label);
  line-height: var(--mg-line-label);
}

/* 两行信息，左右同一基线；未读只用灰点和字重表达。 */
.msg-list { padding: 0 32rpx; }
.msg-row {
  display: flex;
  align-items: flex-start;
  min-height: 48px;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--mg-color-border);
}
.msg-row:last-child { border-bottom: 0; }
.msg-dot-slot {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  width: 24rpx;
  height: var(--mg-line-body);
}
.msg-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--mg-color-text-secondary);
}
.is-read .msg-dot { visibility: hidden; }
.msg-main { flex: 1; min-width: 0; }
.msg-head { display: flex; align-items: center; min-width: 0; gap: 16rpx; }
.msg-subject {
  flex: 1;
  min-width: 0;
  font-size: var(--mg-font-body);
  line-height: var(--mg-line-body);
  font-weight: 600;
  color: var(--mg-color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.is-read .msg-subject { font-weight: 400; }
.msg-time {
  flex-shrink: 0;
  font-size: var(--mg-font-caption);
  line-height: var(--mg-line-caption);
  color: var(--mg-color-text-muted);
  white-space: nowrap;
}
.msg-preview {
  margin-top: 4rpx;
  font-size: var(--mg-font-label);
  line-height: var(--mg-line-label);
  color: var(--mg-color-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 详情保留完整正文、分类和时间，采用相同的中性色。 */
.msg-detail-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  background: var(--mg-color-scrim);
}
.msg-detail-modal {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 80vh;
  border-radius: var(--mg-radius-modal);
  background: var(--mg-color-bg-surface);
  overflow: hidden;
}
.detail-head {
  position: relative;
  flex-shrink: 0;
  padding: 32rpx;
  padding-right: calc(48px + 32rpx);
  border-bottom: 1px solid var(--mg-color-border);
}
.detail-head-main { min-width: 0; }
.detail-title {
  display: block;
  font-size: var(--mg-font-section);
  line-height: var(--mg-line-section);
  font-weight: 600;
  color: var(--mg-color-text-primary);
  word-break: break-word;
}
.detail-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
  color: var(--mg-color-text-muted);
  font-size: var(--mg-font-caption);
  line-height: var(--mg-line-caption);
}
.detail-body { min-height: 0; max-height: 46vh; padding: 24rpx 32rpx 0; }
.detail-content {
  display: block;
  font-size: var(--mg-font-body);
  line-height: var(--mg-line-body);
  color: var(--mg-color-text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}
.detail-empty { color: var(--mg-color-text-muted); font-size: var(--mg-font-label); line-height: var(--mg-line-label); }
.detail-body-bottom { height: 24rpx; }
.detail-close {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: var(--mg-radius-control);
  font-size: 24px;
  line-height: 24px;
  color: var(--mg-color-text-secondary);
  background: transparent;
}
.safe-area-bottom { padding-bottom: calc(16px + env(safe-area-inset-bottom)); }
