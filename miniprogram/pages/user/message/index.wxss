/* ============================================
   pages/user/message/index.wxss
   我的消息 - 单列卡片式消息列表
   风格：白卡 + 细边框 + 浅色类型块，状态切换用 CSS 过渡保证平滑
   ============================================ */

/* ---- 页面骨架：工具条固定，下方滚动 ---- */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-page);
  overflow: hidden;
}

/* ==================== 顶部工具条 ==================== */
.msg-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 12rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.toolbar-info {
  display: flex;
  align-items: center;
  min-width: 0;
}

.info-total {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.info-unread {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 205, 0.06);
}

.info-unread-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--primary);
}

.info-unread-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary);
}

.toolbar-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.toolbar-btn {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary);
  padding: 10rpx 6rpx;
  border-radius: 8rpx;
  transition: opacity 0.15s ease;
}

.toolbar-btn.is-disabled {
  color: #c3c8d0;
}

.toolbar-btn--hover {
  opacity: 0.65;
}

.toolbar-btn--danger {
  color: var(--danger);
}

.toolbar-btn--hover-danger {
  opacity: 0.65;
}

.toolbar-sep {
  width: 1rpx;
  height: 28rpx;
  margin: 0 22rpx;
  background: #e4e6eb;
}

/* ==================== 滚动区域 ==================== */
.scroll-content {
  flex: 1;
  min-height: 0;
}

/* ---- 加载中 ---- */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 240rpx 0;
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 68vh;
  padding: 60rpx 88rpx;
  box-sizing: border-box;
  animation: msg-fade-up 0.28s ease both;
}

.empty-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 36rpx;
  background: #f2f3f6;
  border-radius: 50%;
}

.empty-emoji {
  font-size: 84rpx;
  line-height: 1;
  opacity: 0.85;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
  text-align: center;
}

/* ==================== 消息列表 ==================== */
.msg-list {
  padding: 20rpx 24rpx 0;
  animation: msg-fade-up 0.24s ease both;
}

/* 列表/空状态出现时的轻量位移动画 */
@keyframes msg-fade-up {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---- 消息卡片 ----
   默认白底 + 极细边框；未读状态以浅蓝底区分，
   点击时整卡轻微缩放并淡化，模拟按压反馈 */
.msg-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid #f0f1f5;
  background: #ffffff;
  /* transform 快速（按压反馈），背景/边框慢速（读态过渡） */
  transition:
    transform 0.12s ease,
    opacity 0.12s ease,
    background-color 0.35s ease,
    border-color 0.35s ease;
}

.msg-card--press {
  transform: scale(0.985);
  opacity: 0.92;
}

.msg-card.is-unread {
  background: #f5f7fd;
  border-color: #e2e8f6;
}

.msg-card.is-read {
  background: #ffffff;
  border-color: #f0f1f5;
}

/* ---- 左侧类型图标（彩色浅底块） ---- */
.msg-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  border-radius: 20rpx;
  background: rgba(145, 158, 171, 0.16); /* 未知类型兜底：中性灰 */
  transition: background-color 0.35s ease, opacity 0.35s ease;
}

.msg-ico-glyph {
  font-size: 44rpx;
  line-height: 1;
  transition: opacity 0.35s ease;
}

.type-maintenance {
  background: rgba(24, 144, 255, 0.12);
}

.type-volunteer {
  background: rgba(82, 196, 26, 0.12);
}

.type-duty {
  background: rgba(250, 140, 22, 0.12);
}

.type-system {
  background: rgba(145, 158, 171, 0.16);
}

/* 已读后类型块降为中性灰，降低视觉权重 */
.msg-card.is-read .msg-ico {
  background: #f0f1f4;
}

.msg-card.is-read .msg-ico-glyph {
  opacity: 0.5;
}

/* ---- 右侧主体 ---- */
.msg-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.msg-head {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 未读圆点：占用固定宽度，保证所有卡片标题对齐；
   已读时圆点淡出缩小，过渡平滑不跳动 */
.msg-dot-slot {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  width: 22rpx;
  height: 44rpx;
  margin-right: 4rpx;
}

.msg-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 5rpx rgba(0, 0, 205, 0.08);
  transition: opacity 0.35s ease, transform 0.35s ease;
}

.msg-card.is-read .msg-dot {
  opacity: 0;
  transform: scale(0.3);
}

.msg-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  transition: color 0.35s ease;
}

.msg-card.is-read .msg-title {
  font-weight: 500;
  color: var(--text-secondary);
}

.msg-time {
  flex-shrink: 0;
  margin-left: 18rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #9aa1ab;
  transition: color 0.35s ease;
}

.msg-card.is-read .msg-time {
  color: #b9bfc7;
}

/* ---- 内容摘要（最多两行） ---- */
.msg-preview {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-word;
  transition: color 0.35s ease;
}

.msg-card.is-read .msg-preview {
  color: #9aa1ab;
}

/* ==================== 底部安全区域 ==================== */
.safe-area-bottom {
  height: 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}
