<scroll-view class="unified-page-scroll" scroll-y enhanced enable-back-to-top scroll-top="{{unifiedScrollTop}}" scroll-with-animation refresher-enabled refresher-default-style="none" refresher-triggered="{{unifiedRefreshing}}" bindrefresherrefresh="onUnifiedRefresh" bindscroll="onUnifiedScroll" bindscrolltolower="onUnifiedBottom" lower-threshold="50">
<view slot="refresher" class="unified-refresher"><loading-animation wx:if="{{unifiedRefreshing}}" size="small" /></view>
<!--pages/user/message/index.wxml-->
<view class="mg-theme mg-data-page page-container">
  <view class="mg-page-notice mg-page-notice--error" wx:if="{{loadError}}">{{loadError}}<button class="mg-button mg-button--secondary" bindtap="loadMessages">重新加载</button></view>
  <!-- 顶部工具条：消息概览 + 批量操作（无消息时不显示） -->
  <view class="msg-toolbar" wx:if="{{!isEmpty}}">
    <view class="toolbar-info">
      <text class="info-total">共 {{messageNumber}} 条</text>
      <text class="info-unread" wx:if="{{unreadCount > 0}}">{{unreadCount}} 未读</text>
    </view>
    <view class="toolbar-actions">
      <button
        class="msg-action"
        size="mini"
        disabled="{{unreadCount === 0}}"
        hover-class="msg-action--press"
        hover-stay-time="60"
        bindtap="markAllAsRead"
      >全部已读</button>
      <button
        class="msg-action"
        size="mini"
        hover-class="msg-action--press"
        hover-stay-time="60"
        bindtap="clearAllMessages"
        aria-label="清空全部消息"
      ><image class="msg-trash-icon" src="/assets/icons/trash.svg" mode="aspectFit" aria-hidden="true" /></button>
    </view>
  </view>

  <!-- 可滚动内容区域 -->
  <scroll-view class="scroll-content" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{isLoading}}">
      <loading-animation size="default"></loading-animation>
    </view>

    <!-- 无消息 -->
    <view class="empty-state" wx:if="{{isEmpty && !isLoading && !loadError}}">
      <text class="empty-title">暂无消息</text>
      <text class="empty-desc">报修进度、值班安排、志愿活动等通知都会显示在这里</text>
    </view>

    <!-- 消息列表 -->
    <view class="msg-list" wx:if="{{!isEmpty && !isLoading && !loadError}}">
      <view
        class="msg-row {{item.isRead ? 'is-read' : 'is-unread'}}"
        wx:for="{{messages}}"
        wx:key="index"
        data-index="{{index}}"
        hover-class="msg-row--press"
        hover-stay-time="60"
        bindtap="openMessageDetail"
        role="button"
        aria-label="{{item.isRead ? '已读' : '未读'}}，{{item.title}}，{{item.timeDisplay}}，查看完整消息"
      >
        <view class="msg-dot-slot" aria-hidden="true"><view class="msg-dot"></view></view>
        <view class="msg-main">
          <view class="msg-head">
            <text class="msg-subject">{{item.title}}</text>
            <text class="msg-time" wx:if="{{item.timeDisplay}}">{{item.timeDisplay}}</text>
          </view>
          <view class="msg-preview">{{item.content}}</view>
        </view>

      </view>
    </view>

    <!-- 底部安全区域 -->
    <view class="safe-area-bottom"></view>
  </scroll-view>

  <!-- ==================== 消息详情浮窗 ==================== -->
  <view
    class="msg-detail-mask"
    wx:if="{{showDetail}}"
    bindtap="closeMessageDetail"
    catchtouchmove="noop"
  >
    <view class="msg-detail-modal" catchtap="noop">
      <!-- 头部：标题 + 类型/完整时间 -->
      <view class="detail-head">
        <button class="detail-close" size="mini" aria-label="关闭消息详情" hover-class="detail-close--press" bindtap="closeMessageDetail">×</button>
        <view class="detail-head-main">
          <text class="detail-title">{{detailMessage.title}}</text>
          <view class="detail-meta">
            <text class="detail-tag">{{detailMessage.typeText}}</text>
            <text class="detail-time">{{detailMessage.timeText}}</text>
          </view>
        </view>
      </view>

      <!-- 正文：长内容可滚动 -->
      <scroll-view
        class="detail-body"
        scroll-y="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
      >
        <text
          class="detail-content"
          wx:if="{{detailMessage.content}}"
          decode="{{true}}"
          user-select="{{true}}"
        >{{detailMessage.content}}</text>
        <view class="detail-empty" wx:else>该消息暂无更多内容</view>
        <view class="detail-body-bottom"></view>
      </scroll-view>

    </view>
  </view>
</view>
</scroll-view>
<loading-overlay id="global-loading" />
