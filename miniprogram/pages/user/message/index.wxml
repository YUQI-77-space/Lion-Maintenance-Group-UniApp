<!--pages/user/message/index.wxml-->
<view class="mg-theme mg-data-page page-container">
  <view class="mg-page-notice mg-page-notice--error" wx:if="{{loadError}}">{{loadError}}<button class="mg-button mg-button--secondary" bindtap="loadMessages">重新加载</button></view>
  <!-- 顶部工具条：消息概览 + 批量操作（无消息时不显示） -->
  <view class="msg-toolbar" wx:if="{{!isEmpty}}">
    <view class="toolbar-info">
      <text class="info-total">共 {{messageNumber}} 条</text>
      <view class="info-unread" wx:if="{{unreadCount > 0}}">
        <view class="info-unread-dot"></view>
        <text class="info-unread-text">{{unreadCount}} 条未读</text>
      </view>
    </view>
    <view class="toolbar-actions">
      <view
        class="toolbar-btn {{unreadCount > 0 ? '' : 'is-disabled'}}"
        hover-class="toolbar-btn--hover"
        hover-stay-time="60"
        bindtap="markAllAsRead"
      >全部已读</view>
      <view class="toolbar-sep"></view>
      <view
        class="toolbar-btn toolbar-btn--danger"
        hover-class="toolbar-btn--hover-danger"
        hover-stay-time="60"
        bindtap="clearAllMessages"
      >清空</view>
    </view>
  </view>

  <!-- 可滚动内容区域 -->
  <scroll-view class="scroll-content" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{isLoading}}">
      <loading-animation size="default"></loading-animation>
    </view>

    <!-- 无消息 -->
    <view class="empty-state" wx:if="{{isEmpty && !isLoading && !loadError}}">
      <view class="empty-ico">
        <text class="empty-emoji">消息</text>
      </view>
      <text class="empty-title">暂无消息</text>
      <text class="empty-desc">报修进度、值班安排、志愿活动等通知都会显示在这里</text>
    </view>

    <!-- 消息列表 -->
    <view class="msg-list" wx:if="{{!isEmpty && !isLoading && !loadError}}">
      <view
        class="msg-card {{item.isRead ? 'is-read' : 'is-unread'}}"
        wx:for="{{messages}}"
        wx:key="index"
        data-index="{{index}}"
        hover-class="msg-card--press"
        hover-stay-time="60"
        bindtap="openMessageDetail"
      >
        <!-- 左侧：消息类型图标 -->
        <view class="msg-ico type-{{item.messagetype}}">
          <text class="msg-ico-glyph">{{item.typeIcon}}</text>
        </view>

        <!-- 右侧：标题 / 摘要 -->
        <view class="msg-main">
          <view class="msg-head">
            <view class="msg-dot-slot">
              <view class="msg-dot"></view>
            </view>
            <text class="msg-title">{{item.title}}</text>
            <text class="msg-time" wx:if="{{item.timeDisplay}}">{{item.timeDisplay}}</text>
          </view>
          <view class="msg-preview">{{item.content}}</view>
        </view>

        <!-- 右侧：可点击提示箭头 -->
        <text class="msg-arrow">›</text>
      </view>
    </view>

    <!-- 底部安全区域 -->
    <view class="safe-area-bottom"></view>
  </scroll-view>

  <!-- ==================== 消息详情浮窗 ==================== -->
  <view
    class="msg-detail-mask"
    wx:if="{{showDetail}}"
    bindtap="closeMessageDetail"
    catchtouchmove="noop"
  >
    <view class="msg-detail-modal" catchtap="noop">
      <!-- 头部：类型图标 + 标题 + 类型/时间 -->
      <view class="detail-head">
        <view class="detail-ico type-{{detailMessage.messagetype}}">
          <text class="detail-ico-glyph">{{detailMessage.typeIcon}}</text>
        </view>
        <view class="detail-head-main">
          <text class="detail-title">{{detailMessage.title}}</text>
          <view class="detail-meta">
            <text class="detail-tag tag-{{detailMessage.messagetype}}">{{detailMessage.typeText}}</text>
            <text class="detail-time">{{detailMessage.timeText}}</text>
          </view>
        </view>
      </view>

      <!-- 正文：长内容可滚动 -->
      <scroll-view
        class="detail-body"
        scroll-y="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
      >
        <text
          class="detail-content"
          wx:if="{{detailMessage.content}}"
          decode="{{true}}"
          user-select="{{true}}"
        >{{detailMessage.content}}</text>
        <view class="detail-empty" wx:else>该消息暂无更多内容</view>
        <view class="detail-body-bottom"></view>
      </scroll-view>

      <!-- 底部：关闭 -->
      <view class="detail-footer">
        <view
          class="detail-btn"
          hover-class="detail-btn--hover"
          hover-stay-time="60"
          bindtap="closeMessageDetail"
        >关闭</view>
      </view>
    </view>
  </view>
</view>
