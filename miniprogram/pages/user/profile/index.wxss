@import "/styles/variables.wxss";
@import "/styles/custom-navbar.wxss";
page { background: var(--mg-color-bg-page); }
.profile-page { min-height: 100vh; }
.profile-header { margin: 32rpx; padding: 32rpx; background: var(--mg-color-bg-surface); border-radius: var(--mg-radius-card); }
.header-user { display: flex; align-items: center; gap: 24rpx; }
.user-meta { flex: 1; min-width: 0; }
.nickname { font-size: var(--mg-font-title); font-weight: 600; overflow-wrap: break-word; }
.role-tag { display: inline-block; margin-top: 12rpx; padding: 8rpx 16rpx; color: var(--mg-color-info); background: var(--mg-color-info-soft); border-radius: 8rpx; font-size: 24rpx; }
.header-department { margin-top: 24rpx; }
.picker-content { min-height: 48px; display: flex; align-items: center; justify-content: space-between; padding: 16rpx; border: 1px solid var(--mg-color-control-border); border-radius: 16rpx; }
.picker-arrow, .item-arrow { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.profile-content { padding: 0 32rpx; }
.function-list { background: var(--mg-color-bg-surface); border-radius: 24rpx; overflow: hidden; }
.function-item { display: flex; align-items: center; gap: 24rpx; padding: 32rpx 24rpx; min-height: 48px; border-bottom: 1px solid var(--mg-color-border); }
.function-item:last-child { border-bottom: 0; }
.item-icon { width: 48rpx; height: 48rpx; flex-shrink: 0; }
.item-content { flex: 1; min-width: 0; }
.item-title { font-size: 15px; font-size: max(15px, 30rpx); font-weight: 500; }
.item-desc { color: var(--mg-color-text-muted); font-size: 24rpx; margin-top: 8rpx; }
.item-badge { padding: 4rpx 12rpx; border-radius: 999rpx; color: var(--mg-color-danger); background: var(--mg-color-danger-soft); font-size: 24rpx; flex-shrink: 0; }
.logout-button { margin: 32rpx; width: auto; min-height: 48px; font-size: 15px; color: var(--mg-color-text-secondary); background: var(--mg-color-bg-surface); border: 1px solid var(--mg-color-control-border); border-radius: 16rpx; }
.department-feedback { margin-top: 16rpx; color: var(--mg-color-text-secondary); font-size: 24rpx; }

.logout-button { display: block; width: calc(100% - 64rpx); }
