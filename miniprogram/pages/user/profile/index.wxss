@import "/styles/variables.wxss";
@import "/styles/custom-navbar.wxss";
page { background: var(--mg-color-bg-page); }
.profile-page { min-height: 100vh; }
.profile-header { position: relative; display: flex; align-items: center; box-sizing: border-box; min-height: 480rpx; margin: 32rpx 32rpx 48rpx; padding: 48rpx 64rpx; overflow: hidden; background: var(--mg-color-bg-surface); border-radius: var(--mg-radius-card); }
/* 背景独立于内容与点击区域；图片不可用时保留白色卡片底面。 */
.profile-background { position: absolute; z-index: 0; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.header-user { z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 24rpx; box-sizing: border-box; width: 100%; text-align: center; }
.avatar-container { width: 200rpx; flex-shrink: 0; }
.user-meta { display: flex; flex-direction: column; align-items: center; gap: 8rpx; width: 100%; min-width: 0; }
.nickname { max-width: 100%; font-size: var(--mg-font-section); line-height: var(--mg-line-section); font-weight: 600; overflow-wrap: break-word; }
.role-tag {
  display: inline-flex; align-items: center; justify-content: center; align-self: center; vertical-align: middle; max-width: 100%; box-sizing: border-box; padding: 8rpx 16rpx; color: var(--mg-color-info); background: var(--mg-color-info-soft); border-radius: 8rpx; font-size: var(--mg-font-caption); overflow-wrap: break-word; }
.item-arrow { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.profile-content { padding: 0 32rpx; }
.function-list { background: var(--mg-color-bg-surface); border-radius: 24rpx; overflow: hidden; }
.function-item { display: flex; align-items: center; gap: 24rpx; padding: 32rpx 24rpx; min-height: 48px; border-bottom: 1px solid var(--mg-color-border); }
.function-item:last-child { border-bottom: 0; }
.item-icon { width: 48rpx; height: 48rpx; flex-shrink: 0; }
.item-content { flex: 1; min-width: 0; }
.item-title { font-size: var(--mg-font-body); font-weight: 500; }
.item-desc { color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); margin-top: 8rpx; }
/* 固定原生迷你按钮的热区，右上角图标不挤压姓名与角色。 */
.header-user .logout-button { position: absolute; top: 16rpx; right: 16rpx; display: flex; box-sizing: border-box; align-items: center; justify-content: center; width: 48px; min-width: 48px; height: 48px; min-height: 48px; margin: 0; padding: 8rpx; color: var(--mg-color-danger); background: transparent; border: 0; border-radius: var(--mg-radius-control); }
.logout-button::after { border: 0; }
.logout-icon { width: var(--mg-size-icon-md); height: var(--mg-size-icon-md); flex-shrink: 0; }
.logout-button.logout-pressed { background: var(--mg-color-danger-soft); }
.department-feedback { margin-top: 16rpx; color: var(--mg-color-text-secondary); font-size: var(--mg-font-caption); }

/* 保留角色标签外观，由原生 picker 提供部门选择与点击区域。 */
.role-picker { display: flex; align-items: center; justify-content: center; max-width: 100%; min-height: 48px; min-width: 48px; }
.role-picker:active { opacity: 0.7; }
