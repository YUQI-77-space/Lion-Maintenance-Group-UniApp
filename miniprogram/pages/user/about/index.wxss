/* pages/user/about/index.wxss
   关于我们 - 品牌头部 + 白卡信息块
   与「我的消息」「待办详情」共用同一套版式语言 */
@import "/styles/variables.wxss";

.page {
  min-height: 100vh;
  padding: 24rpx;
  background: var(--bg-page);
  box-sizing: border-box;
}

/* ==================== 品牌头部 ==================== */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 36rpx;
}

.hero-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
}

.hero-name {
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  color: var(--text-primary);
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
  color: var(--text-secondary);
}

.hero-slogan {
  margin-top: 24rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--primary);
  background: rgba(0, 0, 205, 0.06);
}

/* ==================== 卡片 ==================== */
.card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border: 1rpx solid #f0f1f5;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.card:last-child {
  margin-bottom: 0;
}

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

/* ==================== 正文段落 ==================== */
.para {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-secondary);
  text-align: justify;
}

.para + .para {
  margin-top: 18rpx;
}

/* ==================== 服务清单 ==================== */
.service-list {
  margin-top: 6rpx;
}

.service-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
}

.service-item + .service-item {
  border-top: 1rpx solid #f0f1f5;
}

.service-index {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin: 4rpx 16rpx 0 0;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
  color: var(--primary);
  background: rgba(0, 0, 205, 0.06);
}

.service-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.hint-line {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted);
}

/* ==================== 可复制信息 ==================== */
.copy-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.copy-row:active {
  background: #f1f2f6;
}

.copy-row-main {
  flex: 1;
  min-width: 0;
}

.copy-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.copy-value {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--primary);
}

.copy-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(0, 0, 205, 0.35);
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--primary);
}

/* ==================== 联系方式 ==================== */
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid #f0f1f5;
}

.info-row:active {
  opacity: 0.7;
}

.info-main {
  flex: 1;
  min-width: 0;
}

.info-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.info-value {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-primary);
  word-break: break-all;
}

/* ==================== 页脚 ==================== */
.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 40rpx;
}

.footer-line {
  font-size: 22rpx;
  line-height: 1.8;
  text-align: center;
  color: var(--text-muted);
}
