/* pages/team/home/index.wxss */
@import "/styles/variables.wxss";
@import "/styles/custom-navbar.wxss";

/* 禁用页面滚动，固定高度 */
page { background: var(--mg-color-bg-page); }

.container {
  position: relative;
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 72px; /* 为底部导航栏预留空间 */
  box-sizing: border-box;

}

.header {
  margin-bottom: 30rpx;
}

/* 移除原来的标题，因为已在导航栏显示 */
/* .title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: 600;
  color: var(--text-main);
} */

.subtitle {
  font-size: var(--mg-font-label);
  color: var(--text-secondary);
  margin-top: 10rpx;
}

.section {
  margin-bottom: 40rpx;
  background-color: var(--card-background);
  border-radius: var(--border-radius-large);
  padding: 30rpx;
  box-shadow: var(--box-shadow);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1px solid var(--border-light);
}

.section-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: 600;
}

.function-grid {
  display: flex;
  flex-wrap: wrap;
}

.function-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.function-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.function-name {
  font-size: var(--mg-font-label);
  line-height: var(--mg-line-label);
  color: var(--text-main);
}

.function-item { min-height: 48px; min-width: 0; padding: 24rpx 8rpx; }
.function-name { text-align: center; overflow-wrap: break-word; }
