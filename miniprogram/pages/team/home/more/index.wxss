/* 阶段 1：页面局部 Token；不改变共享样式。 */
.tools-page {
  --mg-color-brand: #0369D7;
  --mg-color-brand-pressed: #035CBD;
  --mg-color-brand-soft: #F2F8FD;
  --mg-color-brand-selected: #E6F0FB;
  --mg-color-brand-strong: #0250A3;
  --mg-color-bg-page: #F5F7FA;
  --mg-color-bg-surface: #FFFFFF;
  --mg-color-bg-subtle: #EEF1F5;
  --mg-color-text-primary: #182230;
  --mg-color-text-secondary: #475467;
  --mg-color-text-muted: #626D80;
  --mg-color-border: #DCE2EA;
  --mg-color-control-border: #7A8798;

  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: var(--mg-color-bg-page);
  color: var(--mg-color-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 15px;
  font-size: max(15px, 30rpx);
  line-height: 1.6;
}


.tools-page .tools-header { padding: 16rpx 0 32rpx; }
.tools-page .eyebrow { color: var(--mg-color-brand-strong); font-size: 24rpx; line-height: 36rpx; margin-bottom: 16rpx; }
.tools-page .page-title { font-size: 40rpx; line-height: 56rpx; font-weight: 600; }
.tools-page .page-description { margin-top: 16rpx; color: var(--mg-color-text-secondary); }
.tools-page .search-container { margin-bottom: 32rpx; }
.tools-page .search-label { display: block; font-size: 28rpx; line-height: 40rpx; color: var(--mg-color-text-secondary); margin-bottom: 12rpx; }
.tools-page .search-box { display: flex; align-items: center; min-height: 48px; padding: 0 24rpx; border: 1px solid var(--mg-color-control-border); border-radius: 16rpx; background: var(--mg-color-bg-surface); }
.tools-page .search-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-right: 16rpx; }
.tools-page .search-input { min-width: 0; flex: 1; min-height: 48px; font-size: 15px; font-size: max(15px, 30rpx); color: var(--mg-color-text-primary); }
.tools-page .search-placeholder { color: var(--mg-color-text-muted); }
.tools-page .clear-btn { min-width: 48px; min-height: 48px; margin: 0 0 0 16rpx; padding: 0; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 8rpx; color: var(--mg-color-brand); background: var(--mg-color-bg-surface); font-size: 28rpx; line-height: 40rpx; }
.tools-page .function-grid { display: flex; flex-direction: column; gap: 16rpx; }
.tools-page .function-item { display: flex; align-items: center; min-height: 48px; width: 100%; margin: 0; padding: 24rpx; border: 0; border-radius: 24rpx; text-align: left; background: var(--mg-color-bg-surface); color: var(--mg-color-text-primary); }
.tools-page .function-icon-wrap { display: flex; align-items: center; justify-content: center; width: 80rpx; height: 80rpx; background: var(--mg-color-brand-soft); border-radius: 16rpx; flex-shrink: 0; }
.tools-page .function-icon { width: 48rpx; height: 48rpx; }
.tools-page .function-name { flex: 1; min-width: 0; margin: 0 24rpx; font-size: 15px; font-size: max(15px, 30rpx); line-height: 1.6; font-weight: 500; overflow-wrap: break-word; }
.tools-page .entry-arrow { flex-shrink: 0; width: 16rpx; height: 16rpx; border-top: 2px solid var(--mg-color-text-muted); border-right: 2px solid var(--mg-color-text-muted); transform: rotate(45deg); margin-right: 8rpx; }
.tools-page .function-item::after, .tools-page .clear-btn::after, .tools-page .reset-search-btn::after { border: 0; }
.tools-page .item-pressed, .tools-page .control-pressed { background: var(--mg-color-brand-selected); }
.tools-page .empty-state { padding: 48rpx 32rpx; border-radius: 24rpx; background: var(--mg-color-bg-surface); text-align: center; }
.tools-page .empty-title { font-size: 34rpx; line-height: 48rpx; font-weight: 600; }
.tools-page .empty-description { margin-top: 16rpx; color: var(--mg-color-text-secondary); }
.tools-page .reset-search-btn { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 48px; margin: 32rpx 0 0; padding: 16rpx 24rpx; border: 0; border-radius: 16rpx; font-size: 15px; font-size: max(15px, 30rpx); line-height: 1.6; color: #FFFFFF; background: var(--mg-color-brand); }
.tools-page .primary-pressed { background: var(--mg-color-brand-pressed); }
