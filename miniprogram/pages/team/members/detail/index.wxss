@import "../shared.wxss";
.remove-person { margin: 0 32rpx 20rpx; padding: 24rpx; background: #f4f6fa; border-radius: 16rpx; font-size: 30rpx; font-weight: 600; word-break: break-all; }
.remove-role { margin-left: 16rpx; font-size: 24rpx; font-weight: 400; color: #788398; }
.modal-description { margin: 0 32rpx 24rpx; font-size: 26rpx; color: #788398; line-height: 1.7; }
.reason-label { margin: 24rpx 32rpx 16rpx; color: #354157; font-size: 26rpx; font-weight: 500; }
.required-mark { color: #d94343; }
.remove-reason { width: calc(100% - 64rpx); height: 180rpx; box-sizing: border-box; margin: 0 32rpx; padding: 24rpx; background: #f4f6fa; border: 1rpx solid #e5eaf2; border-radius: 16rpx; font-size: 28rpx; line-height: 1.6; }
.reason-count { margin: 12rpx 32rpx 0; text-align: right; font-size: 22rpx; color: #8893a5; }
.remove-warning { margin: 0 32rpx; background: #fff3ed; color: #aa5e32; border-radius: 16rpx; padding: 24rpx; font-size: 26rpx; line-height: 1.7; }
.reason-preview { margin: 0 32rpx; color: #354157; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.modal-blockers { margin-top: 24rpx; }
.modal-blocker { margin: 0 32rpx; padding: 16rpx 0; font-size: 25rpx; line-height: 1.6; border-bottom: 1rpx solid #edf0f5; color: #4b5870; }
action-modal .member-error { margin: 20rpx 32rpx 0; }

.edit-section { padding: 0 32rpx 24rpx; }
.edit-field { margin-top: 28rpx; font-size: 26rpx; color: #4b5870; }
.edit-input { margin-top: 16rpx; width: 100%; box-sizing: border-box; height: 88rpx; padding: 0 24rpx; background: #f5f7fb; border: 1rpx solid #e8edf5; border-radius: 14rpx; font-size: 30rpx; color: #202b40; }
.department-picker { margin-top: 16rpx; min-height: 88rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid #e8edf5; border-radius: 14rpx; background: #f5f7fb; color: #202b40; font-size: 28rpx; }
.picker-placeholder { color: #8893a5; }
.field-help { margin-top: 12rpx; color: #8893a5; font-size: 23rpx; line-height: 1.7; }
.emergency-setting { display: flex; align-items: center; gap: 20rpx; border-top: 1rpx solid #edf0f5; margin-top: 32rpx; padding-top: 28rpx; }
.emergency-copy { flex: 1; font-size: 28rpx; }
.emergency-setting switch { flex-shrink: 0; }
