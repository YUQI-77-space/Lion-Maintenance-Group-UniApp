@import "/styles/data-pages.wxss";
@import "../shared.wxss";
.employment-setting { padding: 0 32rpx 24rpx; }
.employment-label { display: block; font-size: var(--mg-font-label); color: var(--mg-color-text-secondary); }
.retired-badge { background: var(--mg-color-bg-subtle); color: var(--mg-color-text-secondary); }
.modal-description { margin: 0 32rpx 24rpx; font-size: var(--mg-font-label); color: var(--mg-color-text-muted); line-height: 1.7; }
.modal-blockers { margin-top: 24rpx; }
.modal-blocker { margin: 0 32rpx; padding: 16rpx 0; font-size: var(--mg-font-label); line-height: 1.6; border-bottom: 1rpx solid var(--mg-color-bg-subtle); color: var(--mg-color-text-secondary); }
action-modal .member-error { margin: 20rpx 32rpx 0; }

.edit-section { padding: 0 32rpx 24rpx; }
.edit-field { margin-top: 28rpx; font-size: var(--mg-font-label); color: var(--mg-color-text-secondary); }
.edit-input { margin-top: 16rpx; width: 100%; box-sizing: border-box; height: 88rpx; padding: 0 24rpx; background: var(--mg-color-bg-page); border: 1rpx solid var(--mg-color-border); border-radius: 14rpx; font-size: var(--mg-font-body); color: var(--mg-color-text-primary); }
.department-picker { margin-top: 16rpx; min-height: 88rpx; padding: 20rpx 24rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid var(--mg-color-border); border-radius: 14rpx; background: var(--mg-color-bg-page); color: var(--mg-color-text-primary); font-size: var(--mg-font-body); }
.picker-placeholder { color: var(--mg-color-text-muted); }
.field-help { margin-top: 12rpx; color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); line-height: 1.7; }
.emergency-setting { display: flex; align-items: center; gap: 20rpx; border-top: 1rpx solid var(--mg-color-bg-subtle); margin-top: 32rpx; padding-top: 28rpx; }
.emergency-copy { flex: 1; font-size: var(--mg-font-body); }
.emergency-setting switch { flex-shrink: 0; }
