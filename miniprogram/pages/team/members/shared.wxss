page { background: #f4f6fa; color: #202b40; }
.members-page { padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.member-card { padding: 32rpx; margin-bottom: 24rpx; background: #fff; border: 1rpx solid #edf0f5; border-radius: 24rpx; }
.member-profile { display: flex; align-items: center; gap: 28rpx; padding: 36rpx 32rpx; }
.member-identity { flex: 1; min-width: 0; }
.member-name { font-size: 38rpx; line-height: 1.4; font-weight: 600; word-break: break-all; }
.member-badges { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.member-badge { display: inline-block; padding: 6rpx 16rpx; background: #edf3ff; color: #3569dc; border: 0; border-radius: 8rpx; font-size: 22rpx; line-height: 1.5; }
.contact-badge { background: #eaf8f3; color: #238164; }
.member-caption { color: #7c879a; font-size: 26rpx; line-height: 1.5; }
.member-section-title { font-size: 30rpx; font-weight: 600; line-height: 1.5; margin-bottom: 16rpx; }
.member-info-row { display: flex; align-items: center; justify-content: space-between; min-height: 94rpx; gap: 28rpx; font-size: 28rpx; border-bottom: 1rpx solid #f0f2f6; }
.member-label { flex-shrink: 0; color: #788398; }
.member-value { text-align: right; word-break: break-all; line-height: 1.6; padding: 18rpx 0; }
.last-row { border-bottom: 0; }
.member-button { width: 100%; height: 96rpx; min-height: 96rpx; margin: 0; padding: 0 24rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 500; line-height: 1.4; border-radius: 18rpx; }
.member-button::after, .member-action::after { border: none; }
.member-primary { color: #fff; background: #3a75fb; }
.member-secondary { background: #e9effa; color: #3569dc; }
.member-button[disabled] { background: #e2e7f0; color: #94a0b3; }
.member-actions { margin-top: 24rpx; padding: 28rpx 32rpx 0; }
.member-actions .member-section-title { margin-bottom: 0; }
/* 覆盖微信普通按钮的默认宽度、内边距与居中规则。 */
.members-page button.member-button:not([size='mini']),
.members-page button.member-action:not([size='mini']) { width: 100%; max-width: none; margin-left: 0; margin-right: 0; }
.members-page button.member-action:not([size='mini']) { padding: 24rpx 0; text-align: left; }
.member-action { width: 100%; min-height: 124rpx; height: auto; margin: 0; padding: 26rpx 0; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; background: #fff; color: #202b40; border-radius: 0; border-bottom: 1rpx solid #f0f2f6; line-height: 1.5; text-align: left; }
.member-action:last-child { border-bottom: 0; }
.action-copy { flex: 1; min-width: 0; }
.action-title { display: block; font-size: 28rpx; }
.action-description { display: block; margin-top: 8rpx; color: #788398; font-size: 23rpx; }
.member-remove .action-title { color: #ce4141; }
.member-chevron { color: #a2adbd; font-size: 36rpx; font-weight: 400; }
.member-note { margin-top: 20rpx; color: #8893a5; font-size: 23rpx; line-height: 1.7; }
.member-state { padding: 120rpx 24rpx; text-align: center; font-size: 26rpx; color: #788398; }
.member-error { color: #c64040; background: #fff0ef; border-radius: 12rpx; padding: 20rpx 24rpx; margin: 20rpx 0; font-size: 26rpx; line-height: 1.7; }
.member-pressed { opacity: .78; }
