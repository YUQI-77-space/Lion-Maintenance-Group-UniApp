page { background: var(--mg-color-bg-page); color: var(--mg-color-text-primary); }
.members-page { padding: 28rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.member-card { padding: 32rpx; margin-bottom: 24rpx; background: #fff; border: 1rpx solid var(--mg-color-bg-subtle); border-radius: 24rpx; }
.member-profile { display: flex; align-items: center; gap: 28rpx; padding: 36rpx 32rpx; }
.member-identity { flex: 1; min-width: 0; }
.member-name { font-size: var(--mg-font-title); line-height: var(--mg-line-title); font-weight: 600; word-break: break-all; }
.member-badges { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.member-badge { display: inline-block; padding: 6rpx 16rpx; background: var(--mg-color-info-soft); color: var(--mg-color-brand); border: 0; border-radius: 8rpx; font-size: var(--mg-font-caption); line-height: 1.5; }
.contact-badge { background: var(--mg-color-success-soft); color: var(--mg-color-success); }
.member-caption { color: var(--mg-color-text-muted); font-size: var(--mg-font-label); line-height: 1.5; }
.member-section-title { font-size: var(--mg-font-section); font-weight: 600; line-height: var(--mg-line-section); margin-bottom: 16rpx; }
.member-info-row { display: flex; align-items: center; justify-content: space-between; min-height: 94rpx; gap: 28rpx; font-size: var(--mg-font-body); border-bottom: 1rpx solid var(--mg-color-border); }
.member-label { flex-shrink: 0; color: var(--mg-color-text-muted); }
.member-value { text-align: right; word-break: break-all; line-height: 1.6; padding: 18rpx 0; }
.last-row { border-bottom: 0; }
.member-button { width: 100%; height: 96rpx; min-height: 96rpx; margin: 0; padding: 0 24rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: var(--mg-font-body); font-weight: 500; line-height: 1.4; border-radius: 18rpx; }
.member-button::after, .member-action::after { border: none; }
.member-primary { color: #fff; background: var(--mg-color-brand); }
.member-secondary { background: var(--mg-color-info-soft); color: var(--mg-color-brand); }
.member-button[disabled] { background: #e2e7f0; color: #94a0b3; }
.member-actions { margin-top: 24rpx; padding: 28rpx 32rpx 0; }
.member-actions .member-section-title { margin-bottom: 0; }
/* 覆盖微信普通按钮的默认宽度、内边距与居中规则。 */
.members-page button.member-button:not([size='mini']),
.members-page button.member-action:not([size='mini']) { width: 100%; max-width: none; margin-left: 0; margin-right: 0; }
.members-page button.member-action:not([size='mini']) { padding: 24rpx 0; text-align: left; }
.member-action { width: 100%; min-height: 124rpx; height: auto; margin: 0; padding: 26rpx 0; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; background: #fff; color: var(--mg-color-text-primary); border-radius: 0; border-bottom: 1rpx solid var(--mg-color-border); line-height: 1.5; text-align: left; }
.member-action:last-child { border-bottom: 0; }
.action-copy { flex: 1; min-width: 0; }
.action-title { display: block; font-size: var(--mg-font-body); }
.action-description { display: block; margin-top: 8rpx; color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); }
.member-remove .action-title { color: var(--mg-color-danger); }
.member-chevron { color: #a2adbd; font-size: 36rpx; font-weight: 400; }
.member-note { margin-top: 20rpx; color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); line-height: 1.7; }
.member-state { padding: 120rpx 24rpx; text-align: center; font-size: var(--mg-font-label); color: var(--mg-color-text-muted); }
.member-error { color: var(--mg-color-danger); background: var(--mg-color-danger-soft); border-radius: 12rpx; padding: 20rpx 24rpx; margin: 20rpx 0; font-size: var(--mg-font-label); line-height: 1.7; }
.member-pressed { opacity: .78; }

.member-button { min-height: 48px; height: auto; padding: 16rpx 24rpx; }
.member-label, .member-caption, .member-note, .action-description { color: var(--mg-color-text-secondary); }
