@import "/styles/data-pages.wxss";
page { height: 100%; background: var(--mg-color-bg-page); color: var(--mg-color-text-primary); }
.directory-page { height: 100vh; display: flex; flex-direction: column; }
.directory-header { flex-shrink: 0; padding: 24rpx 28rpx 16rpx; background: #fff; border-bottom: 1rpx solid var(--mg-color-bg-subtle); }
.directory-count { flex-shrink: 0; margin-left: auto; color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); white-space: nowrap; }
.reset-filters::after, .directory-retry::after { border: 0; }
.directory-filters { display: flex; gap: 8px; align-items: center; margin-top: 16rpx; }
.directory-picker { flex: 0 1 auto; min-width: 48px; padding: 8px 0; }
.filter-chip { box-sizing: border-box; display: flex; align-items: center; gap: 12rpx; min-height: 32px; padding: 0 16rpx; border-radius: 14rpx; background: var(--mg-color-bg-page); color: var(--mg-color-text-muted); font-size: var(--mg-font-label); line-height: var(--mg-line-label); }
.filter-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-active { background: var(--mg-color-info-soft); color: var(--mg-color-brand); }
.filter-caret { position: relative; flex-shrink: 0; width: 12px; height: 12px; }
.filter-caret::after { content: ''; position: absolute; top: 2px; left: 3px; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }
.reset-filters { flex-shrink: 0; min-width: 48px; min-height: 48px; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; background: transparent; color: var(--mg-color-brand); font-size: var(--mg-font-label); }
.directory-list { flex: 1; height: 0; min-height: 0; }
.directory-group { background: #fff; border: 1rpx solid var(--mg-color-bg-subtle); border-radius: 24rpx; margin: 24rpx 28rpx 0; padding: 0 28rpx; overflow: hidden; }
.directory-member { display: flex; align-items: center; padding: 28rpx 0; min-height: 156rpx; border-bottom: 1rpx solid var(--mg-color-border); gap: 24rpx; }
.directory-member:last-child { border-bottom: 0; }
.directory-info { flex: 1; min-width: 0; }
.directory-name-row { display: flex; align-items: center; gap: 14rpx; }
.directory-name { font-size: var(--mg-font-body); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.directory-role { flex-shrink: 0; padding: 4rpx 12rpx; background: #f0f4fa; color: #6d7c94; border-radius: 8rpx; font-size: var(--mg-font-caption); line-height: 1.5; }
.role-leader { color: var(--mg-color-brand); background: var(--mg-color-info-soft); }
.role-admin { color: #8a62bd; background: #f3edfc; }
.directory-department { margin-top: 10rpx; color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); }
.directory-student { margin-top: 6rpx; color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); }
.directory-arrow { color: #a2adbd; font-size: 36rpx; }
.directory-state { padding: 80rpx 32rpx; text-align: center; color: var(--mg-color-text-muted); font-size: var(--mg-font-label); line-height: 1.7; }
.directory-end { padding: 32rpx; font-size: var(--mg-font-caption); color: var(--mg-color-text-muted); }
.directory-retry { width: 260rpx; height: 88rpx; margin: 28rpx auto 0; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; font-size: var(--mg-font-body); background: var(--mg-color-info-soft); color: var(--mg-color-brand); }
.empty-title { font-size: var(--mg-font-section); line-height: var(--mg-line-section); color: var(--mg-color-text-secondary); }
.empty-hint { margin-top: 12rpx; font-size: var(--mg-font-caption); color: var(--mg-color-text-muted); }
.directory-bottom { height: calc(32rpx + env(safe-area-inset-bottom)); }
.directory-pressed { opacity: .7; }
