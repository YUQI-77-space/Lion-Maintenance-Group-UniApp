<view class="mg-theme mg-data-page directory-page">
  <view class="directory-header">
    <search-field value="{{keyword}}" placeholder="搜索昵称 / 输入完整学号" maxlength="40" bindinput="onSearch" bindconfirm="onSearchConfirm" bindclear="clearSearch" />
    <view class="directory-filters">
      <picker class="directory-picker" range="{{departments}}" value="{{departmentIndex}}" bindchange="onDepartment"><view class="filter-chip {{departmentIndex ? 'filter-active' : ''}}"><text class="filter-label">{{departments[departmentIndex]}}</text><view class="filter-caret" aria-hidden="true" /></view></picker>
      <picker class="directory-picker" range="{{roles}}" value="{{roleIndex}}" bindchange="onRole"><view class="filter-chip {{roleIndex ? 'filter-active' : ''}}"><text class="filter-label">{{roles[roleIndex]}}</text><view class="filter-caret" aria-hidden="true" /></view></picker>
      <button wx:if="{{departmentIndex || roleIndex}}" class="reset-filters" bindtap="resetFilters">重置</button>
      <text class="directory-count">{{loading ? '' : total + ' 位成员'}}</text>
    </view>
  </view>
  <scroll-view class="directory-list" scroll-y refresher-enabled refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onRefresherRefresh" bindscrolltolower="onLoadMore" lower-threshold="100" refresher-default-style="none">
<view slot="refresher" class="unified-refresher"><loading-animation wx:if="{{refresherTriggered}}" size="small" /></view>
    <view class="directory-group" wx:if="{{items.length}}">
      <view class="directory-member" wx:for="{{items}}" wx:key="userId" bindtap="openDetail" data-id="{{item.userId}}" hover-class="directory-pressed" role="button" aria-label="查看{{item.nickName}}的资料">
        <avatar-display userInfo="{{item}}" openid="{{item.openid}}" size="medium" showBorder="{{false}}" />
        <view class="directory-info"><view class="directory-name-row"><text class="directory-name">{{item.nickName || '未设置昵称'}}</text><text class="directory-role role-{{item.role}}">{{item.roleName}}</text></view><view class="directory-department">{{item.department || '未设置部门'}}</view><view class="directory-student">学号 {{item.studentId || '未填写'}}</view></view><text class="directory-arrow">›</text>
      </view>
    </view>
    <view class="directory-state" wx:if="{{loading}}"><loading-animation size="small" /></view>
    <view class="directory-state" wx:elif="{{error}}"><view>{{error}}</view><button class="directory-retry" bindtap="retry">重试加载</button></view>
    <view class="directory-state" wx:elif="{{!items.length}}"><view class="empty-title">{{keyword || departmentIndex || roleIndex ? '未找到匹配的成员' : '暂无组员'}}</view><view class="empty-hint">{{keyword || departmentIndex || roleIndex ? '试试其他昵称、完整学号，或清除筛选条件' : '组内成员将在这里显示'}}</view><button wx:if="{{keyword || departmentIndex || roleIndex}}" class="directory-retry" bindtap="resetSearch">查看全部成员</button></view>
    <view class="directory-state directory-end" wx:elif="{{loadingMore}}"><loading-animation size="small" /></view>
    <view class="directory-state directory-end" wx:elif="{{!hasMore}}">已显示全部 {{total}} 位成员</view>
    <view class="directory-bottom" />
  </scroll-view>
</view>
<loading-overlay id="global-loading" />
