@import "/styles/design-primitives.wxss";

page { background: var(--mg-color-bg-page); }
.task-create-page { padding-top: var(--mg-space-3); }
.task-create-note { margin-bottom: var(--mg-space-2); color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); }
.task-create-section { margin-bottom: var(--mg-space-3); }
.task-create-heading { display: flex; align-items: center; gap: var(--mg-space-2); margin-bottom: var(--mg-space-3); font-size: var(--mg-font-section); line-height: var(--mg-line-section); font-weight: var(--mg-weight-semibold); }
.task-create-field + .task-create-field { margin-top: var(--mg-space-3); }
.task-create-choice { display: flex; align-items: center; justify-content: space-between; gap: var(--mg-space-2); }
.task-create-choice--pressed { background: var(--mg-color-bg-subtle); }
.task-create-value { min-width: 0; white-space: normal; overflow-wrap: break-word; line-height: var(--mg-line-body); }
.task-create-caret { flex-shrink: 0; width: 6px; height: 6px; margin-right: 3px; border-right: 1.5px solid var(--mg-color-text-muted); border-bottom: 1.5px solid var(--mg-color-text-muted); transform: rotate(45deg); }
.task-create-datetime { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--mg-space-2); }
.task-create-optional { color: var(--mg-color-text-muted); font-size: var(--mg-font-label); line-height: var(--mg-line-label); font-weight: 400; }
.task-create-description { height: 144px; line-height: var(--mg-line-body); }
.task-create-placeholder { color: var(--mg-color-text-muted); }
.task-create-count { margin-top: var(--mg-space-1); color: var(--mg-color-text-muted); text-align: right; font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); }
@media (max-width: 360px) { .task-create-datetime { grid-template-columns: 1fr; gap: var(--mg-space-3); } }
