<view class="mg-theme mg-page task-create-page">
  <view class="task-create-note">除选填项外均为必填</view>
  <view class="mg-surface task-create-section">
    <view class="task-create-heading">维修分类</view>
    <view class="mg-field task-create-field">
      <view class="mg-label">主要类别</view>
      <picker range="{{level1Array}}" value="{{level1Index}}" bindchange="onLevel1Change" aria-label="主要类别，{{selectedLevel1}}">
        <view class="mg-input task-create-choice" hover-class="task-create-choice--pressed"><text class="task-create-value">{{selectedLevel1 || '请选择'}}</text><view class="task-create-caret" aria-hidden="true"></view></view>
      </picker>
    </view>
    <view class="mg-field task-create-field">
      <view class="mg-label">设备类型</view>
      <picker range="{{level2Array}}" value="{{level2Index}}" bindchange="onLevel2Change" aria-label="设备类型，{{selectedLevel2}}">
        <view class="mg-input task-create-choice" hover-class="task-create-choice--pressed"><text class="task-create-value">{{selectedLevel2 || '请选择'}}</text><view class="task-create-caret" aria-hidden="true"></view></view>
      </picker>
    </view>
    <view class="mg-field task-create-field">
      <view class="mg-label">具体服务</view>
      <picker range="{{level3Array}}" value="{{level3Index}}" bindchange="onLevel3Change" aria-label="具体服务，{{selectedLevel3}}">
        <view class="mg-input task-create-choice" hover-class="task-create-choice--pressed"><text class="task-create-value">{{selectedLevel3 || '请选择'}}</text><view class="task-create-caret" aria-hidden="true"></view></view>
      </picker>
    </view>
  </view>
  <view class="mg-surface task-create-section">
    <view class="task-create-heading">预约时间</view>
    <view class="task-create-datetime">
      <view class="mg-field">
        <view class="mg-label">预约日期</view>
        <picker mode="date" bindchange="onDatePickerConfirm" value="{{formData.appointmentDate}}" start="{{startDate}}" end="{{endDate}}" aria-label="预约日期，{{formData.appointmentDate}}">
          <view class="mg-input task-create-choice" hover-class="task-create-choice--pressed"><text class="task-create-value">{{formData.appointmentDate || '选择日期'}}</text><view class="task-create-caret" aria-hidden="true"></view></view>
        </picker>
      </view>
      <view class="mg-field">
        <view class="mg-label">预约时间</view>
        <picker mode="time" bindchange="onTimePickerConfirm" value="{{formData.appointmentTime}}" start="08:00" end="22:00" aria-label="预约时间，{{formData.appointmentTime}}">
          <view class="mg-input task-create-choice" hover-class="task-create-choice--pressed"><text class="task-create-value">{{formData.appointmentTime || '选择时间'}}</text><view class="task-create-caret" aria-hidden="true"></view></view>
        </picker>
      </view>
    </view>
  </view>
  <view class="mg-surface task-create-section">
    <view class="task-create-heading">问题描述<text class="task-create-optional">选填</text></view>
    <textarea class="mg-input task-create-description" placeholder="例如：故障现象、设备型号、发生时间" placeholder-class="task-create-placeholder" value="{{formData.description}}" data-field="description" bindinput="onInputChange" maxlength="500" show-confirm-bar="{{false}}" aria-label="问题描述，选填，最多500字" />
    <view class="task-create-count">{{formData.description.length}}/500</view>
  </view>
  <button class="mg-button mg-button--primary {{isSubmitting ? 'mg-button--loading' : ''}}" hover-class="mg-button--pressed" bindtap="submitTask" disabled="{{isSubmitting || submitUnknown}}" aria-label="{{isSubmitting ? '正在提交维修任务' : '提交维修任务'}}">
    <loading-animation wx:if="{{isSubmitting}}" size="small" inverse="{{true}}" /><text wx:else>提交维修任务</text>
  </button>
</view>
<loading-overlay id="global-loading" />
