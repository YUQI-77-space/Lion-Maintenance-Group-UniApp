@import "/styles/data-pages.wxss";
/* pages/team/maintenance/manage/index.wxss */
@import "/styles/variables.wxss";

/* 页面容器 - 左右分栏布局 */
.page-container {
  display: flex;
  height: 100vh;
  overflow: hidden;
  background-color: var(--background-color);
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top);
  padding-left: 0;
  padding-right: 0;
}

/* 左侧分类导航 */
.sidebar {
  width: 180rpx;
  flex-shrink: 0;
  background: #F5F5F5;
  border-right: 1px solid var(--border-light);
  height: 100%;
  overflow-y: hidden;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
}

.sidebar view {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: var(--mg-font-label);
  position: relative;
  background: transparent;
  transition: background-color 0.2s ease;
}

.sidebar view:active {
  opacity: 0.7;
}

.sidebar view.active {
  color: var(--primary-color);
  background: var(--card-background);
  font-weight: var(--mg-weight-semibold);
}

.sidebar view.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 48rpx;
  background: var(--primary-color);
  border-radius: 0 3rpx 3rpx 0;
}

/* 右侧内容区域 */
.content-wrapper {
  flex: 1;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--background-color);
}

/* 粘性头部：搜索框固定在页面上方，列表在其下方滚动 */
.sticky-header {
  flex-shrink: 0;
  padding: 20rpx;
  background: transparent;
}

/* 列表滚动区域 */
.content {
  flex: 1;
  height: 0; /* flex: 1 + height: 0 = 完全填满剩余空间 */
}

/* 任务列表 */
.task-list {
  padding-bottom: 120rpx;
  padding-top: 0;
  padding-left: 0;
  padding-right: 0;
}

/* 任务卡片样式 */
.task-card {
  background-color: var(--card-background);
  border-radius: 16rpx;
  margin: 0 20rpx 20rpx 20rpx;
  box-shadow: var(--box-shadow);
  overflow: hidden;
  position: relative;
  border: 1rpx solid var(--border-light);
  transform-origin: center top;
  transition: transform 0.2s ease-in-out;
}

.task-card.card-animate:active {
  transform: scale(0.98) translateZ(0);
}

/* 状态与工作量在卡片右上角纵向排列。 */
.task-status-column {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.task-ew {
  white-space: nowrap;
  font-size: var(--mg-font-label);
  color: var(--mg-color-brand);
  margin-top: 10rpx;
}

/* 卡片头部 */
.task-info {
  padding: 24rpx;
  position: relative;
}

/* 取消顶部色条，统一以描边表达 */
.status-indicator { display: none; }

/* 任务编号 */
.task-id {
  font-size: var(--mg-font-label);
  color: var(--text-placeholder);
  margin-bottom: 8rpx;
  font-weight: 400;
}

.task-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.mg-data-page .task-header .task-title {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  overflow-wrap: break-word;
  font-size: var(--mg-font-title);
  font-weight: var(--mg-weight-semibold);
  line-height: 1.45;
}

.task-header .task-status {
  flex-shrink: 0;
  white-space: nowrap;
}

.application-time {
  font-size: var(--mg-font-label);
  color: var(--text-regular);
  margin-bottom: 10rpx;
}

/* 任务元信息 */
.task-meta {
  display: flex;
  align-items: center;
  margin-bottom: 0;
  flex-wrap: wrap;
  gap: 10rpx;
}

.management-tag {
  display: inline-flex; align-items: center; justify-content: center; align-self: center; vertical-align: middle;
  background-color: transparent;
  color: var(--mg-color-brand); /* 组长创建统一颜色 */
  font-size: var(--mg-font-caption);
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  font-weight: 500;
  flex-shrink: 0;
  border: 1rpx solid var(--mg-color-brand);
}

.appointment-time {
  font-size: var(--mg-font-label);
  color: var(--text-regular);
  flex: 1;
  min-width: 0;
}

/* 任务状态标签 */
.task-status {
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  font-size: var(--mg-font-caption);
  font-weight: 500;
  border: 1rpx solid;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background-color: transparent; /* 无底色 */
}

.status-pending { color: var(--maintenance-pending-color); border-color: var(--maintenance-pending-color); background-color: transparent; }

.status-inProgress { color: var(--maintenance-inProgress-color); border-color: var(--maintenance-inProgress-color); background-color: transparent; }

.status-completed { color: var(--maintenance-completed-color); border-color: var(--maintenance-completed-color); background-color: transparent; }

/* 新增：已撤销 */
.status-cancelled { color: var(--maintenance-cancelled-color); border-color: var(--maintenance-cancelled-color); background-color: transparent; }

/* 卡片边框按状态着色 */
.pending-card { border-color: var(--maintenance-pending-color); }
.inProgress-card { border-color: var(--maintenance-inProgress-color); }
.completed-card { border-color: var(--maintenance-completed-color); }
.cancelled-card { border-color: var(--maintenance-cancelled-color); }

/* 无任务提示 */
.no-task {
  text-align: center;
  padding: 100rpx 20rpx;
  color: var(--text-secondary);
  font-size: var(--mg-font-body);
  background-color: var(--card-background);
  border-radius: 16rpx;
  margin: 20rpx 0;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0;
  color: var(--text-secondary);
  font-size: var(--mg-font-label);
}

/* 响应式调整（移除不被支持的@media） */

/* 创建任务按钮样式 */
.create-btn {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #000000; /* 纯黑底色 */
  border: 1rpx solid #000000; /* 纯黑边框 */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  z-index: 1000;
  transition: all 0.2s ease;
}

.create-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 10rpx rgba(58, 134, 255, 0.4);
}

.add-icon {
  width: 50rpx;
  height: 50rpx;
  filter: brightness(0) invert(1); /* 纯白“+”号 */
}

/* 列表采用蓝灰底与白色卡片，细边界强化内容层次。 */
.mg-data-page .content { background: var(--mg-color-bg-subtle); }
.mg-data-page .task-card {
  border: var(--mg-border-width) solid var(--mg-color-border);
}
