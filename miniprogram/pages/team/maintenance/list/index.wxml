<!--pages/team/maintenance/list/index.wxml-->
<view class="mg-theme mg-data-page page-container">
  <!-- 左侧分类导航 -->
  <view class="sidebar" style="width: 180rpx;">
    <view 
      wx:for="{{categories}}"
      wx:key="key"
      class="sidebar-item {{activeCategory === item.key ? 'active' : ''}}"
      bindtap="onCategoryChange"
      data-key="{{item.key}}"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 右侧内容区域 -->
  <scroll-view class="content" scroll-y bindscrolltolower="onReachBottom" refresher-enabled bindrefresherrefresh="onRefresherRefresh" refresher-triggered="{{refresherTriggered}}" refresher-default-style="none">
<view slot="refresher" class="unified-refresher"><loading-animation wx:if="{{refresherTriggered}}" size="small" /></view>
    <view class="container">
      <view wx:if="{{readOnly}}" class="member-readonly-note">已退休 · 您可以查看历史记录，暂不参与接单。</view>
      <view class="mg-page-notice mg-page-notice--error" wx:if="{{loadError}}">{{loadError}}<button class="mg-button mg-button--secondary" bindtap="retryList">重试加载</button></view>
      <!-- 加载动画 -->
      <view class="loading-container" wx:if="{{loading}}">
        <loading-animation size="large" />
      </view>
      
      <!-- 任务列表 -->
      <view class="task-list" wx:if="{{!loading && allTasks.length > 0}}">
        <block wx:for="{{allTasks}}" wx:key="maintenanceTaskId">
          <view class="task-card ticket {{item.taskStatus}}-card {{cardDelays[index] !== undefined ? 'card-animate' : ''}}" style="animation-delay: {{cardDelays[index] || 0}}ms;">
            <view class="status-indicator {{item.taskStatus}}"></view>
            <view class="task-info" bindtap="viewTaskDetail" data-task="{{item}}">
              <view class="task-header">
                <view class="task-title">{{item.level3}}</view>
                <view class="task-status status-{{item.taskStatus}}">{{item.taskStatusText}}</view>
              </view>
              <view class="task-id">任务编号：{{item.maintenanceTaskId}}</view>
              <view class="application-time">申请时间: {{item.createTimeFormatted}}</view>
              <view class="appointment-time">预约时间: {{item.appointmentTime}}</view>
              <!-- 标签单独占底部一行靠左，不插入两个时间之间 -->
              <view class="task-footer" wx:if="{{item.isManagementCreated}}">
                <text class="management-tag">组长创建</text>
              </view>
            </view>
            <!-- 按业务状态呈现票根，新旧记录均不依赖本地动画标记 -->
            <view class="ticket-stub ticket-stub--claimable {{tornTaskIds[item.maintenanceTaskId] ? 'is-tearing' : ''}}"
                  wx:if="{{!readOnly && item.taskStatus === 'pending'}}"
                  catchtap="claimTask"
                  data-task-id="{{item.maintenanceTaskId}}"
                  role="button"
                  aria-label="认领任务 {{item.maintenanceTaskId}}">
              <view class="stub-paper">
                <view class="stub-label"><text>认</text><text>领</text></view>
              </view>
              <view class="stub-tear" aria-hidden="true"></view>
              <view class="stub-ghost" aria-hidden="true"></view>
            </view>
            <view class="ticket-stub ticket-stub--torn" wx:elif="{{item.taskStatus === 'inProgress' || item.taskStatus === 'completed'}}" aria-hidden="true">
              <view class="stub-ghost is-visible"></view>
            </view>
            <view class="ticket-stub ticket-stub--inactive" wx:elif="{{item.taskStatus === 'pending' || item.taskStatus === 'cancelled'}}" aria-hidden="true">
              <view class="stub-label"><text>{{item.taskStatus === 'cancelled' ? '已' : '待'}}</text><text>{{item.taskStatus === 'cancelled' ? '取' : '受'}}</text><text>{{item.taskStatus === 'cancelled' ? '消' : '理'}}</text></view>
            </view>
          </view>
        </block>
        <!-- 加载更多 -->
        <view class="load-more" wx:if="{{allTasks.length > 0}}">
          <view wx:if="{{loadingMore}}"><loading-animation size="small" /></view>
          <text wx:elif="{{!hasMore}}">— 已加载全部 —</text>
        </view>
      </view>

      <!-- 无任务提示 -->
      <view class="no-task" wx:if="{{!loading && !loadError && allTasks.length === 0}}">
        <text>暂无维修任务</text>
      </view>
    </view>
  </scroll-view>
</view>
<loading-overlay id="global-loading" />
