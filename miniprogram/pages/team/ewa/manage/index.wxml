<scroll-view class="unified-page-scroll" scroll-y enhanced enable-back-to-top scroll-top="{{unifiedScrollTop}}" scroll-with-animation refresher-enabled refresher-default-style="none" refresher-triggered="{{unifiedRefreshing}}" bindrefresherrefresh="onUnifiedRefresh" bindscroll="onUnifiedScroll" bindscrolltolower="onUnifiedBottom" lower-threshold="50">
<view slot="refresher" class="unified-refresher"><loading-animation wx:if="{{unifiedRefreshing}}" size="small" /></view>
<!--pages/team/ewa/manage/index.wxml-->
<wxs module="format">
function formatEW(value) {
  if (!value && value !== 0) {
    return '—';
  }
  var num = parseFloat(value);
  if (isNaN(num)) {
    return '—';
  }
  
  if (Math.floor(num) === num) {
    return num + '';
  }
  
  var str = num.toFixed(2);
  if (str.charAt(str.length - 1) === '0') {
    str = str.slice(0, -1);
  }
  if (str.charAt(str.length - 1) === '0') {
    str = str.slice(0, -1);
  }
  if (str.charAt(str.length - 1) === '.') {
    str = str.slice(0, -1);
  }
  return str;
}

function hasValue(value) {
  if (value === null || value === undefined || value === '') {
    return false;
  }
  return !isNaN(parseFloat(value));
}

module.exports = {
  formatEW: formatEW,
  hasValue: hasValue
};
</wxs>
<page-meta page-style="{{showEditModal ? 'overflow: hidden;' : ''}}" />
<view class="mg-theme mg-page ewa-page">
  <view class="ewa-state" wx:if="{{!hasPermission}}">
    <text class="ewa-state-title">暂时无法访问</text>
    <text class="ewa-state-desc">此页面仅向组长开放，可在维修组首页查看其他功能。</text>
    <button class="mg-button mg-button--secondary ewa-state-action" hover-class="mg-button--pressed" bindtap="goBack">返回</button>
  </view>
  <block wx:else>
    <view wx:if="{{showDataMenu}}" class="ewa-menu-backdrop" catchtap="closeDataMenu" />
    <view class="ewa-ranking-bar {{showDataMenu ? 'ewa-ranking-bar--open' : ''}}">
      <text class="ewa-ranking-count">{{loading ? '' : '已加载 ' + users.length + ' / ' + totalCount}}</text>
      <text class="ewa-ranking-title">成员排名</text>
      <view class="ewa-data-menu">
        <button size="mini" class="ewa-header-action" hover-class="ewa-header-action--pressed" bindtap="toggleDataMenu" disabled="{{updatingEW || exporting}}" aria-label="数据操作，刷新汇总或导出 Excel" aria-expanded="{{showDataMenu}}"><loading-animation wx:if="{{updatingEW || exporting}}" size="small" /><text wx:else>数据操作</text></button>
        <view wx:if="{{showDataMenu}}" class="ewa-menu-panel">
          <button class="ewa-menu-item" hover-class="ewa-pressed" bindtap="onDataMenuAction" data-action="refresh">刷新汇总</button>
          <button class="ewa-menu-item" hover-class="ewa-pressed" bindtap="onDataMenuAction" data-action="export">导出 Excel</button>
        </view>
      </view>
    </view>

    <view class="ewa-banner ewa-banner--error" wx:if="{{loadError}}">
      <text class="ewa-banner-text">{{loadError}}</text>
      <button class="ewa-banner-action" hover-class="ewa-pressed" bindtap="onPullDownRefresh">重试</button>
    </view>

    <view class="ewa-podium" wx:if="{{users.length}}">
      <block wx:for="{{users}}" wx:key="ewaUserId">
        <view wx:if="{{index < 3}}" class="ewa-podium-member ewa-podium-member--{{index + 1}}" hover-class="ewa-podium-member--pressed" bindtap="editUserEW" data-user-id="{{item.ewaUserId}}" role="button" aria-label="第{{index + 1}}名，{{item.nickName || item.ewaUserName || '未命名成员'}}，总分{{format.formatEW(item.totalEW)}}，点击调整工作量">
          <view class="ewa-podium-avatar"><avatar-display userInfo="{{item}}" openid="{{item.ewaUserId}}" size="{{index === 0 ? 'large' : 'medium'}}" showBorder="{{false}}" /></view>
          <text class="ewa-podium-name">{{item.nickName || item.ewaUserName || '未命名成员'}}</text>
          <view class="ewa-podium-step">
            <text class="ewa-podium-place">{{index === 0 ? '第一名' : (index === 1 ? '第二名' : '第三名')}}</text>
            <view class="ewa-score"><text class="ewa-podium-score">{{format.formatEW(item.totalEW)}}</text><text class="ewa-podium-unit" wx:if="{{format.hasValue(item.totalEW)}}">分</text></view>
          </view>
        </view>
      </block>
    </view>

    <view class="ewa-surface ewa-list" wx:if="{{users.length}}">
      <block wx:for="{{users}}" wx:key="ewaUserId">
        <view wx:if="{{index >= 3 && (showAllRankings || index < 10)}}" class="ewa-rank-row" hover-class="ewa-rank-row--pressed" bindtap="editUserEW" data-user-id="{{item.ewaUserId}}" role="button" aria-label="调整{{item.nickName || item.ewaUserName || '未命名成员'}}的工作量">
          <view class="ewa-rank-badge">{{index + 1}}</view>
          <avatar-display userInfo="{{item}}" openid="{{item.ewaUserId}}" size="medium" showBorder="{{false}}" />
          <view class="ewa-member">
            <text class="ewa-member-name">{{item.nickName || item.ewaUserName || '未命名成员'}}</text>
            <text class="ewa-member-meta">维修 {{format.formatEW(item.maintenanceEW)}} · 志愿 {{format.formatEW(item.volunteerEW)}} · 值班 {{format.formatEW(item.dutyEW)}}</text>
          </view>
          <view class="ewa-score">
            <text class="ewa-score-value">{{format.formatEW(item.totalEW)}}</text>
            <text class="ewa-score-unit" wx:if="{{format.hasValue(item.totalEW)}}">分</text>
          </view>
          <view class="ewa-chevron" />
        </view>
      </block>
      <button wx:if="{{users.length > 10}}" class="ewa-row-action" hover-class="ewa-row-action--pressed" bindtap="toggleRankings">{{showAllRankings ? '收起至前 10 名' : '展开其余 ' + (users.length - 10) + ' 位成员'}}</button>
      <button wx:if="{{hasMore && showAllRankings}}" class="ewa-row-action" hover-class="ewa-row-action--pressed" bindtap="onReachBottom" disabled="{{loadingMore || loading}}"><loading-animation wx:if="{{loadingMore}}" size="small" /><text wx:else>{{'加载更多成员'}}</text></button>
      <view wx:if="{{!hasMore && showAllRankings && users.length}}" class="ewa-list-end">已显示全部成员</view>
    </view>

    <view class="ewa-state" wx:if="{{loading && !users.length}}">
      <loading-animation size="default" />
      
    </view>
    <view class="ewa-state" wx:if="{{!loading && !loadError && !users.length}}">
      <text class="ewa-state-title">暂无工作量记录</text>
      <text class="ewa-state-desc">可通过“数据操作”刷新汇总，更新成员排名。</text>
    </view>

    <view class="ewa-note" wx:if="{{users.length}}">
      <text>三科为原始工作量（EW），总分由服务端结算。</text>
      <text>点击成员可调整工作量。</text>
    </view>
  </block>

  <action-modal visible="{{showEditModal}}" bottom="{{true}}" title="调整工作量" subtitle="{{editUser.ewaUserName}} · 当前总分 {{format.formatEW(editUser.totalEW)}} 分" confirmText="核对并保存" cancelText="取消" loading="{{savingEW}}" bindcancel="hideEditModal" bindconfirm="saveUserEW">
    <view class="ewa-sheet-body">
      <text class="ewa-sheet-intro">每科 0–300 EW，总分保存后由服务端计算。</text>
      <view class="ewa-field">
        <view class="ewa-field-head"><text class="ewa-field-label">维修工作量</text><text class="ewa-field-weight">权重 ×0.5</text></view>
        <view class="ewa-field-control {{focusField === 'maintenance' ? 'ewa-field-control--focus' : ''}}">
          <input class="ewa-field-input" type="digit" value="{{editUser.maintenanceEW}}" placeholder="0–300" placeholder-class="ewa-field-placeholder" aria-label="维修原始工作量，0至300" bindinput="onMaintenanceEWInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="maintenance" disabled="{{savingEW}}" adjust-position="{{true}}" cursor-spacing="24" />
          <text class="ewa-field-unit">EW</text>
        </view>
        <text class="ewa-field-help">原值 {{format.formatEW(editOriginal.maintenanceEW)}}</text>
      </view>
      <view class="ewa-field">
        <view class="ewa-field-head"><text class="ewa-field-label">志愿工作量</text><text class="ewa-field-weight">权重 ×0.4</text></view>
        <view class="ewa-field-control {{focusField === 'volunteer' ? 'ewa-field-control--focus' : ''}}">
          <input class="ewa-field-input" type="digit" value="{{editUser.volunteerEW}}" placeholder="0–300" placeholder-class="ewa-field-placeholder" aria-label="志愿原始工作量，0至300" bindinput="onVolunteerEWInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="volunteer" disabled="{{savingEW}}" adjust-position="{{true}}" cursor-spacing="24" />
          <text class="ewa-field-unit">EW</text>
        </view>
        <text class="ewa-field-help">原值 {{format.formatEW(editOriginal.volunteerEW)}}</text>
      </view>
      <view class="ewa-field">
        <view class="ewa-field-head"><text class="ewa-field-label">值班工作量</text><text class="ewa-field-weight">权重 ×0.1</text></view>
        <view class="ewa-field-control {{focusField === 'duty' ? 'ewa-field-control--focus' : ''}}">
          <input class="ewa-field-input" type="digit" value="{{editUser.dutyEW}}" placeholder="0–300" placeholder-class="ewa-field-placeholder" aria-label="值班原始工作量，0至300" bindinput="onDutyEWInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="duty" disabled="{{savingEW}}" adjust-position="{{true}}" cursor-spacing="24" />
          <text class="ewa-field-unit">EW</text>
        </view>
        <text class="ewa-field-help">原值 {{format.formatEW(editOriginal.dutyEW)}}</text>
      </view>
    </view>
  </action-modal>
</view>
</scroll-view>
<loading-overlay id="global-loading" />
