@import "/styles/data-pages.wxss";
/* pages/team/ewa/summary/index.wxss
   工作量统计 - 白卡 + 细边框 + 品牌色点缀
   风格与「我的消息」「待办详情」「报修向导」保持一致：克制的色彩、清晰的信息层级 */
@import '/styles/variables.wxss';

page {
  background-color: var(--bg-page);
  color: var(--text-primary);
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-page);
  box-sizing: border-box;
}

/* ==================== 入场动画 ==================== */
@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.card-animate {
  animation: slideInUp 0.45s ease-out forwards;
  opacity: 0;
}

/* ==================== 卡片 ==================== */
.card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--mg-color-border);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.card:last-child {
  margin-bottom: 0;
}

/* 卡片标题：左侧品牌色竖条 */
.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.card-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

.card-hint {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--mg-color-border);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-muted);
}

/* ==================== 概览 ==================== */
.overview {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--mg-color-border);
  border-radius: 20rpx;
  box-sizing: border-box;
}

.overview-block {
  flex: 1;
  min-width: 0;
}

.overview-block-side {
  flex: none;
  padding-left: 28rpx;
  text-align: right;
}

.overview-split {
  width: 1rpx;
  height: 64rpx;
  background: var(--mg-color-border);
}

.overview-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
}

.overview-value {
  display: block;
  margin-top: 8rpx;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--primary);
  word-break: break-all;
}

.overview-value-side {
  font-size: 36rpx;
  color: var(--text-primary);
}

.overview-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-secondary);
}

/* ==================== 工作量构成 ==================== */
.dist-item + .dist-item {
  margin-top: 26rpx;
}

.dist-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dist-name {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.dist-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.dist-numbers {
  display: flex;
  align-items: baseline;
}

.dist-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.dist-percent {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.dist-track {
  height: 8rpx;
  margin-top: 12rpx;
  background: var(--mg-color-border);
  border-radius: 4rpx;
  overflow: hidden;
}

.dist-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.6s ease-out;
}

/* ==================== 图表 ==================== */
.chart-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* ==================== 加载 / 空态 ==================== */
.loading-wrap,
.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-card {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 28rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

.mg-surface { padding: 32rpx; margin-bottom: 32rpx; }
.ewa-text-row { padding: 24rpx 0; border-bottom: 1px solid var(--mg-color-border); font-size: 15px; line-height: 1.7; }
.ewa-subject { font-weight: 600; }
.overview { flex-wrap: wrap; gap: 24rpx; }
