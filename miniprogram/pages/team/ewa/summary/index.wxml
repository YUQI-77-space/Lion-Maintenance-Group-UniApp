<view class="mg-theme mg-data-page page">
  <view class="mg-page-notice">团队当前累计工作量；维修×0.5＋志愿×0.4＋值班×0.1。单科原始值上限300，加权总分由服务端结算。</view>
  <view class="mg-page-notice mg-page-notice--error" wx:if="{{loadError}}">{{loadError}}<button class="mg-button mg-button--secondary" bindtap="fetchSummary">重新加载</button></view>
  <view class="loading-wrap" wx:if="{{loading}}"><loading-animation size="large" /></view>
  <block wx:if="{{loaded}}">
    <view class="mg-surface overview"><view><text class="overview-label">加权总分（分）</text><view class="overview-value">{{totalText}}</view></view><view><text class="overview-label">参与成员</text><view>{{totalUsers}} 人</view></view></view>
    <view class="mg-page-notice" wx:if="{{!totalUsers}}">暂无成员数据</view>
    <view class="mg-page-notice" wx:if="{{hasMissing}}">部分工作量字段缺失，显示“—”；缺失科目不绘图，请核对数据。</view>
    <view class="mg-surface" wx:if="{{totalUsers}}">
      <view class="card-title">三科明细</view>
      <view class="ewa-text-row" wx:for="{{rows}}" wx:key="key"><view class="ewa-subject" style="color: {{item.color}};">{{item.name}} ×{{item.weight}}</view><view>原始工作量 {{item.valueText}} EW</view><view>加权贡献 {{item.contributionText}} 分</view></view>
      <view class="card-hint">更新于 {{updatedAt}}</view>
    </view>
    <view class="mg-surface" wx:if="{{pieChartData.length}}"><view class="card-title">加权贡献占比</view><pie-chart chartData="{{pieChartData}}" width="{{pieWidth}}" height="{{pieHeight}}" legend="{{true}}" /></view>
    <view class="mg-surface" wx:if="{{totalUsers && !hasMissing}}"><view class="card-title">原始工作量（EW）</view><bar-chart chartData="{{barChartData}}" colors="{{chartColors}}" width="{{canvasWidth}}" height="{{220}}" /></view>
  </block>
</view>
