@import "/styles/data-pages.wxss";
/* pages/team/volunteer/manage/index.wxss */
@import "/styles/variables.wxss";

/* 页面容器 - 左右分栏布局 */
.page-container {
  display: flex;
  height: 100vh;
  overflow: hidden;
  background-color: var(--background-color);
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top);
  padding-left: 0;
  padding-right: 0;
  position: relative;
}

/* 左侧分类导航 */
.sidebar {
  width: 180rpx;
  flex-shrink: 0;
  background: #F5F5F5;
  border-right: 1px solid var(--border-light);
  height: 100%;
  overflow-y: hidden;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
}

.sidebar view {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: var(--mg-font-label);
  position: relative;
  background: transparent;
  transition: background-color 0.2s ease;
}

.sidebar view:active {
  opacity: 0.7;
}

.sidebar view.active {
  color: var(--primary-color);
  background: var(--card-background);
  font-weight: var(--mg-weight-semibold);
}

.sidebar view.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 48rpx;
  background: var(--primary-color);
  border-radius: 0 3rpx 3rpx 0;
}

/* 右侧内容区域 */
.content-wrapper {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--background-color);
  position: relative;
}

/* 粘性头部：搜索框固定在页面上方，列表在其下方滚动 */
.sticky-header {
  flex-shrink: 0;
  padding: 20rpx;
  background: transparent;
}

/* 列表滚动区域 - 必须设置高度才能滚动 */
.content {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.activity-list {
  padding: 20rpx;
}

/* 活动卡片样式 */
.activity-card {
  background-color: var(--card-background);
  border-radius: 16rpx;
  padding: 30rpx 30rpx 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--box-shadow);
  border: 1rpx solid var(--border-light);
  transform-origin: center top;
  transition: transform 0.2s ease-in-out;
}

.activity-card.card-animate:active {
  transform: scale(0.98) translateZ(0);
}

/* 初始加载状态样式 */

.loading-more, .no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: var(--mg-font-label);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: var(--mg-font-body);
  color: var(--text-regular);
  font-weight: 500;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: var(--mg-font-label);
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.4;
}

/* 创建按钮样式 */
.create-btn {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  background-color: #000000;
  border: 1rpx solid #000000;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  z-index: 100;
  transition: all 0.2s ease;
}

.create-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.4);
}

.add-icon {
  width: 50rpx;
  height: 50rpx;
  filter: brightness(0) invert(1);
}

/* 招募状态切换 */
.recruitment-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.toggle-label {
  font-size: var(--mg-font-label);
  color: var(--text-main);
}

.toggle-label.open {
  color: var(--mg-color-success);
}

.toggle-label.closed {
  color: #ff6b6b;
}

.recruitment-switch {
  transform: scale(0.86);
}

.pending-notice {
  flex: 1;
  font-size: var(--mg-font-label);
  color: var(--mg-color-warning);
  padding: 10rpx 20rpx;
  text-align: left;
}

.countdown-banner {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  border-left: 4rpx solid var(--mg-color-warning);
  padding: 16rpx 24rpx;
  margin: 0 0 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 8rpx;
}

.countdown-label {
  font-size: var(--mg-font-label);
  color: var(--mg-color-warning);
  font-weight: 500;
}

.countdown-time {
  font-size: var(--mg-font-body);
  color: var(--mg-color-warning);
  font-weight: var(--mg-weight-semibold);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 0;
}

.header-left {
  flex: 1;
  margin-right: 20rpx;
}

.card-title {
  font-size: var(--mg-font-body);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
}

.activity-id {
  font-size: var(--mg-font-label);
  color: var(--text-placeholder);
  margin-top: 10rpx;
}

.card-content {
  margin-bottom: 0;
  font-size: var(--mg-font-body);
  color: var(--text-regular);
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 4rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  font-size: var(--mg-font-label);
  color: var(--text-secondary);
  width: 100%;
}

/* 状态标签样式 */
.status-tag {
  display: flex;
  align-items: center;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: var(--mg-font-caption);
  flex-shrink: 0;
  margin-top: 5rpx;
  background-color: transparent;
  border: 1rpx solid;
}

.status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.status-inPreparation {
  color: var(--volunteer-inPreparation-color);
  border-color: var(--volunteer-inPreparation-color);
}
.status-inPreparation .status-dot {
  background-color: var(--volunteer-inPreparation-color);
}
.status-inProgress {
  color: var(--volunteer-inProgress-color);
  border-color: var(--volunteer-inProgress-color);
}
.status-inProgress .status-dot {
  background-color: var(--volunteer-inProgress-color);
}
.status-ended {
  color: var(--volunteer-ended-color);
  border-color: var(--volunteer-ended-color);
}
.status-ended .status-dot {
  background-color: var(--volunteer-ended-color);
}
.status-pending {
  color: var(--volunteer-pending-color);
  border-color: var(--volunteer-pending-color);
}
.status-pending .status-dot {
  background-color: var(--volunteer-pending-color);
}

.activity-card.status-pending-card {
  border-color: var(--volunteer-pending-color);
}
.activity-card.status-inPreparation-card {
  border-color: var(--volunteer-inPreparation-color);
}
.activity-card.status-inProgress-card {
  border-color: var(--volunteer-inProgress-color);
}
.activity-card.status-ended-card {
  border-color: var(--volunteer-ended-color);
}

/* 初始加载状态样式 */
.initial-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
  padding: 40rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* 列表采用蓝灰底与白色卡片，细边界强化内容层次。 */
.mg-data-page .content { background: var(--mg-color-bg-subtle); }
.mg-data-page .activity-card {
  border: var(--mg-border-width) solid var(--mg-color-border);
}
