/* 阶段 2：显式复用视觉基础；页面业务样式仍在本文件。 */
@import "/styles/design-primitives.wxss";
.resource-page .resource-header { padding: 16rpx 0 32rpx; }
.resource-page .eyebrow { margin-bottom: 16rpx; font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); color: var(--mg-color-brand-strong); }
.resource-page .page-title { font-size: var(--mg-font-title); line-height: var(--mg-line-title); font-weight: 600; }

.resource-page .resource-identity { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 32rpx; }
.resource-page .resource-icon-wrap { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 16rpx; background: var(--mg-color-brand-soft); }
.resource-page .resource-icon { width: 48rpx; height: 48rpx; }
.resource-page .resource-title { font-size: var(--mg-font-section); line-height: var(--mg-line-section); font-weight: 600; }
.resource-page .resource-description { margin-top: 16rpx; color: var(--mg-color-text-secondary); }
.resource-page .resource-note { margin-top: 32rpx; padding-top: 32rpx; border-top: 1px solid var(--mg-color-border); color: var(--mg-color-text-secondary); }
.resource-page .note-title { margin-bottom: 8rpx; color: var(--mg-color-text-primary); font-weight: 500; }
.resource-page .resource-footer { margin-top: 32rpx; text-align: center; font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); color: var(--mg-color-text-muted); }
