@import "/styles/data-pages.wxss";
@import "/styles/variables.wxss";

.roster-page {
  /* 时间轴与日期区共用尺寸，状态变化不改变网格边界。 */
  --roster-row-height: 64px;
  --roster-header-height: 60px;
  --roster-column-width: 72px;
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.header, .schedule-panel, .selection-container {
  background: var(--mg-color-bg-surface);
  border: 1px solid var(--mg-color-border);
  border-radius: var(--mg-radius-card);
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.week-heading, .panel-heading, .stats-info, .section-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
}
.main-title { font-size: var(--mg-font-title); line-height: var(--mg-line-title); font-weight: 600; }
.edit-status { font-size: var(--mg-font-caption); line-height: 18px; padding: 4rpx 12rpx; border-radius: var(--mg-radius-tag); color: var(--mg-color-brand-strong); background: var(--mg-color-brand-selected); }
.edit-status--closed { color: var(--mg-color-text-secondary); background: var(--mg-color-bg-subtle); }
.date-range { display: block; margin-top: 8rpx; color: var(--mg-color-text-secondary); font-size: var(--mg-font-label); line-height: var(--mg-line-label); }
.stats-info { justify-content: flex-start; margin-top: 24rpx; padding-top: 16rpx; border-top: 1px solid var(--mg-color-border); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); color: var(--mg-color-text-secondary); gap: 8rpx; }
.stat-value { font-weight: 600; color: var(--mg-color-text-primary); }
.meta-divider { margin: 0 8rpx; }
.week-rule { margin-left: auto; }
.section-title { font-size: var(--mg-font-section); line-height: var(--mg-line-section); font-weight: 600; }
.scroll-hint, .selection-count { color: var(--mg-color-text-secondary); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); }
.selection-count { color: var(--mg-color-brand-strong); font-weight: 600; }
.panel-description { display: block; margin: 8rpx 0 24rpx; color: var(--mg-color-text-secondary); font-size: var(--mg-font-label); line-height: var(--mg-line-label); }

/* 独立外框、连续网格、固定时间轴；横滚限制在日期区。 */
.duty-table-container { border: 1px solid var(--mg-color-control-border); border-radius: var(--mg-radius-control); overflow: hidden; }
.duty-table { display: flex; width: 100%; }
.fixed-column { flex: 0 0 88px; width: 88px; border-right: 1px solid var(--mg-color-control-border); background: var(--mg-color-bg-surface); }
.fixed-header-cell, .header-cell { height: var(--roster-header-height); display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--mg-color-bg-subtle); border-bottom: 1px solid var(--mg-color-control-border); }
.fixed-header-cell { font-size: var(--mg-font-label); font-weight: 600; }
.fixed-time-cell { height: var(--roster-row-height); display: flex; flex-direction: column; justify-content: center; align-items: center; border-bottom: 1px solid var(--mg-color-control-border); }
.time-slot-name { font-size: var(--mg-font-label); line-height: var(--mg-line-label); font-weight: 600; }
.time-range { color: var(--mg-color-text-secondary); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); margin-top: 4rpx; white-space: nowrap; font-variant-numeric: tabular-nums; }
.scrollable-area { flex: 1; width: 0; min-width: 0; }
.scrollable-content { width: calc(7 * var(--roster-column-width)); }
.scrollable-header-row, .scrollable-content-row { display: flex; }
.header-cell, .duty-cell { flex: 0 0 var(--roster-column-width); width: var(--roster-column-width); border-right: 1px solid var(--mg-color-control-border); }
.day-name { font-size: var(--mg-font-label); line-height: var(--mg-line-label); font-weight: 600; }
.day-date { margin-top: 4rpx; font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); color: var(--mg-color-text-secondary); font-variant-numeric: tabular-nums; }
.duty-cell { height: var(--roster-row-height); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4px; border-bottom: 1px solid var(--mg-color-control-border); position: relative; }
.header-cell:last-child, .duty-cell:last-child { border-right: 0; }
.fixed-time-cell:last-child, .scrollable-content-row:last-child .duty-cell { border-bottom: 0; }
.slot-text { font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); text-align: center; overflow-wrap: anywhere; }
.slot-check { font-size: 15px; line-height: 18px; font-weight: 600; }
.can-duty { color: var(--mg-color-brand-strong); background: var(--mg-color-bg-surface); }
.selected { color: var(--mg-color-on-brand); background: var(--mg-color-brand); }
.no-duty { color: var(--mg-color-text-muted); background: var(--mg-color-bg-subtle); }
.assigned { color: var(--mg-color-text-secondary); background: var(--mg-color-bg-page); }
.my-confirmed { color: var(--mg-color-success); background: var(--mg-color-success-soft); }
.locked { color: var(--mg-color-warning); background: var(--mg-color-warning-soft); }
.duty-cell--pressed { box-shadow: inset 0 0 0 2px var(--mg-color-brand-strong); }
.legend-items { display: flex; flex-wrap: wrap; gap: 16rpx 24rpx; margin-top: 24rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; color: var(--mg-color-text-secondary); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); }
.legend-dot { width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--mg-color-control-border); }
.legend-dot.selected { border-color: var(--mg-color-brand); }
.legend-dot.my-confirmed { border-color: var(--mg-color-success); }
.legend-dot.locked { border-color: var(--mg-color-warning); }

/* 日期、时间分层；预选和已确认复用表格的状态语义。 */
.section-label { min-height: 32px; margin: 16rpx 0; }
.label-text { font-size: var(--mg-font-label); line-height: var(--mg-line-label); font-weight: 600; }
.clear-btn, .remove-btn { display: flex; align-items: center; justify-content: center; min-width: 48px; min-height: 48px; padding: 0 8px; margin: 0; font-size: var(--mg-font-label); line-height: var(--mg-line-label); color: var(--mg-color-brand-strong); background: transparent; border-radius: var(--mg-radius-control); }
.clear-btn:active, .remove-btn:active { background: var(--mg-color-brand-selected); }
.mg-data-page .clear-btn { width: 80px; flex: 0 0 80px; margin: 0 0 0 auto; font-weight: 400; }
.remove-btn { width: 48px; flex: 0 0 48px; font-weight: 400; }
.selection-list { display: flex; flex-direction: column; gap: 16rpx; }
.selection-item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 16rpx 16rpx 24rpx; border-radius: var(--mg-radius-control); border: 1px solid var(--mg-color-border); }
.pre-selected { background: var(--mg-color-brand-soft); }
.selection-item.confirmed { background: var(--mg-color-bg-surface); }
.slot-info { flex: 1; min-width: 0; }
.slot-date { display: block; font-size: var(--mg-font-label); line-height: var(--mg-line-label); color: var(--mg-color-text-secondary); overflow-wrap: break-word; }
.slot-period { margin-left: 16rpx; }
.slot-time { display: block; margin-top: 4rpx; font-size: var(--mg-font-body); line-height: var(--mg-line-body); font-weight: 600; font-variant-numeric: tabular-nums; color: var(--mg-color-text-primary); }
.item-status, .confirmed-hint { font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); color: var(--mg-color-text-secondary); }
.item-status { flex-shrink: 0; color: var(--mg-color-brand-strong); }
.confirmed .item-status { color: var(--mg-color-success); }
.action-buttons { margin-top: 24rpx; }
.confirm-hint { display: block; margin-bottom: 16rpx; color: var(--mg-color-text-secondary); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); }
.mg-data-page .confirm-btn { width: 100%; min-height: 48px; padding: 12px 16px; font-size: var(--mg-font-body); line-height: var(--mg-line-body); font-weight: 600; }
.mg-data-page .confirm-btn:active { background: var(--mg-color-brand-pressed); }
.confirmed-area { margin-top: 24rpx; padding-top: 8rpx; border-top: 1px solid var(--mg-color-border); }
.empty-selection { padding: 24rpx; border-radius: var(--mg-radius-control); background: var(--mg-color-bg-page); }
.empty-text { display: block; font-size: var(--mg-font-body); line-height: var(--mg-line-body); color: var(--mg-color-text-secondary); }
.empty-hint { display: block; margin-top: 8rpx; font-size: var(--mg-font-label); line-height: var(--mg-line-label); color: var(--mg-color-text-muted); }
.loading-container, .error-container { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; min-height: 240px; padding: 32rpx; border-radius: var(--mg-radius-card); background: var(--mg-color-bg-surface); }
.error-icon { width: 48px; height: 48px; }
.error-text { font-size: var(--mg-font-body); line-height: var(--mg-line-body); color: var(--mg-color-text-secondary); text-align: center; }
.retry-btn { padding: 12px 24px; min-height: 48px; font-size: var(--mg-font-body); line-height: var(--mg-line-body); color: var(--mg-color-on-brand); background: var(--mg-color-brand); }
.retry-btn:active { background: var(--mg-color-brand-pressed); }
@media (max-width: 360px) {
  .roster-page { padding-left: 16rpx; padding-right: 16rpx; }
  .header, .schedule-panel, .selection-container { padding: 20rpx; }
  .panel-heading { gap: 8rpx; }
}
