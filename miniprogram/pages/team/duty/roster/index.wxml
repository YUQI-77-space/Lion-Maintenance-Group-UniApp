<scroll-view class="unified-page-scroll" scroll-y enhanced enable-back-to-top scroll-top="{{unifiedScrollTop}}" scroll-with-animation refresher-enabled refresher-default-style="none" refresher-triggered="{{unifiedRefreshing}}" bindrefresherrefresh="onUnifiedRefresh" bindscroll="onUnifiedScroll" bindscrolltolower="onUnifiedBottom" lower-threshold="50">
<view slot="refresher" class="unified-refresher"><loading-animation wx:if="{{unifiedRefreshing}}" size="small" /></view>
<!--pages/team/duty/roster/index.wxml-->
<view class="mg-theme mg-data-page roster-page">
  <view class="header">
    <view class="week-heading">
      <text class="main-title">第 {{currentWeek}} 周</text>
      <text wx:if="{{isDataReady}}" class="edit-status {{configData.isEditingEnabled ? '' : 'edit-status--closed'}}">{{configData.isEditingEnabled ? '开放预选' : '仅供查看'}}</text>
    </view>
    <text class="date-range" wx:if="{{weekDateRange}}">{{weekDateRange}}</text>
    <view class="stats-info" wx:if="{{isDataReady}}">
      <text>可选 <text class="stat-value">{{availableSlots}}</text> 段</text>
      <text class="meta-divider">·</text>
      <text>已排 <text class="stat-value">{{assignedSlots}}</text> 段</text>
      <text class="week-rule">每人每周最多 3 段</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <loading-animation size="default"></loading-animation>
  </view>

  <!-- 错误状态 -->
  <view class="error-container" wx:if="{{hasError && !isLoading}}">
    <image class="error-icon" src="{{iconEmpty}}" mode="aspectFit"></image>
    <text class="error-text">{{errorMessage}}</text>
    <button class="retry-btn" bindtap="retryLoadData">重新加载</button>
  </view>

  <view class="mg-page-notice" wx:if="{{confirmationMessage}}">{{confirmationMessage}}</view>
  <!-- 值班表格 -->
  <view class="schedule-panel" wx:if="{{isDataReady && !isLoading}}">
    <view class="panel-heading"><text class="section-title">本周排班</text><text class="scroll-hint">左右滑动查看日期 →</text></view>
    <text class="panel-description">{{configData.isEditingEnabled ? '点击可选时段预选，再到下方核对确认。' : '本周预选已关闭，可查看排班与个人时段。'}}</text>
    <view class="duty-table-container">
    <view class="duty-table">
      <!-- 左侧固定列 -->
      <view class="fixed-column">
        <!-- 固定表头 -->
        <view class="fixed-header-cell">
          <text class="header-text">时间段</text>
        </view>

        <!-- 固定时间列 -->
        <view class="fixed-time-cell" wx:for="{{tableData}}" wx:key="index" wx:for-item="timeSlotData">
          <text class="time-slot-name">{{timeSlotData.timeSlotInfo.name}}</text>
          <text class="time-range">{{timeSlotData.timeSlotInfo.startTime}}-{{timeSlotData.timeSlotInfo.endTime}}</text>
        </view>
      </view>

      <!-- 右侧滚动区域 -->
      <scroll-view class="scrollable-area" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="scrollable-content">
          <!-- 滚动表头 -->
          <view class="scrollable-header-row">
            <view class="header-cell" wx:for="{{weekDates}}" wx:key="dayOfWeek">
              <text class="day-name">{{item.dayName}}</text>
              <text class="day-date">{{item.dateDisplay}}</text>
            </view>
          </view>

          <!-- 滚动内容行 -->
          <view class="scrollable-content-row" wx:for="{{tableData}}" wx:key="index" wx:for-item="timeSlotData" wx:for-index="rowIndex">
            <view class="duty-cell {{slotData.statusClass}} {{slotData.status === 'confirmed' ? 'my-confirmed' : ''}}"
                  wx:for="{{timeSlotData.dailySlots}}" wx:key="dayOfWeek" wx:for-item="slotData" wx:for-index="colIndex"
                  data-row-index="{{rowIndex}}" data-col-index="{{colIndex}}"
                  bindtap="onSlotTap" hover-class="{{slotData.canSelect ? 'duty-cell--pressed' : 'none'}}"
                  aria-role="{{slotData.canSelect ? 'button' : 'text'}}"
                  aria-label="{{weekDates[colIndex].dayName}} {{weekDates[colIndex].dateDisplay}} {{timeSlotData.timeSlotInfo.name}} {{timeSlotData.timeSlotInfo.startTime}}至{{timeSlotData.timeSlotInfo.endTime}} {{slotData.statusText}}">
              <text class="slot-check" wx:if="{{slotData.status === 'selected' || slotData.status === 'preSelected' || slotData.status === 'confirmed'}}">✓</text>
              <text class="slot-text">{{slotData.statusText}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
    </view>
    <view class="legend-items">
      <view class="legend-item"><view class="legend-dot can-duty"></view><text>可选</text></view>
      <view class="legend-item"><view class="legend-dot selected"></view><text>预选</text></view>
      <view class="legend-item"><view class="legend-dot my-confirmed"></view><text>已确认</text></view>
      <view class="legend-item"><view class="legend-dot assigned"></view><text>他人占用</text></view>
      <view class="legend-item"><view class="legend-dot no-duty"></view><text>休假</text></view>
      <view class="legend-item"><view class="legend-dot locked"></view><text>操作中</text></view>
    </view>
  </view>

  <!-- 预选区域 -->
  <view class="selection-container" wx:if="{{isDataReady && !isLoading && userSlots}}">
    <view class="panel-heading">
      <text class="section-title">我的值班</text>
      <text class="selection-count">{{selectedSlots.length + userSlots.confirmedSlots.length + userSlots.preSelectedSlots.length}} / 3 段</text>
    </view>
    <text class="panel-description">已确认与待确认时段合计计入每周上限。</text>

    <!-- 当前预选项 -->
    <view class="pre-selection-area" wx:if="{{selectedSlots.length > 0}}">
      <view class="section-label">
        <text class="label-text">当前预选 · {{selectedSlots.length}} 段</text>
        <button class="clear-btn" wx:if="{{configData.isEditingEnabled}}" bindtap="clearSelection" disabled="{{confirming}}">清空预选</button>
      </view>
             <view class="selection-list">
         <view class="selection-item pre-selected" wx:for="{{selectedSlotsDisplay}}" wx:key="dutySlotId">
           <view class="slot-info"><text class="slot-date">{{item.date}}<text class="slot-period">{{item.timeSlot}}</text></text><text class="slot-time">{{item.startTime}}–{{item.endTime}}</text></view>
           <button class="remove-btn" wx:if="{{configData.isEditingEnabled}}" data-slot-id="{{item.dutySlotId}}" data-slot-type="preSelected" bindtap="removeUserSlot" disabled="{{confirming}}" aria-label="移除{{item.date}} {{item.timeSlot}} {{item.startTime}}至{{item.endTime}}预选">移除</button>
         </view>
       </view>

    </view>

    <!-- 已确认的时间段 -->
    <view class="confirmed-area" wx:if="{{userSlots.confirmedSlots.length > 0}}">
      <view class="section-label">
        <text class="label-text">已确认 · {{userSlots.confirmedSlots.length}} 段</text>
        <text class="confirmed-hint">不可自行取消</text>
      </view>
      <view class="selection-list">
        <view class="selection-item confirmed" wx:for="{{userSlots.confirmedSlots}}" wx:key="dutySlotId">
          <view class="slot-info"><text class="slot-date">{{item.date}}<text class="slot-period">{{item.timeSlot}}</text></text><text class="slot-time">{{item.startTime}}–{{item.endTime}}</text></view>
          <text class="item-status">✓ 已确认</text>
        </view>
      </view>
    </view>

    <!-- 之前预选但未确认的时间段 -->
    <view class="pre-selected-area" wx:if="{{userSlots.preSelectedSlots.length > 0}}">
      <view class="section-label">
        <text class="label-text">待确认 · {{userSlots.preSelectedSlots.length}} 段</text>
      </view>
      <view class="selection-list">
        <view class="selection-item pre-selected" wx:for="{{userSlots.preSelectedSlots}}" wx:key="dutySlotId">
          <view class="slot-info"><text class="slot-date">{{item.date}}<text class="slot-period">{{item.timeSlot}}</text></text><text class="slot-time">{{item.startTime}}–{{item.endTime}}</text></view>
          <text class="item-status">待确认</text>
        </view>
      </view>

    </view>
    <view class="action-buttons" wx:if="{{configData.isEditingEnabled && (selectedSlots.length > 0 || userSlots.preSelectedSlots.length > 0)}}">
      <text class="confirm-hint">确认后不可自行取消，请核对日期与时间。</text>
      <button class="confirm-btn" bindtap="confirmSelection" disabled="{{confirming}}"><loading-animation wx:if="{{confirming}}" size="small" /><text wx:else>{{'核对并确认时段'}}</text></button>
    </view>

    <!-- 空状态 -->
    <view class="empty-selection" wx:if="{{selectedSlots.length === 0 && userSlots.confirmedSlots.length === 0 && userSlots.preSelectedSlots.length === 0}}">
      <text class="empty-text">本周还没有选择时段</text>
      <text class="empty-hint" wx:if="{{configData.isEditingEnabled}}">从上方表格选择，预选会显示在这里。</text>
      <text class="empty-hint" wx:if="{{!configData.isEditingEnabled}}">当前周编辑权限已关闭，无法进行值班选择</text>
    </view>
  </view>

</view>
</scroll-view>
<loading-overlay id="global-loading" />
