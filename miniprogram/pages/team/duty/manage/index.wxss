@import "/styles/data-pages.wxss";
/* pages/team/duty/manage/index.wxss */
@import "/styles/variables.wxss";

.container {
  --manage-table-row-height: 80px;
  --manage-table-header-height: 64px;
  --manage-table-column-width: 80px;
  padding: 24rpx;
  background-color: var(--mg-color-bg-page);
  height: 100vh;
  min-height: 0;
  position: relative;
}

/* 顶部标签导航 */
.tab-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 10rpx 20rpx;
  margin-bottom: 10rpx;
  background: transparent;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  margin: 0 8rpx;
  transition: background-color var(--mg-motion-press) ease-out;
}

.tab-title {
  font-size: var(--mg-font-label);
  color: var(--text-secondary);
}

.tab-item.active {
  background: var(--mg-color-brand-selected);
  box-shadow: none;
}

.tab-item.active .tab-title {
  color: var(--primary-color);
  font-weight: 600;
}

.tab-swiper {
  flex: 1;
  min-height: 0;
  height: 0;
}

/* 每页独立纵向滚动：swiper 高度固定，内容超出时仍可滚动查看 */
.page-scroll {
  height: 100%;
}

.page-section {
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

.page-duty {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 0 0 calc(32rpx + env(safe-area-inset-bottom));
}

/* 删除模式下为固定操作栏留出空间 */
.page-duty.in-delete-mode {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.page-header {
  background: var(--mg-color-bg-surface);
  border-radius: var(--mg-radius-card);
  padding: 32rpx;
  border: 1px solid var(--mg-color-border);
}

/* 标题行 */
.page-title-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

/* 页面底部的独立操作区 */
.page-action-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0 8rpx;
}

.delete-entry-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--danger-color);
  background: rgba(255, 77, 79, 0.06);
  color: var(--danger-color);
}

.delete-entry-btn:active {
  background: rgba(255, 77, 79, 0.16);
}

.delete-entry-btn .entry-icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.delete-entry-btn .entry-text {
  font-size: var(--mg-font-body);
  font-weight: 600;
  line-height: 1;
}

.page-action-area .entry-hint {
  font-size: var(--mg-font-caption);
  color: var(--text-placeholder);
}

.page-main-title {
  font-size: var(--mg-font-title); line-height: var(--mg-line-title);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
}

.page-date-range {
  font-size: var(--mg-font-label);
  color: var(--text-regular);
}

.page-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.page-stat-chip {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--mg-font-caption);
  color: var(--text-secondary);
  background: var(--background-color);
}

.page-stat-chip.warning {
  color: var(--warning-color);
  background: rgba(249, 115, 22, 0.06);
}

.header {
  background: var(--card-background);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--box-shadow);
}

.title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: var(--mg-font-label);
  color: var(--text-regular);
}

/* 管理操作区域 */
.management-section {
  background: var(--card-background);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--box-shadow);
}

.section-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
  margin-bottom: 25rpx;
}

/* 2*2按钮网格布局 */
.button-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.grid-row {
  display: flex;
  gap: 20rpx;
}

.grid-button {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  background: transparent;
  border: 2rpx solid var(--border-light);
  border-radius: 12rpx;
  font-size: var(--mg-font-label);
  color: var(--text-main);
  transition: all 0.3s;
  position: relative;
  min-height: 150rpx;
}

.grid-button:not([disabled]):active {
  transform: scale(0.98);
  border-color: var(--primary-color);
  background: rgba(58, 117, 251, 0.05);
}

.grid-button[disabled] {
  border-color: var(--border-light);
  color: var(--text-secondary);
}

.grid-button[disabled] .button-icon {
  opacity: 0.5;
}

/* 编辑权限按钮特殊样式 */
.grid-button.permission-enabled {
  border-color: var(--success-color);
  color: var(--success-color);
}

.grid-button.permission-disabled {
  border-color: var(--info-color);
  color: var(--info-color);
}

.grid-button.permission-enabled:not([disabled]):active {
  border-color: var(--success-color);
  background: rgba(103, 194, 58, 0.05);
}

.grid-button.permission-disabled:not([disabled]):active {
  border-color: var(--info-color);
  background: rgba(154, 163, 178, 0.05);
}

.permission-status {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 12rpx;
  font-size: var(--mg-font-caption);
  font-weight: var(--mg-weight-semibold);
  background: rgba(0, 0, 0, 0.1);
  color: inherit;
}

.button-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 12rpx;
}

.button-text {
  font-size: var(--mg-font-label);
  font-weight: var(--mg-weight-semibold);
  text-align: center;
  line-height: 1.2;
}

/* 简化的弹窗样式 */
.simple-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
}

.modal-content {
  background: var(--card-background);
  border-radius: 16rpx;
  padding: 40rpx;
  margin: 0 40rpx;
  max-width: 600rpx;
  width: 100%;
  position: relative;
  box-shadow: var(--box-shadow);
}

.modal-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
  display: block;
  margin-bottom: 10rpx;
}

.modal-subtitle {
  font-size: var(--mg-font-label);
  color: var(--text-regular);
  display: block;
}

/* 日期选择器样式 */
.picker-container,
.week-picker-section {
  margin: 30rpx 0;
}

.picker-display {
  display: flex;
  align-items: center;
  padding: 25rpx 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-light);
  transition: all 0.3s;
}

.picker-display:active {
  background: var(--border-light);
}

.picker-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.picker-text {
  flex: 1;
  font-size: var(--mg-font-body);
  color: var(--text-main);
  text-align: center;
}

/* 警告区域样式 */
.warning-section {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 152, 0, 0.1);
  border-radius: 8rpx;
  border-left: 4rpx solid var(--warning-color);
  margin: 20rpx 0;
}

.warning-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.warning-text {
  font-size: var(--mg-font-label);
  color: var(--warning-color);
  line-height: 1.5;
  flex: 1;
}

/* 权限预览样式 */
.permission-preview {
  background: var(--background-color);
  padding: 20rpx;
  border-radius: 8rpx;
  margin: 20rpx 0;
}

.status-change {
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: center;
}

.status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15rpx 12rpx;
  border-radius: 12rpx;
}

.status-item.enabled {
  color: var(--success-color);
  background: rgba(103, 194, 58, 0.1);
}

.status-item.disabled {
  color: var(--info-color);
  background: rgba(154, 163, 178, 0.1);
}

.status-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.status-text {
  font-size: var(--mg-font-caption);
  font-weight: var(--mg-weight-semibold);
  text-align: center;
  line-height: 1.2;
}

.arrow {
  font-size: 32rpx;
  color: var(--primary-color);
  margin: 0 20rpx;
  font-weight: var(--mg-weight-semibold);
}

/* 弹窗按钮样式 */
.modal-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-button {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: var(--mg-font-body);
  border: none;
  transition: all 0.3s;
  position: relative;
  /* 移除按钮默认样式和图标 */
  background-image: none !important;
  background-color: transparent;
  text-align: center;
  line-height: 80rpx;
  padding: 0;
  margin: 0;
  /* 移除伪元素可能的图标 */
}

.modal-button::before,
.modal-button::after {
  display: none !important;
  content: none !important;
}

.modal-button.cancel {
  background: var(--border-light) !important;
  color: var(--text-regular);
  border: 1rpx solid var(--border-light);
}

.modal-button.cancel:active {
  background: var(--border-color) !important;
}

.modal-button.confirm {
  background: var(--primary-color) !important;
  color: white;
  border: 1rpx solid var(--primary-color);
}

.modal-button.confirm:active {
  background: #0056cc !important;
}

.modal-button.confirm[disabled] {
  background: var(--border-light) !important;
  color: var(--text-secondary);
  border: 1rpx solid var(--border-light);
}

/* 危险操作按钮样式 */
.modal-button.confirm.danger {
  background: var(--danger-color) !important;
  color: white;
  border: 1rpx solid var(--danger-color);
}

.modal-button.confirm.danger:active {
  background: #c73531 !important;
}

/* 配置显示区域 */
.config-section {
  background: var(--card-background);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--box-shadow);
}

.config-card {
  background: var(--background-color);
  padding: 20rpx;
  border-radius: 12rpx;
}

.config-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  min-height: 72rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.config-item:last-child {
  border-bottom: none;
}

.config-label {
  font-size: var(--mg-font-label);
  color: var(--text-regular);
}

.config-value {
  font-size: var(--mg-font-body);
  color: var(--text-main);
  font-weight: var(--mg-weight-semibold);
}

.config-value.enabled {
  color: var(--success-color);
}

.config-value.disabled {
  color: var(--danger-color);
}

.config-value.locked {
  color: var(--danger-color);
}

.config-value.unlocked {
  color: var(--success-color);
}

/* 进度显示 */
.progress-section {
  background: var(--card-background);
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--box-shadow);
}

.progress-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
  border-radius: 12rpx;
}


/* 加载遮罩 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background: var(--card-background);
  padding: 40rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 600rpx;
  margin: 0 20rpx;
}


/* 值班表格区域样式 - 完全复刻值班表样式 */
.duty-table-section {
  background-color: var(--background-color);
  padding: 0;
}

/* 自动切周弹窗布局 */
.auto-switch-section {
  margin: 20rpx 0 10rpx;
  padding: 20rpx;
  background: var(--background-color);
  border-radius: 12rpx;
  border: 1rpx solid var(--border-light);
}

.auto-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.auto-switch-row + .auto-switch-row {
  border-top: 1rpx solid var(--border-light);
}

.auto-switch-label {
  font-size: var(--mg-font-label);
  color: var(--text-main);
}

/* 页面头部 */
.duty-table-section .header {
  background: var(--card-background);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--box-shadow);
}

.duty-table-section .title-section {
  margin-bottom: 20rpx;
}

.duty-table-section .main-title {
  font-size: var(--mg-font-title); line-height: var(--mg-line-title);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
  display: block;
  margin-bottom: 8rpx;
}

.duty-table-section .date-range {
  font-size: var(--mg-font-label);
  color: var(--text-regular);
}

.duty-table-section .stats-info {
  display: flex;
  gap: 30rpx;
}

.duty-table-section .stat-item {
  font-size: var(--mg-font-caption);
  color: var(--text-secondary);
  padding: 8rpx 16rpx;
  background: var(--background-color);
  border-radius: 8rpx;
}

/* 表格加载和错误状态 */
.table-loading-container,
.table-error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  background: var(--card-background);
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.table-error-container .error-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.table-error-container .error-text {
  font-size: var(--mg-font-body);
  color: var(--text-regular);
  margin-bottom: 20rpx;
}

.table-error-container .retry-btn {
  background: var(--primary-color);
  color: #fff;
  border-radius: 8rpx;
  padding: 12rpx 24rpx;
  font-size: var(--mg-font-label);
}

/* 时间轴和日期区共用尺寸；状态只改底色，避免网格错位。 */
.table-guide { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; margin-bottom: 24rpx; font-size: var(--mg-font-section); line-height: var(--mg-line-section); font-weight: 600; }
.table-scroll-hint { color: var(--mg-color-text-secondary); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); font-weight: 400; }
.duty-table-container { width: 100%; background: var(--mg-color-bg-surface); border: 1px solid var(--mg-color-control-border); border-radius: var(--mg-radius-control); overflow: hidden; }
.duty-table { display: flex; width: 100%; }
.fixed-column { flex: 0 0 96px; width: 96px; background: var(--mg-color-bg-surface); border-right: 1px solid var(--mg-color-control-border); }
.fixed-header-cell, .header-cell { height: var(--manage-table-header-height); padding: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--mg-color-bg-subtle); border-bottom: 1px solid var(--mg-color-control-border); }
.header-text, .day-name, .time-slot-name { color: var(--mg-color-text-primary); font-size: var(--mg-font-label); line-height: var(--mg-line-label); font-weight: 600; }
.fixed-time-cell { height: var(--manage-table-row-height); padding: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-bottom: 1px solid var(--mg-color-control-border); }
.time-range { margin-top: 8rpx; color: var(--mg-color-text-secondary); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); white-space: nowrap; font-variant-numeric: tabular-nums; }
.scrollable-area { flex: 1; width: 0; min-width: 0; }
.scrollable-content { width: calc(7 * var(--manage-table-column-width)); }
.scrollable-header-row, .scrollable-content-row { display: flex; }
.header-cell, .duty-cell { flex: 0 0 var(--manage-table-column-width); width: var(--manage-table-column-width); border-right: 1px solid var(--mg-color-control-border); }
.day-date { margin-top: 8rpx; color: var(--mg-color-text-secondary); font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); font-variant-numeric: tabular-nums; }
.duty-cell { height: var(--manage-table-row-height); padding: 8px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--mg-color-control-border); position: relative; }
.header-cell:last-child, .duty-cell:last-child { border-right: 0; }
.fixed-time-cell:last-child, .scrollable-content-row:last-child .duty-cell { border-bottom: 0; }
.slot-text { font-size: var(--mg-font-label); line-height: var(--mg-line-label); text-align: center; overflow-wrap: anywhere; }
.duty-cell.can-duty { background: var(--mg-color-bg-surface); color: var(--mg-color-brand-strong); }
.duty-cell.assigned { background: var(--mg-color-success-soft); color: var(--mg-color-success); }
.duty-cell.assigned .slot-text { font-weight: 600; }
.duty-cell.no-duty { background: var(--mg-color-bg-subtle); color: var(--mg-color-text-muted); }
.duty-cell.locked { background: var(--mg-color-warning-soft); color: var(--mg-color-warning); }
.legend-inline { margin-top: 24rpx; padding-top: 24rpx; border-top: 1px solid var(--mg-color-border); }
.legend-items { display: flex; flex-wrap: wrap; gap: 16rpx 32rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 12px; height: 12px; border-radius: 3px; border: 1px solid var(--mg-color-control-border); }
.legend-dot.can-duty { background: var(--mg-color-bg-surface); }
.legend-dot.assigned { background: var(--mg-color-success-soft); border-color: var(--mg-color-success); }
.legend-dot.no-duty { background: var(--mg-color-bg-subtle); }
.legend-text { font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); color: var(--mg-color-text-secondary); }

/* ============ 设置页样式 ============ */

.page-settings {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.settings-card {
  background: var(--card-background);
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  box-shadow: var(--box-shadow);
  border: 2rpx solid #191970;
}

.settings-card-primary {
  margin-top: 10rpx;
}

.settings-card-warning {
  background: var(--card-background);
  border-radius: 20rpx;
  border: 2rpx solid #FF0000; /* 危险区域红色描边 */
}

.settings-card-header {
  margin-bottom: 18rpx;
}

.settings-card-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: 600;
  color: var(--text-main);
}

.settings-card-subtitle {
  display: none;
}

.settings-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.settings-row-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.settings-label {
  font-size: var(--mg-font-label);
  color: var(--text-regular);
}

.settings-value {
  margin-top: 4rpx;
  font-size: var(--mg-font-body);
  color: var(--text-main);
  font-weight: 500;
}

.settings-btn {
  min-width: 160rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: var(--mg-font-label);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.settings-btn.primary {
  background: var(--primary-color);
  color: #ffffff;
}

.settings-btn.ghost {
  background: transparent;
  color: var(--primary-color);
  border: 2rpx solid var(--primary-color);
}

.settings-btn.danger {
  background: var(--danger-color);
  color: #ffffff;
}

.settings-btn.full {
  width: 100%;
  margin-top: 12rpx;
}

.settings-btn.block {
  width: 100%;
  margin-top: 16rpx;
}

.settings-btn[disabled] {
  background: var(--border-light);
  color: var(--text-secondary);
  border-color: var(--border-light);
}

.settings-card-row {
  display: flex;
  gap: 20rpx;
}

.settings-card.mini {
  flex: 1;
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.settings-card-hover {
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.settings-toggle-pill {
  margin-top: 12rpx;
  align-self: flex-start;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: var(--mg-font-caption);
  font-weight: 600;
}

.settings-toggle-pill.on {
  background: rgba(22, 163, 74, 0.08);
  color: var(--success-color);
}

.settings-toggle-pill.off {
  background: rgba(148, 163, 184, 0.08);
  color: var(--text-secondary);
}

.toggle-text {
  text-align: center;
}

.auto-switch-summary {
  margin-top: 10rpx;
}

.auto-switch-status {
  font-size: var(--mg-font-caption);
  font-weight: 600;
}

.auto-switch-status.on {
  color: var(--success-color);
}

.auto-switch-status.off {
  color: var(--text-secondary);
}

.auto-switch-detail {
  margin-top: 4rpx;
  font-size: var(--mg-font-caption);
  color: var(--text-regular);
}

/* ============ 当前配置页样式 ============ */

.page-config {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.config-summary-card {
  margin-top: 10rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e0edff, #f4f7ff);
  box-shadow: var(--box-shadow);
  border: 2rpx solid #191970;
}

.config-summary-line + .config-summary-line {
  margin-top: 10rpx;
}

.config-summary-label {
  font-size: var(--mg-font-caption);
  color: var(--text-regular);
}

.config-summary-value {
  margin-top: 2rpx;
  font-size: var(--mg-font-body);
  font-weight: 600;
  color: var(--text-main);
}

.config-detail-card {
  background: var(--card-background);
  border-radius: 18rpx;
  padding: 22rpx 26rpx;
  box-shadow: var(--box-shadow);
  margin-top: 4rpx;
  border: 2rpx solid #191970;
}

/* ============ 危险设置区域样式 ============ */

/* 危险设置外层 */
.settings-danger-wrapper {
  margin-top: 10rpx;
}

.danger-toggle-bar {
  width: 100%;
  margin: 8rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #191970;
  background: var(--card-background);
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.danger-toggle-text {
  font-size: var(--mg-font-body);
  color: #191970;
  font-weight: 600;
}

/* ============ 删除模式：提示条与底部操作栏 ============ */

/* 删除模式提示条 */
.delete-mode-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--warning-color);
  background: rgba(250, 173, 20, 0.1);
}

.delete-mode-banner .banner-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.delete-mode-banner .banner-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.delete-mode-banner .banner-texts {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.delete-mode-banner .banner-title {
  font-size: var(--mg-font-label);
  font-weight: var(--mg-weight-semibold);
  color: #b45309;
  white-space: nowrap;
}

.delete-mode-banner .banner-desc {
  font-size: var(--mg-font-caption);
  color: var(--text-regular);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.delete-mode-banner .banner-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.delete-mode-banner .banner-link {
  font-size: var(--mg-font-caption);
  font-weight: 600;
  color: var(--primary-color);
  padding: 6rpx 4rpx;
}

.delete-mode-banner .banner-link.disabled {
  color: var(--text-placeholder);
}

.delete-mode-banner .banner-sep {
  font-size: var(--mg-font-caption);
  color: var(--border-light);
}

/* 固定底部操作栏 */
.delete-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--card-background);
  border-top: 2rpx solid var(--border-color);
}

.delete-bottom-bar .bar-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
}

.delete-bottom-bar .bar-count {
  font-size: var(--mg-font-body);
  font-weight: 600;
  color: var(--text-main);
  white-space: nowrap;
}

.delete-bottom-bar .bar-num {
  font-size: var(--mg-font-body);
  font-weight: var(--mg-weight-semibold);
  color: var(--danger-color);
}

.delete-bottom-bar .bar-hint {
  font-size: var(--mg-font-caption);
  color: var(--text-placeholder);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.delete-bottom-bar .bar-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 0 0 auto;
}

.delete-bottom-bar .bar-btn {
  flex: 0 0 auto;
  min-width: 176rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: var(--mg-font-body);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.delete-bottom-bar .bar-btn.ghost {
  background: transparent;
  color: var(--text-regular);
  border: 2rpx solid var(--border-light);
}

.delete-bottom-bar .bar-btn.ghost:active {
  background: var(--background-color);
}

.delete-bottom-bar .bar-btn.danger {
  background: var(--danger-color);
  color: #ffffff;
}

.delete-bottom-bar .bar-btn.danger:active {
  background: #d9363e;
}

.delete-bottom-bar .bar-btn.is-disabled {
  background: var(--border-light);
  color: var(--text-secondary);
  border-color: var(--border-light);
  pointer-events: none;
}

/* ============ 删除功能相关样式 ============ */

/* 内描边不参与尺寸计算，删除选择不挤压相邻行列。 */
.duty-cell.selectable { box-shadow: inset 0 0 0 1px var(--mg-color-warning); }
.duty-cell.selectable:active { background: var(--mg-color-warning-soft); }
.duty-cell.dimmed { opacity: 0.4; }
.duty-cell.selected { background: var(--mg-color-brand-selected); color: var(--mg-color-brand-strong); box-shadow: inset 0 0 0 2px var(--mg-color-brand); }

.select-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--mg-color-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.select-badge .badge-icon {
  width: 22rpx;
  height: 22rpx;
  filter: brightness(0) invert(1);
}

/* 删除预览弹窗样式 */
.delete-preview {
  margin: 20rpx 0;
  max-height: 400rpx;
}

.preview-header {
  margin-bottom: 15rpx;
}

.preview-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
}

.delete-list {
  max-height: 300rpx;
  background: var(--background-color);
  border-radius: 8rpx;
  padding: 10rpx;
}

.delete-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  background: var(--card-background);
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  box-shadow: var(--box-shadow);
}

.delete-item:last-child {
  margin-bottom: 0;
}

.delete-item-time {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.day-info {
  font-size: var(--mg-font-label);
  font-weight: var(--mg-weight-semibold);
  color: var(--text-main);
}

.time-info {
  font-size: var(--mg-font-caption);
  color: var(--text-regular);
}

.delete-item-user {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 5rpx;
}

.user-name {
  font-size: var(--mg-font-body);
  font-weight: var(--mg-weight-semibold);
  color: var(--primary-color);
}

.status-tag {
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  font-size: var(--mg-font-caption);
  font-weight: var(--mg-weight-semibold);
}

.status-tag.confirmed {
  background: rgba(46, 125, 46, 0.1);
  color: var(--success-color);
}

.status-tag.preselected {
  background: rgba(230, 81, 0, 0.1);
  color: var(--warning-color);
}
