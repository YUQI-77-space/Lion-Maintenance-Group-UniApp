@import "../../../styles/design-tokens.wxss";
/* components/charts/pie-chart/index.wxss */
.chart-root {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.chart-canvas-wrap {
  width: 100%;
  display: flex;
  justify-content: center;
}

.pie-canvas {
  display: block;
}

.legend-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 26rpx;
  color: var(--mg-color-text-primary);
  white-space: nowrap;
  text-overflow: ellipsis;
}

.legend-percent {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: var(--mg-color-text-primary);
}


.legend-name { white-space: normal; overflow-wrap: break-word; }
