@import "/styles/design-tokens.wxss";
:host { display: inline-flex; vertical-align: middle; flex-shrink: 0; }
.loading-animation { --loader-unit: 1px; display: flex; align-items: center; justify-content: center; color: #000; }
.loading-animation.small { --loader-unit: .48px; }
.loading-animation.large { --loader-unit: 1.28px; }
.loading-animation.inverse { color: var(--mg-color-on-brand); }
.loading-stage { position: relative; width: calc(50 * var(--loader-unit)); height: calc(54 * var(--loader-unit)); perspective: calc(200 * var(--loader-unit)); }
.loading-square { position: absolute; bottom: calc(4 * var(--loader-unit)); width: calc(20 * var(--loader-unit)); height: calc(20 * var(--loader-unit)); background: currentColor; opacity: .55; animation: loading-square-lift .5s ease-in-out infinite alternate; }
.loading-square:first-child { left: 0; }
.loading-square:last-child { right: 0; animation-delay: .15s; }
@keyframes loading-square-lift {
  from { transform: scale(1) translateY(0) rotateX(0); opacity: .55; box-shadow: 0 0 0 transparent; }
  to { transform: scale(1.2) translateY(calc(-25 * var(--loader-unit))) rotateX(45deg); opacity: 1; box-shadow: 0 calc(25 * var(--loader-unit)) calc(40 * var(--loader-unit)) rgba(0,0,0,.16); }
}
.paused .loading-square { animation-play-state: paused; }
.static .loading-square { animation: none; opacity: 1; }
@media (prefers-reduced-motion: reduce) { .loading-square { animation: none; opacity: 1; } }
