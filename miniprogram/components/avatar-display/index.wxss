@import "../../styles/design-tokens.wxss";

.avatar-host { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; vertical-align: middle; font-family: var(--mg-font-family); }
.avatar-host-clickable { min-width: var(--mg-size-touch-target-min); min-height: var(--mg-size-touch-target-min); }
.avatar-container { box-sizing: border-box; position: relative; display: block; flex-shrink: 0; overflow: hidden; border-radius: var(--mg-radius-avatar); background: var(--mg-color-bg-subtle); }
.avatar-small { width: var(--mg-size-avatar-sm); height: var(--mg-size-avatar-sm); }
.avatar-medium { width: var(--mg-size-avatar-md); height: var(--mg-size-avatar-md); }
.avatar-large { width: var(--mg-size-avatar-lg); height: var(--mg-size-avatar-lg); }
/* 兼容已有 xlarge 属性值；当前无页面消费者，不在阶段 2 删除。 */
.avatar-xlarge { width: 200rpx; height: 200rpx; }
.with-border { border: var(--mg-border-width) solid var(--mg-color-border); }
.avatar-image { position: absolute; top: 0; left: 0; display: block; width: 100%; height: 100%; border-radius: inherit; }
.avatar-fallback { position: absolute; top: 0; left: 0; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: var(--mg-color-bg-subtle); color: var(--mg-color-text-muted); font-size: var(--mg-font-caption); line-height: 1.5; }
.avatar-placeholder-head { position: absolute; width: 24%; height: 24%; top: 20%; left: 38%; border-radius: var(--mg-radius-avatar); background: var(--mg-color-text-muted); }
.avatar-placeholder-body { position: absolute; width: 52%; height: 32%; left: 24%; bottom: 18%; border-radius: var(--mg-radius-pill); background: var(--mg-color-text-muted); }
.click-overlay { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; opacity: 0; background: var(--mg-color-brand); color: var(--mg-color-on-brand); transition: opacity var(--mg-motion-press) var(--mg-motion-easing); }
.avatar-pressed .click-overlay { opacity: 1; }
.click-hint { font-size: var(--mg-font-caption); line-height: var(--mg-line-caption); }
.avatar-container.list-avatar, .avatar-container.member-avatar { margin-right: var(--mg-space-3); }
.avatar-container.card-avatar { margin-bottom: var(--mg-space-2); }
.avatar-container.ranking-avatar { margin: var(--mg-space-1) auto; }
.avatar-container.participant-avatar { margin-right: var(--mg-space-3); }
@media (prefers-reduced-motion: reduce) { .click-overlay { transition: none; } }
