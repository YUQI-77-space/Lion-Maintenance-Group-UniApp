<!-- 图片仍由父页调用 showImage 放行；只统一加载与失败外观。 -->
<view class="skeleton-wrapper mg-theme {{showRealImage ? 'loaded' : ''}} {{loadError ? 'has-error' : ''}}">
  <view class="skeleton-placeholder" wx:if="{{!showRealImage && !loadError}}" style="background-color: {{placeholderColor}}"><text>图片加载中</text></view>
  <image class="actual-image {{showRealImage ? 'visible' : ''}}" src="{{src}}" mode="{{mode}}" lazy-load="{{lazyLoad}}" bindload="onImageLoad" binderror="onImageError" />
  <view class="error-placeholder" wx:if="{{loadError}}"><text>图片暂不可用</text></view>
</view>
