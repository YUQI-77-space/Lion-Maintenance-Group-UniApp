<view wx:if="{{visible}}" class="modal-mask {{bottom ? 'modal-bottom' : ''}}" catchtouchmove="stopPropagation" bindtap="onMaskTap">
  <view class="modal-panel" role="dialog" aria-label="{{title}}" catchtap="stopPropagation">
    <view wx:if="{{bottom}}" class="modal-handle" />
    <view class="modal-heading"><view class="modal-title">{{title}}</view><view wx:if="{{subtitle}}" class="modal-subtitle">{{subtitle}}</view></view>
    <scroll-view class="modal-body" scroll-y><slot /></scroll-view>
    <view class="modal-actions"><button class="modal-button modal-cancel" bindtap="cancel" disabled="{{loading}}">{{cancelText}}</button><button class="modal-button modal-confirm {{danger ? 'modal-danger' : ''}}" bindtap="confirm" loading="{{loading}}" disabled="{{loading || disabled}}">{{loading ? '正在提交' : confirmText}}</button></view>
  </view>
</view>
