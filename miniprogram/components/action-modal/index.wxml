<view wx:if="{{visible}}" class="mg-theme modal-mask {{bottom ? 'modal-bottom' : ''}}" style="bottom: {{keyboardHeight}}px;" catchtouchmove="stopPropagation" bindtap="onMaskTap">
  <view class="modal-panel" role="dialog" aria-label="{{title}}" catchtap="stopPropagation">
    <view wx:if="{{bottom}}" class="modal-handle" />
    <view class="modal-heading"><view class="modal-title">{{title}}</view><view wx:if="{{subtitle}}" class="modal-subtitle">{{subtitle}}</view></view>
    <scroll-view class="modal-body" scroll-y><slot /></scroll-view>
    <view class="modal-actions"><button class="modal-button modal-cancel" bindtap="cancel" disabled="{{loading}}">{{cancelText}}</button><button class="modal-button modal-confirm {{danger ? 'modal-danger' : ''}}" bindtap="confirm" disabled="{{loading || disabled}}"><loading-animation wx:if="{{loading}}" size="small" /><text wx:else>{{confirmText}}</text></button></view>
  </view>
</view>
