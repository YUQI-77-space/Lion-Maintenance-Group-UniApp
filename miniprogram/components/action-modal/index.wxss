.modal-mask { position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 32rpx; box-sizing: border-box; background: rgba(18, 29, 52, .48); }
.modal-panel { width: 100%; max-width: 660rpx; max-height: 88vh; background: #fff; border-radius: 28rpx; overflow: hidden; display: flex; flex-direction: column; box-sizing: border-box; }
.modal-heading { padding: 36rpx 32rpx 24rpx; flex-shrink: 0; }
.modal-title { color: #202b40; font-size: 36rpx; font-weight: 600; line-height: 1.4; }
.modal-subtitle { margin-top: 12rpx; font-size: 24rpx; color: #788398; }
.modal-body { height: 560rpx; min-height: 0; max-height: 50vh; flex-shrink: 1; }
.modal-actions { display: flex; gap: 20rpx; padding: 28rpx 32rpx 32rpx; flex-shrink: 0; }
.modal-button { flex: 1; min-width: 0; width: 100%; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; font-size: 28rpx; font-weight: 500; line-height: 1.4; box-sizing: border-box; }
.modal-button::after { border: none; }
.modal-cancel { background: #f0f3f8; color: #4b5870; }
.modal-confirm { background: #3a75fb; color: #fff; }
.modal-danger { background: #d94343; }
.modal-button[disabled] { background: #edf0f5; color: #9aa4b5; }
.modal-bottom { align-items: flex-end; padding: 0; }
.modal-bottom .modal-panel { max-width: none; border-radius: 32rpx 32rpx 0 0; max-height: 80vh; }
.modal-handle { width: 64rpx; height: 8rpx; margin: 16rpx auto 0; border-radius: 8rpx; background: #dce2ec; flex-shrink: 0; }
.modal-bottom .modal-heading { padding-top: 20rpx; }
.modal-bottom .modal-body { height: 48vh; }
.modal-bottom .modal-actions { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
