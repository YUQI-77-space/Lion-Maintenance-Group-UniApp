/* ============================================
   通用组件样式 - 极简线框风格
   核心理念：线框 + 极简 + 功能导向
   ============================================ */
@import "./variables.wxss";

/* ==================== 页面容器 ==================== */
.page-container {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--space-md);
  box-sizing: border-box;
}

/* ==================== 卡片 - 无边框，靠间距区分 ==================== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
}

.card:last-child { margin-bottom: 0; }

/* ==================== 区块标题 ==================== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.section-title {
  font-size: var(--mg-font-section); line-height: var(--mg-line-section);
  font-weight: 600;
  color: var(--text-primary);
}

.section-more {
  font-size: var(--mg-font-label);
  color: var(--text-secondary);
}

/* ==================== 按钮 - 唯一需要边框的组件 ==================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  font-size: var(--mg-font-body);
  border-radius: var(--radius-btn);
  background: var(--mg-color-bg-surface);
  min-width: 48px; min-height: 48px;
  border: 1px solid var(--mg-color-control-border);
  transition: background-color 100ms ease-out;
}

.btn::after { border: none; }

.btn-primary {
  background: var(--mg-color-brand);
  border-color: var(--mg-color-brand);
  color: var(--mg-color-on-brand);
}

.btn-primary:active {
  background: var(--mg-color-brand-pressed);
  color: var(--mg-color-on-brand);
}

.btn-disabled {
  border-color: var(--border) !important;
  color: var(--text-muted) !important;
  background: var(--mg-color-bg-subtle) !important;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: var(--space-xs);
}

/* ==================== 表单 - 需要边框明确输入区域 ==================== */
.form-group { margin-bottom: var(--space-md); }
.form-group:last-child { margin-bottom: 0; }

.form-label {
  display: block;
  margin-bottom: var(--space-xs);
  color: var(--text-primary);
  font-size: var(--mg-font-label);
}

.form-input {
  width: 100%;
  min-height: 48px;
  height: max(48px, 96rpx);
  padding: 0 var(--space-md);
  border: 1px solid var(--mg-color-control-border);
  border-radius: var(--radius-btn);
  background: var(--bg-card);
  color: var(--text-primary);
  font-size: var(--mg-font-body);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--primary);
}

.form-textarea {
  width: 100%;
  min-height: 192rpx;
  padding: var(--space-sm) var(--space-md);
  border: 1px solid var(--mg-color-control-border);
  border-radius: var(--radius-btn);
  background: var(--bg-card);
  color: var(--text-primary);
  font-size: var(--mg-font-body);
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: var(--primary);
}

/* ==================== 图片/图标 - 无边框 ==================== */
image {
  max-width: 100%;
  height: auto;
}

/* ==================== 头像 ==================== */
.avatar {
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-page);
  flex-shrink: 0;
}

.avatar-small { width: 60rpx; height: 60rpx; }
.avatar-medium { width: 100rpx; height: 100rpx; }
.avatar-large { width: 150rpx; height: 150rpx; }
.avatar-xlarge { width: 200rpx; height: 200rpx; }

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl) var(--space-md);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.empty-text {
  font-size: var(--mg-font-body);
  color: var(--text-muted);
  text-align: center;
}

/* ==================== 加载状态 ==================== */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-xl);
}

/* ==================== 安全区域适配 ==================== */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.btn[disabled] { background: var(--mg-color-bg-subtle); color: var(--mg-color-text-muted); border-color: var(--mg-color-border); opacity: 1; }
.form-input, .form-textarea { font-size: var(--mg-font-body); }

@media (prefers-reduced-motion: reduce) { .btn { transition: none; } }
/* 人员当前在职状态；文字确保状态不只依靠颜色传达。 */
.member-retired { display: inline-block; flex-shrink: 0; margin-left: 8rpx; padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 12px; line-height: 18px; color: var(--mg-color-text-secondary); background: var(--mg-color-bg-subtle); vertical-align: middle; white-space: nowrap; }
.member-readonly-note { padding: 20rpx 28rpx; font-size: 13px; line-height: 20px; color: var(--mg-color-text-secondary); background: var(--mg-color-bg-subtle); }
