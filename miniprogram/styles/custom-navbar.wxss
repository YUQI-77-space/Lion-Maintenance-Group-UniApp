/* ============================================
   公共自定义导航栏样式 - 极简线框风格 + 毛玻璃
   ============================================ */
@import "./variables.wxss";

/* === 导航栏容器 ===
   毛玻璃底：半透明 + 背景模糊，内容滑到栏下时透出虚化的底色，
   从而弱化「抬头」与「正文」之间的硬边界。
   --navbar-* 由各页面按需覆盖（首页首屏更透、滚动后更实）。 */
.custom-navbar {
  --navbar-tint: 255, 255, 255;   /* 玻璃底色 RGB */
  --navbar-alpha: 0.86;           /* 玻璃不透明度 */
  --navbar-blur: 20px;            /* 背景模糊半径 */

  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: rgba(var(--navbar-tint), var(--navbar-alpha));
  backdrop-filter: saturate(180%) blur(var(--navbar-blur));
  -webkit-backdrop-filter: saturate(180%) blur(var(--navbar-blur));
  /* 不再用 border-bottom：深蓝描边会把抬头和正文切成硬邦邦的两截 */
  border-bottom: none;
  transition: background-color 0.28s ease, box-shadow 0.28s ease,
    backdrop-filter 0.28s ease, -webkit-backdrop-filter 0.28s ease;
  z-index: 1000;
}

/* 滚动后的「更实」状态：提高不透明度与模糊，用柔和投影表达纵深 */
.custom-navbar.is-scrolled {
  --navbar-alpha: 0.94;
  --navbar-blur: 30px;
  box-shadow: 0 8rpx 24rpx rgba(10, 37, 64, 0.05);
}

/* 高对比度偏好：退回实底，保证可读性 */
@media (prefers-contrast: high) {
  .custom-navbar {
    --navbar-alpha: 1;
  }
}

.navbar-content {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 var(--space-md);
}

/* === Logo === */
.navbar-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: var(--space-sm);
  flex-shrink: 0;
}

/* === 标题 === */
.navbar-title {
  font-size: var(--font-subtitle);
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

/* === 返回按钮 === */
.navbar-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: var(--space-xs);
  background: transparent;
}

.navbar-back::before {
  content: '';
  width: 20rpx;
  height: 20rpx;
  border-left: 3rpx solid var(--text-primary);
  border-bottom: 3rpx solid var(--text-primary);
  transform: rotate(45deg);
}

.navbar-back-text {
  font-size: var(--font-body);
  color: var(--primary);
}

/* === 右侧操作区 === */
.navbar-right {
  position: absolute;
  right: var(--space-md);
  display: flex;
  align-items: center;
}

.navbar-action {
  font-size: var(--font-body);
  color: var(--primary);
}

/* === 分页导航 === */
.navbar-tabs {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 var(--space-md);
  background: var(--bg-card);
}

.navbar-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  font-size: var(--font-body);
  color: var(--text-secondary);
  position: relative;
}

.navbar-tab.active {
  color: var(--primary);
  font-weight: 500;
}

.navbar-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}
