/* 兼容仍在使用的旧变量；设计值只在 design-tokens.wxss 维护。 */
@import "./design-tokens.wxss";
page, .mg-theme {
  --primary: var(--mg-color-brand);
  --primary-color: var(--mg-color-brand);
  --border-color: var(--mg-color-border);
  --bg-page: var(--mg-color-bg-page);
  --bg-card: var(--mg-color-bg-surface);
  --border: var(--mg-color-border);
  --text-primary: var(--mg-color-text-primary);
  --text-secondary: var(--mg-color-text-secondary);
  --text-muted: var(--mg-color-text-muted);
  --success: var(--mg-color-success);
  --warning: var(--mg-color-warning);
  --danger: var(--mg-color-danger);
  --info: var(--mg-color-info);
  --font-title: var(--mg-font-title);
  --font-subtitle: var(--mg-font-section);
  --font-body: var(--mg-font-body);
  --font-caption: var(--mg-font-caption);
  --font-hint: var(--mg-font-caption);
  --space-xs: var(--mg-space-1);
  --space-sm: var(--mg-space-2);
  --space-md: var(--mg-space-3);
  --space-lg: var(--mg-space-4);
  --space-xl: var(--mg-space-6);
  --radius-card: var(--mg-radius-card);
  --radius-btn: var(--mg-radius-control);
  --radius-tag: var(--mg-radius-tag);
  --radius-image: var(--mg-radius-control);
  --text-main: var(--mg-color-text-primary);
  --text-regular: var(--mg-color-text-secondary);
  --text-placeholder: var(--mg-color-text-muted);
  --background-color: var(--mg-color-bg-page);
  --card-background: var(--mg-color-bg-surface);
  --border-light: var(--mg-color-border);
  --success-color: var(--mg-color-success);
  --warning-color: var(--mg-color-warning);
  --danger-color: var(--mg-color-danger);
  --info-color: var(--mg-color-info);
  --secondary-color: var(--mg-color-info);

  --spacing-medium: var(--mg-space-3);

  --border-radius-large: var(--mg-radius-card);
  --border-radius-medium: var(--mg-radius-control);

  --maintenance-pending-color: var(--mg-color-warning);
  --maintenance-inProgress-color: var(--mg-color-info);
  --maintenance-completed-color: var(--mg-color-success);
  --maintenance-cancelled-color: var(--mg-color-neutral);
  --volunteer-pending-color: var(--mg-color-neutral);
  --volunteer-inPreparation-color: var(--mg-color-info);
  --volunteer-inProgress-color: var(--mg-color-info);
  --volunteer-ended-color: var(--mg-color-neutral);

  --box-shadow: none;


}
