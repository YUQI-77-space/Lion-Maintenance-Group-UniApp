/* 导入通用样式 */
@import "./styles/common.wxss";

/* 全局样式设置 */
page {
  font-size: 15px;
  font-size: max(15px, var(--mg-font-body));
  line-height: 1.55;
  color: var(--text-main);
  background-color: var(--background-color);
  box-sizing: border-box;
  min-height: 100vh;
  font-family: var(--mg-font-family);
  /* 为悬浮TabBar预留空间，移除iOS安全区域适配以保持和Android一致 */
  padding-bottom: 0px;
}


view, text, scroll-view, swiper, navigator {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border-radius: var(--border-radius-medium);
}

button::after {
  border: none;
}

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: var(--spacing-medium);
  box-sizing: border-box;
}

/* 二级页固定栏按系统安全区留白；Tab 页由 layout.js 统一测量。 */
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
.footer-fixed {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: var(--mg-space-3);
  padding-bottom: calc(var(--mg-space-3) + env(safe-area-inset-bottom));
  background: var(--mg-color-bg-surface); z-index: 200;
  border-top: 1px solid var(--mg-color-border);
}
